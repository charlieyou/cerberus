#!/bin/sh
set -eu
provider=$(basename "$0")
record_dir=${CERBERUS_MOCK_RECORD_DIR:?}
mkdir -p "$record_dir"
stdin_path="$record_dir/$provider.stdin"
cat > "$stdin_path"
printf '%s\n' "$@" > "$record_dir/$provider.args"
printf 'mock %s argv: %s\n' "$provider" "$*" >&2
if [ "${CERBERUS_MOCK_EXIT:-0}" != "0" ]; then
  echo "mock exit" >&2
  exit "$CERBERUS_MOCK_EXIT"
fi
if [ "${CERBERUS_MOCK_EMPTY_STDOUT:-}" = "1" ]; then
  exit 0
fi
if [ -n "${CERBERUS_FIXTURE_DIR:-}" ]; then
  if command -v sha256sum >/dev/null 2>&1; then
    prompt_hash=$(sha256sum "$stdin_path" | awk '{print $1}')
  else
    prompt_hash=$(shasum -a 256 "$stdin_path" | awk '{print $1}')
  fi
  instance_id=${CERBERUS_MOCK_INSTANCE_ID:-}
  if [ -z "$instance_id" ]; then
    instance_id="$provider#1"
  fi
  fixture_path="$CERBERUS_FIXTURE_DIR/$prompt_hash:$instance_id.md"
  if [ ! -f "$fixture_path" ]; then
    echo "mock $provider: no fixture for prompt_hash=$prompt_hash instance_id=$instance_id" >&2
    exit 2
  fi
  cat "$fixture_path"
  exit 0
fi
printf '{"findings":[],"verdict":"PASS","summary":"mock pass","overall_confidence":0.9,"strategy":"mock","round":1,"peer_responses_seen":[]}\n'
