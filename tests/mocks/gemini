#!/bin/sh
set -eu
provider=$(basename "$0")
record_dir=${CERBERUS_MOCK_RECORD_DIR:?}
mkdir -p "$record_dir"
cat > "$record_dir/$provider.stdin"
printf '%s\n' "$@" > "$record_dir/$provider.args"
printf 'mock %s argv: %s\n' "$provider" "$*" >&2
if [ "${CERBERUS_MOCK_EXIT:-0}" != "0" ]; then
  echo "mock exit" >&2
  exit "$CERBERUS_MOCK_EXIT"
fi
if [ "${CERBERUS_MOCK_EMPTY_STDOUT:-}" = "1" ]; then
  exit 0
fi
if [ -n "${CERBERUS_FIXTURE_DIR:-}" ]; then
  generator_type=create-spec
  for arg in "$@"; do
    case "$arg" in
      *"Cerberus generator type: create-plan."*) generator_type=create-plan ;;
      *"Cerberus generator type: create-spec."*) generator_type=create-spec ;;
      *"Cerberus generator type: healthcheck."*) generator_type=healthcheck ;;
      *"Cerberus generator type: architecture-review."*) generator_type=architecture-review ;;
    esac
  done
  cat "$CERBERUS_FIXTURE_DIR/$provider-$generator_type.md"
  exit 0
fi
printf '{"findings":[],"verdict":"PASS","summary":"mock pass","overall_confidence":0.9,"strategy":"mock","round":1,"peer_responses_seen":[]}\n'
