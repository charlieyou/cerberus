{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${PLUGIN_ROOT}/bin/codex-session-init\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${PLUGIN_ROOT}/bin/codex-session-init\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${PLUGIN_ROOT}/bin/codex-stop-hook\"",
            "timeout": 2100
          }
        ]
      }
    ]
  }
}
