#!/usr/bin/env bash
# bin/codex-stop-hook — Codex Stop adapter (T009).
#
# Reads Codex `Stop` JSON from stdin, looks up the active run via the
# session registry written by `bin/codex-session-init`, calls
# `bin/review-gate status --json --session-key <run>`, and maps the
# result to a Codex hook response per the Stop Decision Matrix
# (plan §Codex Stop Decision Matrix, L732-L766).
#
# Hook contract:
#   - **Always exits 0**.
#   - Emits a single Codex Stop JSON blob to stdout: either
#     {"continue":true,...} or {"decision":"block","reason":...}.
#   - Diagnostics go to stderr.
#   - Installs a SIGINT/SIGTERM/SIGHUP trap from script startup that
#     fails open and kills any tracked child PIDs.
#
# Test-only knob: CERBERUS_REVIEW_GATE_BIN overrides the path to
# `bin/review-gate`. Defaults to `$SCRIPT_DIR/review-gate`.

# NOTE: deliberately use `set -uo pipefail` (no `-e`). The hook is
# failure-open by design: any non-zero rc from a probe must be handled
# inline, not propagate out of the script. Errexit on a complex matrix
# evaluator is an unbounded source of "wrong-but-non-zero" exits that
# would violate the "always emit JSON, always exit 0" contract.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REVIEW_GATE_BIN="${CERBERUS_REVIEW_GATE_BIN:-$SCRIPT_DIR/review-gate}"

# Tracked child PIDs. The signal trap iterates and kills these on the
# way out so a long-running `review-gate wait`/`status` child cannot
# orphan or block the user from stopping. EVERY foreground call into
# review-gate goes through __cerberus_call_status / the wait helper —
# both register the spawned PID here so signals can be processed
# promptly even mid-status (round-2 review feedback #1: the prior
# foreground status call deferred SIGTERM/INT/HUP until the slow
# backend returned).
__CERBERUS_STOP_CHILD_PIDS=()

# Tracked tmpfiles to clean up in the trap path so SIGINT/TERM/HUP
# does not leave /tmp/codex-stop-* fragments behind (round-2 review
# feedback #4).
__CERBERUS_STOP_TMPFILES=()

# Re-entrancy guard. Set to "true" ONLY AFTER the body has been
# completely written to stdout (round-2 review feedback #3: the prior
# version flipped this BEFORE jq emitted, so a signal mid-jq made the
# trap skip emission and produce empty stdout). Ordering invariant:
#
#   1. Build the JSON body in a shell variable (jq captured via $(...);
#      partial jq output never reaches stdout).
#   2. printf the body to stdout.
#   3. Set __CERBERUS_STOP_EMITTED=true.
#
# The emitted flag is intentionally updated after stdout is written so
# a signal before the normal-path write still fails open with JSON.
__CERBERUS_STOP_EMITTED="false"

__cerberus_stop_log() {
    echo "codex-stop-hook: $*" >&2
}

# Failure-open signal handler. Plan §Stop Decision Matrix row 13.
# MUST: kill any tracked child PIDs; emit a single allow envelope to
# stdout; exit 0. NO long-running operations. Strict-mode flags are
# disabled inside the handler so empty arrays / SIGPIPE / etc. cannot
# prevent us from emitting the failure-open response.
__cerberus_stop_safe_exit() {
    set +e +u
    set +o pipefail 2>/dev/null || true
    trap '' INT TERM HUP

    # Kill tracked children. Bash 3.2-safe length gate (no `${arr[@]:-}`
    # array expansion with default — that form aborts under set -u on
    # bash 3.2). T007 round-1 review feedback.
    local _n _i
    _n=${#__CERBERUS_STOP_CHILD_PIDS[@]}
    _i=0
    while [ "$_i" -lt "$_n" ]; do
        kill -TERM "${__CERBERUS_STOP_CHILD_PIDS[$_i]}" 2>/dev/null
        _i=$((_i + 1))
    done

    # Emit failure-open envelope unless a normal-path emit already
    # printed the body.
    if [ "$__CERBERUS_STOP_EMITTED" != "true" ]; then
        printf '{"continue":true}\n'
        __CERBERUS_STOP_EMITTED="true"
    fi

    # Best-effort tmpfile cleanup (round-2 review feedback #4).
    _n=${#__CERBERUS_STOP_TMPFILES[@]}
    _i=0
    while [ "$_i" -lt "$_n" ]; do
        rm -f "${__CERBERUS_STOP_TMPFILES[$_i]}" 2>/dev/null
        _i=$((_i + 1))
    done

    exit 0
}

# Install signal trap from script startup. Phase 1 exit criterion (plan
# L760-L765). The trap surface (INT TERM HUP) MUST match the regex used
# by `bin/tests/test-codex-stop-hook.sh` Happy C.
trap '__cerberus_stop_safe_exit' INT TERM HUP

# ---- Hook output emitters --------------------------------------------------
# Each emitter:
#   1. Builds the JSON body via $(jq ...) capture.
#   2. Calls __cerberus_emit_body, which ignores INT/TERM/HUP only
#      across the final stdout write plus emitted-flag update.
# This keeps stdout to one JSON object: a signal before the final write
# hits the failure-open trap; a signal after the flag update sees
# EMITTED=true and exits without printing a second envelope.

__cerberus_restore_signal_trap() {
    trap '__cerberus_stop_safe_exit' INT TERM HUP
}

__cerberus_emit_body() {
    local body="$1"
    trap '' INT TERM HUP
    printf '%s\n' "$body"
    __CERBERUS_STOP_EMITTED="true"
    __cerberus_restore_signal_trap
}

__cerberus_emit_allow() {
    local note="${1:-}"
    local body
    if [ -z "$note" ]; then
        body='{"continue":true}'
    elif command -v jq >/dev/null 2>&1; then
        body="$(jq -nc --arg note "$note" '{"continue":true,systemMessage:$note}' 2>/dev/null)" \
            || body='{"continue":true}'
    else
        # No jq available: notes used here are static ASCII safe strings.
        body="{\"continue\":true,\"systemMessage\":\"$note\"}"
    fi
    __cerberus_emit_body "$body"
}

__cerberus_emit_continue() {
    local message="$1"
    local body
    if command -v jq >/dev/null 2>&1; then
        body="$(jq -nc --arg msg "$message" '{decision:"block",reason:$msg}' 2>/dev/null)" \
            || body='{"continue":true}'
    else
        # Without jq we cannot safely escape the message. Failure-open.
        body='{"continue":true}'
    fi
    __cerberus_emit_body "$body"
}

# ---- Drain stdin via background subshell ----------------------------------
# Bash defers running TERM/INT/HUP traps while a foreground external
# command is blocked in a read syscall. Backgrounding the drainer and
# `wait`-ing on it lets the trap fire promptly on signal: `wait` is
# interruptible, the handler runs, kills the drainer via the stored PID,
# and emits the failure-open envelope. T007 carried this pattern; T009
# extends it to also capture the JSON body for parsing.
INPUT=""
if [ ! -t 0 ]; then
    _stdin_drain_out="$(mktemp -t codex-stop-stdin.XXXXXX 2>/dev/null || echo "")"
    if [ -n "$_stdin_drain_out" ]; then
        __CERBERUS_STOP_TMPFILES+=("$_stdin_drain_out")
        # `<&0` is REQUIRED. Bash redirects backgrounded jobs' stdin
        # away from the parent's piped stdin in some configurations;
        # without this redirect cat reads from /dev/null and returns
        # instantly, defeating the whole point of bg-cat + fg-wait
        # (verified empirically; see T007 stub commentary).
        cat <&0 >"$_stdin_drain_out" 2>/dev/null &
        _stdin_drain_pid=$!
        __CERBERUS_STOP_CHILD_PIDS+=("$_stdin_drain_pid")
        wait "$_stdin_drain_pid" 2>/dev/null || true
        INPUT="$(cat "$_stdin_drain_out" 2>/dev/null || echo "")"
        rm -f "$_stdin_drain_out" 2>/dev/null || true
        unset _stdin_drain_out _stdin_drain_pid
    fi
fi

# ---- Row 12: jq missing on PATH -------------------------------------------
# Detect early and fail open. Diagnostics to stderr only; stdout gets
# exactly one JSON envelope.
if ! command -v jq >/dev/null 2>&1; then
    __cerberus_stop_log "jq not on PATH; failing open"
    __cerberus_emit_allow ""
    exit 0
fi

# ---- Parse stdin payload (Codex Stop JSON) --------------------------------
SESSION_ID=""
WORKSPACE_ROOT=""
TRANSCRIPT_PATH=""
if [ -n "$INPUT" ]; then
    if printf '%s' "$INPUT" | jq -e . >/dev/null 2>&1; then
        SESSION_ID="$(printf '%s' "$INPUT" | jq -r '.session_id // empty')"
        WORKSPACE_ROOT="$(printf '%s' "$INPUT" | jq -r '.workspace_root // .cwd // empty')"
        TRANSCRIPT_PATH="$(printf '%s' "$INPUT" | jq -r '.transcript_path // empty')"
    else
        # Stdin parse failure (matrix case 15 / failure-open).
        __cerberus_stop_log "invalid Codex Stop JSON on stdin; failing open"
        __cerberus_emit_allow ""
        exit 0
    fi
fi

if [ -z "$WORKSPACE_ROOT" ]; then
    WORKSPACE_ROOT="$(pwd)"
fi

if [ -z "$SESSION_ID" ]; then
    __cerberus_stop_log "missing required Stop field 'session_id'; failing open"
    __cerberus_emit_allow ""
    exit 0
fi

# ---- Compute project_key via review-gate-lib.sh ---------------------------
# Source review-gate-lib.sh purely to access `get_project_hash` and
# `resolve_review_dir`. Failure to source is treated as failure-open per
# the matrix invariant.
if ! source "$SCRIPT_DIR/review-gate-lib.sh" 2>/dev/null; then
    __cerberus_stop_log "failed to source review-gate-lib.sh; failing open"
    __cerberus_emit_allow ""
    exit 0
fi

# Codex's Stop stdin is the authoritative workspace identity. Mirror
# codex-session-init: ignore inherited CERBERUS_PROJECT_KEY and derive
# from Stop cwd/workspace_root so stale shell env cannot steer us to a
# registry from another workspace/session.
PROJECT_KEY="$(CERBERUS_PROJECT_KEY= CLAUDE_PROJECT_DIR="$WORKSPACE_ROOT" \
    get_project_hash "" 2>/dev/null || true)"

# Validate project_key shape (path-traversal rejection). resolve_review_dir
# enforces the same rule; we reject up-front so the Row 2 / Row 3
# pre-checks below cannot accidentally peek into a sibling directory.
case "$PROJECT_KEY" in
    ""|.|..)
        __cerberus_stop_log "invalid project_key '$PROJECT_KEY'; failing open"
        __cerberus_emit_allow ""
        exit 0
        ;;
    */*)
        __cerberus_stop_log "invalid project_key '$PROJECT_KEY' (contains '/'); failing open"
        __cerberus_emit_allow ""
        exit 0
        ;;
esac

# ---- Row 2: registry file missing -----------------------------------------
# The Codex session registry layout is fixed at
# `~/.cerberus/runtime/codex/<project_key>/active-session.json`; it is
# NOT influenced by CERBERUS_STATE_ROOT (that variable controls the
# review-state root, not the runtime registry — see codex-session-init
# L127 for the writer side). Mirror that exactly here.
REGISTRY_FILE="$HOME/.cerberus/runtime/codex/$PROJECT_KEY/active-session.json"
if [ ! -f "$REGISTRY_FILE" ]; then
    __cerberus_emit_allow ""
    exit 0
fi

# Read run_key from the registry. Treat malformed registry as failure-open.
if ! jq -e . "$REGISTRY_FILE" >/dev/null 2>&1; then
    __cerberus_stop_log "registry malformed at $REGISTRY_FILE; failing open"
    __cerberus_emit_allow ""
    exit 0
fi

REGISTRY_SESSION_ID="$(jq -r '.session_id // .codex_session_id // empty' "$REGISTRY_FILE" 2>/dev/null || echo "")"
if [ "$REGISTRY_SESSION_ID" != "$SESSION_ID" ]; then
    __cerberus_stop_log "registry session_id '$REGISTRY_SESSION_ID' does not match Stop session_id '$SESSION_ID'; ignoring stale registry"
    __cerberus_emit_allow ""
    exit 0
fi

RUN_KEY="$(jq -r '.run_key // empty' "$REGISTRY_FILE" 2>/dev/null || echo "")"
if [ -z "$RUN_KEY" ]; then
    __cerberus_emit_allow ""
    exit 0
fi

# Validate run_key shape (defense in depth: registry could be hand-edited
# or carry a key written by an older incompatible writer).
case "$RUN_KEY" in
    .|..|*/*)
        __cerberus_stop_log "invalid run_key '$RUN_KEY' from registry; failing open"
        __cerberus_emit_allow ""
        exit 0
        ;;
esac

# Export the env review-gate (and resolve_review_dir below) needs to
# locate the run. CERBERUS_STATE_ROOT — if set on the parent — is
# inherited automatically and honored by resolve_review_dir. The hook
# is already in its own process so exporting here scopes only to this
# invocation and any children it spawns.
export CERBERUS_HOST="codex"
export CERBERUS_PROJECT_KEY="$PROJECT_KEY"
export CERBERUS_RUN_KEY="$RUN_KEY"

# ---- Row 3: registry present but <run-key>/ missing -----------------------
# Use resolve_review_dir for the run-dir lookup (round-1 review
# feedback): the user may set CERBERUS_STATE_ROOT to point at a custom
# state root, in which case the run dir is at
# `$CERBERUS_STATE_ROOT/<pk>/<run>/` rather than the default
# `$HOME/.cerberus/projects/<pk>/<run>/`. Hardcoding the default would
# bypass blocking findings stored under the custom root.
RUN_DIR=""
RUN_DIR="$(resolve_review_dir "" "$TRANSCRIPT_PATH" 2>/dev/null || true)"
if [ -z "$RUN_DIR" ] || [ ! -d "$RUN_DIR" ]; then
    __cerberus_emit_allow "no review dir"
    exit 0
fi

# ---- Wait knob ------------------------------------------------------------
WAIT_SECONDS_RAW="${CERBERUS_CODEX_STOP_WAIT_SECONDS:-0}"
case "$WAIT_SECONDS_RAW" in
    ''|*[!0-9]*) WAIT_SECONDS=0 ;;
    *)           WAIT_SECONDS="$WAIT_SECONDS_RAW" ;;
esac

# Helper: invoke `review-gate status --json --session-key <run>` and
# capture body+rc.
#
# Round-2 review feedback #1: spawn status as a backgrounded child and
# `wait` on its PID so that bash's trap can fire promptly even if the
# status backend hangs or is slow. A foreground call would defer
# SIGTERM/INT/HUP until status returned, violating the row-13
# "MUST kill any wait/status child" requirement.
__cerberus_call_status() {
    local out_file="$1"
    local err_file="$2"
    local rc=0
    "$REVIEW_GATE_BIN" status --json --session-key "$RUN_KEY" \
        >"$out_file" 2>"$err_file" &
    local status_pid=$!
    __CERBERUS_STOP_CHILD_PIDS+=("$status_pid")
    wait "$status_pid" 2>/dev/null
    rc=$?
    return $rc
}

# Helper: extract value via jq -r without leaking exit codes.
__jq_get() {
    local body="$1"
    local filter="$2"
    printf '%s' "$body" | jq -r "$filter" 2>/dev/null || echo ""
}

# Helper: count blocking findings per the canonical predicate
# (plan L700-L706): verdict == "FAIL" OR priority IN {"P0","P1"}.
__cerberus_count_blocking() {
    local body="$1"
    local n
    n="$(printf '%s' "$body" | jq -r '
        [
          .aggregated_findings[]?
          | select(
              ((.verdict // "") == "FAIL")
              or ((.priority // "") == "P0")
              or ((.priority // "") == "P1")
            )
        ] | length
    ' 2>/dev/null || echo 0)"
    case "$n" in
        ''|*[!0-9]*) echo 0 ;;
        *)           echo "$n" ;;
    esac
}

# Helper: format row-6 user message from a status body. Multi-line
# bullet list. jq emits canonical JSON so newlines survive as `\n` in
# stdout, which Codex renders.
__cerberus_format_blocking_message() {
    local body="$1"
    printf '%s' "$body" | jq -r '
        ([
          .aggregated_findings[]?
          | select(
              ((.verdict // "") == "FAIL")
              or ((.priority // "") == "P0")
              or ((.priority // "") == "P1")
            )
        ]) as $blocking
        | "Cerberus has \($blocking | length) blocking finding(s); run Cerberus: Status to inspect.\n" +
          ([
            $blocking[]
            | "- [\(.priority // "?")][\(.verdict // "?")] \(.reviewer // "?"): \(.summary // "")"
          ] | join("\n"))
    ' 2>/dev/null || echo "Cerberus has blocking findings; run Cerberus: Status to inspect."
}

# Helper: format row-9 user message (resolved + fail).
__cerberus_format_resolved_fail_message() {
    local body="$1"
    printf '%s' "$body" | jq -r '
        "Cerberus gate resolved with consensus: \(.consensus_verdict // "fail"). Run Cerberus: Status for details."
    ' 2>/dev/null || echo "Cerberus gate resolved with consensus: fail."
}

# Decision-matrix evaluator. Mode `initial` may spawn a wait child if
# pending + WAIT_SECONDS>0; mode `post-wait` skips that and falls through
# to the row-4 message instead (avoiding infinite recursion).
__cerberus_decide() {
    local body="$1"
    local mode="$2"   # initial | post-wait

    local gs cv
    gs="$(__jq_get "$body" '.gate_status // empty')"
    cv="$(__jq_get "$body" '.consensus_verdict // empty')"

    case "$gs" in
        pending)
            if [ "$mode" = "initial" ] && [ "$WAIT_SECONDS" -gt 0 ]; then
                __cerberus_run_wait_then_reeval
                return 0
            fi
            # Row 4 (and Row 5a fallthrough).
            __cerberus_emit_allow "reviewers still running; run Cerberus: Status to check"
            ;;
        awaiting_decision)
            local n
            n="$(__cerberus_count_blocking "$body")"
            if [ "$n" -gt 0 ]; then
                # Row 6.
                local msg
                msg="$(__cerberus_format_blocking_message "$body")"
                __cerberus_emit_continue "$msg"
            else
                # Row 7.
                __cerberus_emit_allow ""
            fi
            ;;
        resolved)
            # Plan §Stop Decision Matrix:
            #   Row 8: resolved + consensus_verdict == "pass" → allow
            #   Row 9: resolved + consensus_verdict == "fail" → continue
            # Round-2 review feedback #2: any other consensus
            # (needs_revision, null/empty, etc.) is NOT a row-9 trigger
            # — those gates are non-blocking by the canonical predicate
            # and the user must be able to stop. Allow by default and
            # only block on an explicit "fail".
            case "$cv" in
                fail)
                    # Row 9.
                    local msg
                    msg="$(__cerberus_format_resolved_fail_message "$body")"
                    __cerberus_emit_continue "$msg"
                    ;;
                *)
                    # Row 8 (pass / needs_revision / unknown) → allow.
                    __cerberus_emit_allow ""
                    ;;
            esac
            ;;
        *)
            # Unknown gate_status — failure-open.
            __cerberus_emit_allow ""
            ;;
    esac
}

# Row 5: wait then re-evaluate. Spawns `review-gate wait --json
# --timeout N --session-key <run>` as a backgrounded child whose PID is
# stored in __CERBERUS_STOP_CHILD_PIDS so the trap can SIGTERM it on
# signal. After the child exits we re-call `status` to obtain the
# canonical post-wait state and re-apply the matrix in `post-wait` mode.
__cerberus_run_wait_then_reeval() {
    local wait_out wait_err
    wait_out="$(mktemp -t codex-stop-wait.XXXXXX 2>/dev/null || echo "")"
    wait_err="$(mktemp -t codex-stop-wait-err.XXXXXX 2>/dev/null || echo "")"
    if [ -z "$wait_out" ] || [ -z "$wait_err" ]; then
        __cerberus_emit_allow "reviewers still running; run Cerberus: Status to check"
        return 0
    fi
    __CERBERUS_STOP_TMPFILES+=("$wait_out" "$wait_err")

    # Use a tight poll interval inside the child so completion mid-wait
    # is detected promptly. Honor an externally-set value if the user
    # tuned it; otherwise default to 1s for the bounded-stop budget.
    local poll
    poll="${REVIEW_GATE_POLL_INTERVAL_SECONDS:-1}"
    case "$poll" in
        ''|*[!0-9]*) poll=1 ;;
    esac
    if [ "$poll" -lt 1 ]; then
        poll=1
    fi

    # Spawn as direct background command so $! is the actual review-gate
    # PID. That makes the trap's `kill -TERM <PID>` terminate the
    # review-gate process (not just a wrapping subshell that would leave
    # review-gate orphaned). CERBERUS_HOST / CERBERUS_PROJECT_KEY are
    # already exported above; they propagate into the child.
    REVIEW_GATE_POLL_INTERVAL_SECONDS="$poll" \
        "$REVIEW_GATE_BIN" wait --json \
            --timeout "$WAIT_SECONDS" \
            --session-key "$RUN_KEY" \
            >"$wait_out" 2>"$wait_err" &
    local wait_pid=$!
    __CERBERUS_STOP_CHILD_PIDS+=("$wait_pid")
    wait "$wait_pid" 2>/dev/null || true

    # Re-call status to get a fresh canonical view. (We deliberately do
    # NOT consume `wait`'s body here even though it carries verdicts —
    # the matrix is defined over `status --json`'s schema, and going
    # through status keeps the row 6/7/8/9 evaluator code paths
    # identical between mode=initial and mode=post-wait.)
    local rs_out rs_err rs_rc=0
    rs_out="$(mktemp -t codex-stop-status2.XXXXXX 2>/dev/null || echo "")"
    rs_err="$(mktemp -t codex-stop-status2-err.XXXXXX 2>/dev/null || echo "")"
    if [ -z "$rs_out" ] || [ -z "$rs_err" ]; then
        rm -f "$wait_out" "$wait_err"
        __cerberus_emit_allow "reviewers still running; run Cerberus: Status to check"
        return 0
    fi
    __CERBERUS_STOP_TMPFILES+=("$rs_out" "$rs_err")

    __cerberus_call_status "$rs_out" "$rs_err"
    rs_rc=$?

    local rs_body=""
    if [ -f "$rs_out" ]; then
        rs_body="$(cat "$rs_out" 2>/dev/null || echo "")"
    fi
    rm -f "$wait_out" "$wait_err" "$rs_out" "$rs_err"

    if [ "$rs_rc" -eq 4 ]; then
        # Run vanished mid-wait — failure-open.
        __cerberus_emit_allow ""
        return 0
    fi
    if [ "$rs_rc" -ne 0 ]; then
        __cerberus_stop_log "post-wait status exited $rs_rc; failing open"
        __cerberus_emit_allow ""
        return 0
    fi
    if ! printf '%s' "$rs_body" | jq -e . >/dev/null 2>&1; then
        __cerberus_emit_allow "cerberus state unreadable; allowing stop"
        return 0
    fi

    # Detect malformed-state sentinel from status body.
    local rs_status rs_error
    rs_status="$(__jq_get "$rs_body" '.status // empty')"
    rs_error="$(__jq_get "$rs_body" '.error // empty')"
    if [ "$rs_status" = "unknown" ] && [ "$rs_error" = "malformed_state" ]; then
        __cerberus_emit_allow "cerberus state unreadable; allowing stop"
        return 0
    fi

    __cerberus_decide "$rs_body" "post-wait"
}

# ---- Initial status probe -------------------------------------------------
STATUS_OUT="$(mktemp -t codex-stop-status.XXXXXX 2>/dev/null || echo "")"
STATUS_ERR="$(mktemp -t codex-stop-status-err.XXXXXX 2>/dev/null || echo "")"
if [ -z "$STATUS_OUT" ] || [ -z "$STATUS_ERR" ]; then
    __cerberus_stop_log "could not create tmpfiles for status probe; failing open"
    __cerberus_emit_allow ""
    exit 0
fi
__CERBERUS_STOP_TMPFILES+=("$STATUS_OUT" "$STATUS_ERR")

__cerberus_call_status "$STATUS_OUT" "$STATUS_ERR"
status_rc=$?

# Row 1: status exits 4 (no_active_gate).
if [ "$status_rc" -eq 4 ]; then
    rm -f "$STATUS_OUT" "$STATUS_ERR"
    __cerberus_emit_allow ""
    exit 0
fi

# Row 11: status exits non-zero, non-4.
if [ "$status_rc" -ne 0 ]; then
    __cerberus_stop_log "review-gate status exited $status_rc; stderr=$(cat "$STATUS_ERR" 2>/dev/null || true)"
    rm -f "$STATUS_OUT" "$STATUS_ERR"
    __cerberus_emit_allow ""
    exit 0
fi

STATUS_BODY="$(cat "$STATUS_OUT" 2>/dev/null || echo "")"
rm -f "$STATUS_OUT" "$STATUS_ERR"

# Row 10: malformed gate-state.json → status returns body with
# {status:"unknown", error:"malformed_state"} at exit 0.
if ! printf '%s' "$STATUS_BODY" | jq -e . >/dev/null 2>&1; then
    __cerberus_stop_log "status body not valid JSON; failing open"
    __cerberus_emit_allow "cerberus state unreadable; allowing stop"
    exit 0
fi

INIT_STATUS_FIELD="$(__jq_get "$STATUS_BODY" '.status // empty')"
INIT_ERROR_FIELD="$(__jq_get "$STATUS_BODY" '.error // empty')"
if [ "$INIT_STATUS_FIELD" = "unknown" ] && [ "$INIT_ERROR_FIELD" = "malformed_state" ]; then
    __cerberus_emit_allow "cerberus state unreadable; allowing stop"
    exit 0
fi

# Rows 4/5/6/7/8/9 — drive the matrix evaluator.
__cerberus_decide "$STATUS_BODY" "initial"

exit 0
