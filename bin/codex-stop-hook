#!/usr/bin/env bash
# bin/codex-stop-hook — Codex Stop adapter (Phase 1 stub).
#
# Final responsibility (T009): read Codex Stop JSON from stdin, look up
# the active run via the session registry, run
# `review-gate status --json --session-key <run>`, and map the result to
# a Codex hook response per the Stop Decision Matrix
# (plan §Codex Stop Decision Matrix, L732-L766).
#
# This file is a Phase-1 SKELETON (T007). The matrix logic lands in
# T009; this stub is the failure-open default (always emit
# {"action":"allow"} and exit 0).
#
# Why install signal traps from day one (T007 not T009):
#   - Plan §Phase 1 exit criteria require the Stop adapter to fail open
#     under SIGINT/SIGTERM/SIGHUP starting from the first commit that
#     introduces this file. If we deferred trap installation to T009, a
#     Codex deployment that picked up the stub between T007 and T009
#     could hang forever on a stuck stub.
#   - The trap implementation here is intentionally minimal: emit allow,
#     kill any child processes whose PIDs we recorded, exit 0. T009
#     extends `__cerberus_stop_safe_exit` with PID tracking for
#     spawned `wait` children but the contract (always emit valid JSON,
#     always exit 0) does not change.

set -euo pipefail

# Track child PIDs spawned during execution so the signal handler can
# kill them on the way out. T007 stub spawns one child (background
# stdin drainer); T009 also stores the spawned `wait` child here.
__CERBERUS_STOP_CHILD_PIDS=()

__cerberus_stop_safe_exit() {
    # Failure-open invariant: never error out before emitting the allow
    # envelope. Disable strict-mode flags inside the handler so a
    # surprise (empty array under set -u on older bash, ERR-trap path,
    # SIGPIPE on the kill below, etc.) cannot prevent us from printing
    # the failure-open response and exiting 0.
    set +e +u
    set +o pipefail 2>/dev/null || true

    # Best-effort: kill any tracked children. Use the array-length
    # gate (always safe across bash 3.2+) instead of expanding the
    # array with `:-`, which the reviewer flagged as fragile under
    # `set -u` on bash 3.2.
    local _n=${#__CERBERUS_STOP_CHILD_PIDS[@]}
    local _i=0
    while [ "$_i" -lt "$_n" ]; do
        kill -TERM "${__CERBERUS_STOP_CHILD_PIDS[$_i]}" 2>/dev/null
        _i=$((_i + 1))
    done

    # Failure-open: emit allow and exit 0. Plan §Stop Decision Matrix
    # row 13. The note distinguishes the trap path from the normal
    # stub path so integration tests can tell them apart.
    printf '{"action":"allow","note":"signal_trap"}\n'
    exit 0
}

trap '__cerberus_stop_safe_exit' INT TERM HUP

# Drain stdin so upstream hooks see EOF on their write end and don't
# stall. T009 will parse this body for the session id; the stub just
# discards it.
#
# IMPORTANT: drain in a *background* subshell, then `wait` on it in the
# foreground. Bash defers running TERM/INT/HUP traps while a foreground
# external command (`cat`) is blocked in a read syscall. Backgrounding
# the drainer and waiting on it lets the trap fire promptly on signal:
# `wait` is interruptible, the handler runs, kills the drainer via the
# stored PID, and emits the failure-open envelope. This pattern is the
# Phase 1 exit-criterion baseline (plan L760-L765); T009 extends the
# same trap surface to cover spawned `review-gate wait` children.
if [ ! -t 0 ]; then
    _stdin_drain_out="$(mktemp -t codex-stop-stdin.XXXXXX 2>/dev/null || echo "")"
    if [ -n "$_stdin_drain_out" ]; then
        # NOTE: explicit `<&0` is REQUIRED. Bash redirects a backgrounded
        # job's stdin away from a piped stdin in some configurations
        # (verified empirically on bash 5.3 macOS, reproduces under
        # bash 3.2 too). Without this redirection cat reads from
        # /dev/null and returns instantly, defeating the whole point
        # of the bg-cat + fg-wait pattern.
        cat <&0 >"$_stdin_drain_out" 2>/dev/null &
        _stdin_drain_pid=$!
        __CERBERUS_STOP_CHILD_PIDS+=("$_stdin_drain_pid")
        # `wait` returns 128+sig if interrupted; the trap handler runs
        # before we observe a return here. Suppress error so set -e
        # doesn't kill the script on a non-zero drain rc (e.g. EPIPE).
        wait "$_stdin_drain_pid" 2>/dev/null || true
        rm -f "$_stdin_drain_out" 2>/dev/null || true
        unset _stdin_drain_out _stdin_drain_pid
    fi
fi

# Failure-open default for Phase 1 skeleton. T009 replaces this with
# the full Stop Decision Matrix.
printf '{"action":"allow","note":"not_implemented","task":"T009"}\n'
exit 0
