#!/usr/bin/env bash
# Updates the cerberus plugin and fixes allowlist paths in settings.json

set -e

SETTINGS_FILE="$HOME/.claude/settings.json"
INSTALLED_PLUGINS="$HOME/.claude/plugins/installed_plugins.json"
PLUGIN_CACHE="$HOME/.claude/plugins/cache/cerberus/cerberus"

echo "==> Updating plugin from marketplace..."
claude plugin marketplace update cerberus

echo "==> Updating local plugin installation..."
claude plugin update cerberus@cerberus

# Get the new version from installed_plugins.json
NEW_VERSION=$(jq -r '.plugins["cerberus@cerberus"][0].version' "$INSTALLED_PLUGINS")

if [[ -z "$NEW_VERSION" || "$NEW_VERSION" == "null" ]]; then
    echo "Error: Could not determine new version from $INSTALLED_PLUGINS"
    exit 1
fi

NEW_BIN_PATH="$PLUGIN_CACHE/$NEW_VERSION/bin"

echo "==> New version: $NEW_VERSION"
echo "==> New bin path: $NEW_BIN_PATH"

# Update settings.json: replace any cerberus version path with the new one
# Match pattern: /home/cyou/.claude/plugins/cache/cerberus/cerberus/<version>/bin/<script>
if [[ -f "$SETTINGS_FILE" ]]; then
    # Replace pattern: cache/cerberus/cerberus/<old-version>/bin/ with new version
    TMP_SETTINGS_FILE=$(mktemp)
    SETTINGS_CONTENT=$(cat "$SETTINGS_FILE")
    UPDATED_CONTENT=""
    REMAINING_CONTENT="$SETTINGS_CONTENT"
    PATH_PREFIX="$PLUGIN_CACHE/"
    REPLACEMENT_PREFIX="$PLUGIN_CACHE/$NEW_VERSION/bin/"

    while [[ "$REMAINING_CONTENT" == *"$PATH_PREFIX"* ]]; do
        PREFIX_CONTENT="${REMAINING_CONTENT%%"$PATH_PREFIX"*}"
        AFTER_PREFIX="${REMAINING_CONTENT#*"$PATH_PREFIX"}"

        if [[ "$AFTER_PREFIX" != *"/bin/"* ]]; then
            break
        fi

        AFTER_BIN="${AFTER_PREFIX#*"/bin/"}"
        UPDATED_CONTENT+="$PREFIX_CONTENT$REPLACEMENT_PREFIX"
        REMAINING_CONTENT="$AFTER_BIN"
    done

    if [[ "$UPDATED_CONTENT" == "" ]]; then
        UPDATED_CONTENT="$SETTINGS_CONTENT"
    elif [[ -n "$REMAINING_CONTENT" ]]; then
        UPDATED_CONTENT+="$REMAINING_CONTENT"
    fi

    printf '%s' "$UPDATED_CONTENT" > "$TMP_SETTINGS_FILE"

    if ! jq empty "$TMP_SETTINGS_FILE" >/dev/null 2>&1; then
        rm -f "$TMP_SETTINGS_FILE"
        echo "Error: Rewritten settings are invalid JSON"
        exit 1
    fi

    mv "$TMP_SETTINGS_FILE" "$SETTINGS_FILE"

    echo "==> Updated settings.json allowlist paths"
else
    echo "Warning: $SETTINGS_FILE not found"
fi

echo "==> Done!"
echo ""
echo "Scripts available to allowlist:"
for script in "$NEW_BIN_PATH"/*; do
    if [[ -f "$script" && -x "$script" ]]; then
        echo "  Bash($script:*)"
    fi
done
