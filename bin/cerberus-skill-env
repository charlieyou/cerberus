#!/usr/bin/env bash
# Source from Cerberus skill Bash snippets to normalize host-neutral env.

__cerberus_skill_env_source="${BASH_SOURCE[0]}"
while [ -L "$__cerberus_skill_env_source" ]; do
    __cerberus_skill_env_dir="$(cd -P "$(dirname "$__cerberus_skill_env_source")" && pwd)"
    __cerberus_skill_env_source="$(readlink "$__cerberus_skill_env_source")"
    [[ $__cerberus_skill_env_source != /* ]] && __cerberus_skill_env_source="$__cerberus_skill_env_dir/$__cerberus_skill_env_source"
done
__cerberus_skill_env_bin_dir="$(cd -P "$(dirname "$__cerberus_skill_env_source")" && pwd)"
__cerberus_skill_env_script_root="$(cd "$__cerberus_skill_env_bin_dir/.." && pwd)"

__cerberus_skill_env_has_backend() {
    local root="${1:-}"
    [ -n "$root" ] \
        && [[ "$root" == /* ]] \
        && [ -r "$root/bin/review-gate" ] \
        && [ -r "$root/bin/review-gate-models.sh" ] \
        && [ -r "$root/config/gemini-readonly-settings.json" ] \
        && [ -r "$root/config/gemini-readonly-policy.toml" ]
}

__cerberus_skill_env_bootstrap_codex_registry() {
    local project_key="${1:-}"
    local registry="${2:-}"
    local workspace_root="${3:-}"
    local codex_thread_id="${CODEX_THREAD_ID:-}"

    [ -n "$project_key" ] || return 0
    [ -n "$registry" ] || return 0
    [ -n "$workspace_root" ] || return 0
    [ -n "$codex_thread_id" ] || return 0
    [ -x "$CERBERUS_ROOT/bin/codex-session-init" ] || return 0

    local should_refresh="false"
    if [ ! -r "$registry" ]; then
        should_refresh="true"
    elif jq -e . "$registry" >/dev/null 2>&1; then
        local registry_session_id=""
        local registry_run_key=""
        registry_session_id="$(jq -r '.session_id // .codex_session_id // empty' "$registry" 2>/dev/null || true)"
        registry_run_key="$(jq -r '.run_key // empty' "$registry" 2>/dev/null || true)"
        if [ "$registry_session_id" != "$codex_thread_id" ] || [ -z "$registry_run_key" ]; then
            should_refresh="true"
        fi
    else
        should_refresh="true"
    fi

    [ "$should_refresh" = "true" ] || return 0

    local payload=""
    payload="$(jq -n \
        --arg session_id "$codex_thread_id" \
        --arg workspace_root "$workspace_root" \
        '{
            session_id: $session_id,
            workspace_root: $workspace_root,
            cwd: $workspace_root,
            transcript_path: ""
        }' 2>/dev/null || true)"
    [ -n "$payload" ] || return 0

    printf '%s' "$payload" | "$CERBERUS_ROOT/bin/codex-session-init" >/dev/null 2>&1 || true
}

if [ -z "${CERBERUS_ROOT:-}" ]; then
    if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
        export CERBERUS_ROOT="$CLAUDE_PLUGIN_ROOT"
    elif [ -n "${CLAUDE_SKILL_DIR:-}" ]; then
        if __cerberus_skill_env_tmp_root="$(cd -P "$CLAUDE_SKILL_DIR/../.." 2>/dev/null && pwd)"; then
            export CERBERUS_ROOT="$__cerberus_skill_env_tmp_root"
        else
            export CERBERUS_ROOT="$__cerberus_skill_env_script_root"
        fi
        unset __cerberus_skill_env_tmp_root
    else
        export CERBERUS_ROOT="$__cerberus_skill_env_script_root"
    fi
fi
if ! __cerberus_skill_env_has_backend "$CERBERUS_ROOT"; then
    export CERBERUS_ROOT="$__cerberus_skill_env_script_root"
fi

if [ -z "${CERBERUS_HOST:-}" ]; then
    if [ -n "${CLAUDE_SESSION_ID:-${CLAUDE_TRANSCRIPT_PATH:-${CLAUDE_PROJECT_DIR:-${CLAUDE_PLUGIN_ROOT:-}}}}" ]; then
        export CERBERUS_HOST="claude"
    elif [ -n "${CODEX_THREAD_ID:-${CODEX_API_KEY:-${CODEX_HOME:-${CODEX_SANDBOX:-}}}}" ]; then
        export CERBERUS_HOST="codex"
    elif [ -r "$CERBERUS_ROOT/bin/review-gate-lib.sh" ] && command -v jq >/dev/null 2>&1; then
        __cerberus_skill_cwd="$(pwd)"
        __cerberus_skill_project_key="$(
            # shellcheck source=/dev/null
            . "$CERBERUS_ROOT/bin/review-gate-lib.sh" >/dev/null 2>&1 || exit 0
            CERBERUS_PROJECT_KEY= CLAUDE_PROJECT_DIR="$__cerberus_skill_cwd" get_project_hash "" 2>/dev/null || true
        )"
        if [ -n "$__cerberus_skill_project_key" ] \
           && [ -r "$HOME/.cerberus/runtime/codex/$__cerberus_skill_project_key/active-session.json" ]; then
            export CERBERUS_HOST="codex"
        else
            export CERBERUS_HOST="generic"
        fi
        unset __cerberus_skill_cwd __cerberus_skill_project_key
    else
        export CERBERUS_HOST="generic"
    fi
fi

if [ "$CERBERUS_HOST" = "claude" ]; then
    if [ -z "${CERBERUS_SESSION_ID:-}" ] && [ -n "${CLAUDE_SESSION_ID:-}" ]; then
        export CERBERUS_SESSION_ID="$CLAUDE_SESSION_ID"
    fi
    if [ -z "${CERBERUS_RUN_KEY:-}" ] && [ -n "${REVIEW_GATE_SESSION_KEY:-}" ]; then
        export CERBERUS_RUN_KEY="$REVIEW_GATE_SESSION_KEY"
    fi
    if [ -z "${CERBERUS_RUN_KEY:-}" ] && [ -n "${CERBERUS_SESSION_ID:-}" ]; then
        export CERBERUS_RUN_KEY="$CERBERUS_SESSION_ID"
    fi
    if [ -z "${CERBERUS_SESSION_ID:-}" ] && [ -n "${CERBERUS_RUN_KEY:-}" ]; then
        export CERBERUS_SESSION_ID="$CERBERUS_RUN_KEY"
    fi
    if [ -z "${CERBERUS_TRANSCRIPT_PATH:-}" ] && [ -n "${CLAUDE_TRANSCRIPT_PATH:-}" ]; then
        export CERBERUS_TRANSCRIPT_PATH="$CLAUDE_TRANSCRIPT_PATH"
    fi
fi

if [ -z "${CERBERUS_RUN_KEY:-}" ] && [ -z "${REVIEW_GATE_SESSION_KEY:-}" ]; then
    if [ "$CERBERUS_HOST" = "codex" ] && [ -z "${CLAUDE_SESSION_ID:-}" ]; then
        if [ ! -r "$CERBERUS_ROOT/bin/review-gate-lib.sh" ]; then
            echo "cerberus skill: cannot read Codex active-session registry; missing $CERBERUS_ROOT/bin/review-gate-lib.sh" >&2
            return 1 2>/dev/null || exit 1
        fi
        if ! command -v jq >/dev/null 2>&1; then
            echo "cerberus skill: cannot read Codex active-session registry; jq is not on PATH" >&2
            return 1 2>/dev/null || exit 1
        fi

        __cerberus_skill_cwd="$(pwd)"
        __cerberus_skill_project_key="$(
            # shellcheck source=/dev/null
            . "$CERBERUS_ROOT/bin/review-gate-lib.sh" >/dev/null 2>&1 || exit 0
            CERBERUS_PROJECT_KEY= CLAUDE_PROJECT_DIR="$__cerberus_skill_cwd" get_project_hash "" 2>/dev/null || true
        )"
        __cerberus_skill_registry="$HOME/.cerberus/runtime/codex/$__cerberus_skill_project_key/active-session.json"

        __cerberus_skill_env_bootstrap_codex_registry \
            "$__cerberus_skill_project_key" \
            "$__cerberus_skill_registry" \
            "$__cerberus_skill_cwd"

        if [ -z "$__cerberus_skill_project_key" ] || [ ! -r "$__cerberus_skill_registry" ]; then
            echo "cerberus skill: Codex active-session registry not found. Start a new Codex session and ensure SessionStart/UserPromptSubmit hooks are installed: $__cerberus_skill_registry" >&2
            unset __cerberus_skill_cwd __cerberus_skill_project_key __cerberus_skill_registry
            return 1 2>/dev/null || exit 1
        fi

        if ! jq -e . "$__cerberus_skill_registry" >/dev/null 2>&1; then
            echo "cerberus skill: Codex active-session registry is malformed: $__cerberus_skill_registry" >&2
            unset __cerberus_skill_cwd __cerberus_skill_project_key __cerberus_skill_registry
            return 1 2>/dev/null || exit 1
        fi

        __cerberus_skill_run_key="$(jq -r '.run_key // empty' "$__cerberus_skill_registry" 2>/dev/null || true)"
        if [ -z "$__cerberus_skill_run_key" ]; then
            echo "cerberus skill: Codex active-session registry has no run_key: $__cerberus_skill_registry" >&2
            unset __cerberus_skill_cwd __cerberus_skill_project_key __cerberus_skill_registry __cerberus_skill_run_key
            return 1 2>/dev/null || exit 1
        fi

        export CERBERUS_PROJECT_KEY="$__cerberus_skill_project_key"
        export CERBERUS_RUN_KEY="$__cerberus_skill_run_key"
        unset __cerberus_skill_cwd __cerberus_skill_project_key __cerberus_skill_registry __cerberus_skill_run_key
    fi
fi

unset -f __cerberus_skill_env_has_backend __cerberus_skill_env_bootstrap_codex_registry
unset __cerberus_skill_env_source __cerberus_skill_env_dir __cerberus_skill_env_bin_dir __cerberus_skill_env_script_root
