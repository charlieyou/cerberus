#!/usr/bin/env bash
# review-gate - Multi-model review gate entrypoint
#
# Subcommands:
#   check          Stop hook logic (reads JSON from stdin)
#   spawn          Spawn reviewers for an artifact
#   wait           Wait for review consensus (machine-readable JSON)
#   resolve        Resolve gate and allow stop
#   artifact-path  Print session-scoped artifact path
#   author-context Set or clear author context injected into prompts
#   spawn-ask      Send an arbitrary prompt to the reviewer/debate panel

set -euo pipefail

# Resolve helper scripts relative to this file (follows symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# =============================================================================
# Centralized host-neutral env helpers
# =============================================================================
# Defined BEFORE sourcing review-gate-lib.sh so that resolve_review_dir() in
# the lib can delegate to __cerberus_resolve_run_key, AND before the
# PLUGIN_ROOT line below so __cerberus_resolve_root mediates that read.
# These helpers are the single source of truth for the ~25 read sites that
# previously inlined ${REVIEW_GATE_SESSION_KEY:-} / ${CLAUDE_PLUGIN_ROOT:-};
# T002 routed those sites through these helpers as a mechanical refactor.
#
# Plan reference: §API/Interface Design (L543-L600), §Centralized env reads
# (L100-L120), §Neutral env propagation surface (L587-L599).

# __cerberus_resolve_run_key — return the effective Cerberus run key.
# Precedence: CERBERUS_RUN_KEY > REVIEW_GATE_SESSION_KEY > "" (caller falls
# back to a positional session_id when both are unset/empty). When the two
# alias env vars are both set and disagree, emit a SINGLE warning to stderr
# guarded by a once-per-process file marker keyed on $$.
#
# Why the file marker (and not just an exported __CERBERUS_ALIAS_WARNED)?
# This helper is invoked via $(...) command substitution at ~25 call sites
# in a single bin/review-gate process. `export` inside a $()-substitution
# subshell does NOT propagate back to the parent — the subshell dies with
# the substitution and its environment is discarded. A $$-keyed marker
# under TMPDIR survives across all those subshells because $$ in bash is
# stable: it expands to the parent shell's PID inside command substitution
# subshells too. This is the only reliable way to dedupe stderr warnings
# across the many $() call sites without rewriting them to direct calls.
#
# IMPORTANT: write the warning DIRECTLY to stderr (not via log()) because
# this helper is invoked inside command substitution at many call sites;
# any stdout output would corrupt the returned run key.
__cerberus_resolve_run_key() {
    local cer="${CERBERUS_RUN_KEY:-}"
    local leg="${REVIEW_GATE_SESSION_KEY:-}"
    if [ -n "$cer" ] && [ -n "$leg" ] && [ "$cer" != "$leg" ]; then
        local _marker="${TMPDIR:-/tmp}/cerberus-alias-warned.$$"
        if [ ! -e "$_marker" ] && [ -z "${__CERBERUS_ALIAS_WARNED:-}" ]; then
            echo "warning: CERBERUS_RUN_KEY != REVIEW_GATE_SESSION_KEY; using CERBERUS_RUN_KEY" >&2
            : > "$_marker" 2>/dev/null || true
        fi
        # Belt-and-suspenders for callers that invoke the helper without
        # command substitution (e.g., the test row 8 direct-call pattern).
        export __CERBERUS_ALIAS_WARNED=1
    fi
    echo "${cer:-${leg:-}}"
}

# __cerberus_resolve_root — return the effective plugin/repo root.
# Precedence: CERBERUS_ROOT > CLAUDE_PLUGIN_ROOT > "" (caller falls back to
# the script-directory-derived PLUGIN_ROOT computed below). Mirrors the
# alias precedence rule from the env contract (plan §Alias precedence
# rule, L557-L559): when both are set non-empty and differ, CERBERUS_*
# wins and a single stderr warning is emitted.
__cerberus_resolve_root() {
    local cer="${CERBERUS_ROOT:-}"
    local leg="${CLAUDE_PLUGIN_ROOT:-}"
    if [ -n "$cer" ] && [ -n "$leg" ] && [ "$cer" != "$leg" ]; then
        # Once-per-process guard, file-marker fallback under bash 3.2 (same
        # pattern as __cerberus_resolve_run_key above). IMPORTANT: write to
        # stderr, not log() / stdout — this helper is used in $(...) and any
        # stdout output would corrupt the returned root.
        local _root_marker="${TMPDIR:-/tmp}/cerberus-root-alias-warned.$$"
        if [ ! -e "$_root_marker" ] && [ -z "${__CERBERUS_ROOT_ALIAS_WARNED:-}" ]; then
            echo "warning: CERBERUS_ROOT != CLAUDE_PLUGIN_ROOT; using CERBERUS_ROOT" >&2
            : > "$_root_marker" 2>/dev/null || true
        fi
        export __CERBERUS_ROOT_ALIAS_WARNED=1
    fi
    echo "${cer:-${leg:-}}"
}

# __cerberus_resolve_session_id — return the effective Cerberus session id.
# Precedence: CERBERUS_SESSION_ID > CLAUDE_SESSION_ID > REVIEW_GATE_SESSION_ID > "".
# Empty strings are treated as unset (parameter expansion `${VAR:-}`). When two
# or more aliases of this family are set non-empty and disagree, emit a SINGLE
# warning to stderr (once per process) guarded by a $$-keyed file marker — same
# pattern as __cerberus_resolve_run_key.
#
# Note: REVIEW_GATE_SESSION_ID is NOT the same as REVIEW_GATE_SESSION_KEY. The
# latter is owner-keying for run gate ownership and is resolved by
# __cerberus_resolve_run_key (a different concept). REVIEW_GATE_SESSION_ID is
# included here only for symmetry with the alias-resolution contract; current
# code does not export it, so the helper effectively reduces to the existing
# 2-level CERBERUS_SESSION_ID > CLAUDE_SESSION_ID precedence in practice.
#
# Sentinel: __CERBERUS_SESSION_ID_WARNED. Do NOT reuse __CERBERUS_ALIAS_WARNED
# (reserved for RUN_KEY/ROOT) — sharing it would suppress those warnings.
__cerberus_resolve_session_id() {
    local cer="${CERBERUS_SESSION_ID:-}"
    local cla="${CLAUDE_SESSION_ID:-}"
    local leg="${REVIEW_GATE_SESSION_ID:-}"
    local _mismatch=0
    if [ -n "$cer" ] && [ -n "$cla" ] && [ "$cer" != "$cla" ]; then _mismatch=1; fi
    if [ -n "$cer" ] && [ -n "$leg" ] && [ "$cer" != "$leg" ]; then _mismatch=1; fi
    if [ -n "$cla" ] && [ -n "$leg" ] && [ "$cla" != "$leg" ]; then _mismatch=1; fi
    if [ "$_mismatch" -eq 1 ]; then
        local _sid_marker="${TMPDIR:-/tmp}/cerberus-session-id-alias-warned.$$"
        if [ ! -e "$_sid_marker" ] && [ -z "${__CERBERUS_SESSION_ID_WARNED:-}" ]; then
            echo "warning: SESSION_ID alias mismatch (CERBERUS_SESSION_ID/CLAUDE_SESSION_ID/REVIEW_GATE_SESSION_ID); using CERBERUS_SESSION_ID > CLAUDE_SESSION_ID > REVIEW_GATE_SESSION_ID precedence" >&2
            : > "$_sid_marker" 2>/dev/null || true
        fi
        export __CERBERUS_SESSION_ID_WARNED=1
    fi
    echo "${cer:-${cla:-${leg:-}}}"
}

# __cerberus_resolve_transcript_path — return the effective Cerberus transcript path.
# Precedence: CERBERUS_TRANSCRIPT_PATH > CLAUDE_TRANSCRIPT_PATH > REVIEW_GATE_TRANSCRIPT_PATH > "".
# This precedence fixes the Phase 0 epic-verify P1 inversion that previously
# placed REVIEW_GATE_TRANSCRIPT_PATH ahead of CLAUDE_TRANSCRIPT_PATH at ~12
# read sites. Empty strings are treated as unset; once-per-process stderr
# warning fires when aliases of this family disagree, guarded by a $$-keyed
# file marker.
#
# Sentinel: __CERBERUS_TRANSCRIPT_PATH_WARNED. As with session-id above, this
# is a separate sentinel from RUN_KEY/ROOT to avoid cross-suppression.
__cerberus_resolve_transcript_path() {
    local cer="${CERBERUS_TRANSCRIPT_PATH:-}"
    local cla="${CLAUDE_TRANSCRIPT_PATH:-}"
    local leg="${REVIEW_GATE_TRANSCRIPT_PATH:-}"
    local _mismatch=0
    if [ -n "$cer" ] && [ -n "$cla" ] && [ "$cer" != "$cla" ]; then _mismatch=1; fi
    if [ -n "$cer" ] && [ -n "$leg" ] && [ "$cer" != "$leg" ]; then _mismatch=1; fi
    if [ -n "$cla" ] && [ -n "$leg" ] && [ "$cla" != "$leg" ]; then _mismatch=1; fi
    if [ "$_mismatch" -eq 1 ]; then
        local _tp_marker="${TMPDIR:-/tmp}/cerberus-transcript-path-alias-warned.$$"
        if [ ! -e "$_tp_marker" ] && [ -z "${__CERBERUS_TRANSCRIPT_PATH_WARNED:-}" ]; then
            echo "warning: TRANSCRIPT_PATH alias mismatch (CERBERUS_TRANSCRIPT_PATH/CLAUDE_TRANSCRIPT_PATH/REVIEW_GATE_TRANSCRIPT_PATH); using CERBERUS_TRANSCRIPT_PATH > CLAUDE_TRANSCRIPT_PATH > REVIEW_GATE_TRANSCRIPT_PATH precedence" >&2
            : > "$_tp_marker" 2>/dev/null || true
        fi
        export __CERBERUS_TRANSCRIPT_PATH_WARNED=1
    fi
    echo "${cer:-${cla:-${leg:-}}}"
}

# __cerberus_export_neutral_env_for_subprocess <fallback-sid> <fallback-tp>
# Export the full neutral-env block (CERBERUS_* + legacy aliases) into the
# current shell so any subsequent subprocess invocation inherits them. Used
# by the spawn-* re-entry sites (spawn-code-review, spawn-plan-review,
# spawn-spec-review, spawn-epic-verify, spawn-ask) to ensure spawned
# bin/review-gate processes pick up the same host-neutral context the
# parent was invoked with. Plan §Neutral env propagation surface (L587-L599)
# enumerates the env block. Empty CERBERUS_* values are passed through
# verbatim so that the child's resolver still treats them as unset (the
# ${VAR:-} idiom — plan L96-L97).
__cerberus_export_neutral_env_for_subprocess() {
    local _fallback_sid="${1:-}"
    local _fallback_tp="${2:-}"
    local _rk
    _rk="$(__cerberus_resolve_run_key)"
    export CERBERUS_HOST="${CERBERUS_HOST:-}"
    export CERBERUS_ROOT="${CERBERUS_ROOT:-}"
    export CERBERUS_STATE_ROOT="${CERBERUS_STATE_ROOT:-}"
    export CERBERUS_PROJECT_KEY="${CERBERUS_PROJECT_KEY:-}"
    export CERBERUS_SESSION_ID="${CERBERUS_SESSION_ID:-$_fallback_sid}"
    export CERBERUS_RUN_KEY="${CERBERUS_RUN_KEY:-$_rk}"
    export CERBERUS_TRANSCRIPT_PATH="${CERBERUS_TRANSCRIPT_PATH:-$_fallback_tp}"
    # Legacy alias kept in sync. CLAUDE_SESSION_ID / CLAUDE_TRANSCRIPT_PATH
    # are still cmd-prefixed at each spawn-* call site (so the explicit
    # cmd-prefix value wins for the subprocess) — we only ensure
    # REVIEW_GATE_SESSION_KEY is present here because the spawn lines do
    # not set it explicitly.
    export REVIEW_GATE_SESSION_KEY="${REVIEW_GATE_SESSION_KEY:-$_rk}"
}

PLUGIN_ROOT="$(__cerberus_resolve_root)"
PLUGIN_ROOT="${PLUGIN_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
CLI_CMD="${PLUGIN_ROOT}/bin/review-gate"

# Best-effort cleanup of the alias-warning markers (created lazily by the
# __cerberus_resolve_* helpers when their respective alias families disagree).
# Some subcommand functions register their own EXIT traps further down; the
# last `trap ... EXIT` wins, so this top-level trap may be clobbered. That
# is acceptable: the markers are 0-byte files keyed on $$ that the OS
# reaps as part of routine TMPDIR cleanup. The trap below ensures cleanup
# in the common subcommand paths that don't register their own EXIT trap.
trap '__cerberus_marker_dir="${TMPDIR:-/tmp}"; rm -f "$__cerberus_marker_dir/cerberus-alias-warned.$$" "$__cerberus_marker_dir/cerberus-root-alias-warned.$$" "$__cerberus_marker_dir/cerberus-session-id-alias-warned.$$" "$__cerberus_marker_dir/cerberus-transcript-path-alias-warned.$$" 2>/dev/null || true' EXIT

# Load shared helpers
source "$SCRIPT_DIR/review-gate-lib.sh"
source "$SCRIPT_DIR/review-gate-models.sh"

# Source telemetry library (after review-gate-lib.sh)
if [[ -f "$SCRIPT_DIR/telemetry-lib.sh" ]]; then
    source "$SCRIPT_DIR/telemetry-lib.sh" 2>/dev/null || true
fi

source "$SCRIPT_DIR/review-gate-hook.sh"

# =============================================================================
# Main Script
# =============================================================================



usage() {
    cat <<USAGE
Usage: ${CLI_CMD} <command> [args]

Cerberus - Three-headed guardian of code quality.
Multi-model consensus review with Codex, Gemini, and Claude.

Commands:
  check
    Stop hook logic (reads JSON from stdin)

  spawn [--agents <list>] [--max-rounds <n>] [--mode <fast|smart|max>] [--consensus <majority|all|any>] [--context-file <path>] [--debate] <artifact-path>
    Spawn reviewers for an artifact. If no artifact path is provided, uses the
    session-scoped latest.md when available.

  spawn-code-review [--agents <list>] [--max-rounds <n>] [--mode <fast|smart|max>] [--consensus <majority|all|any>] [--context-file <path>] [--focus <text>] [--exclude <pathspec>...] [--debate] [--uncommitted | --base <branch> | --commit <sha...> | <range>]
    Spawn reviewers for code changes. Claude fixes code until consensus passes.
    Diff modes: --uncommitted (default), --base <branch>, --commit <sha...>, <range>
    Options:
      --commit <shas>     Review one or more commits as a net diff (space or comma separated)
      --exclude <spec>    Exclude files matching pattern (auto-prefixed with :! for git)
      --debate            Opt in to debate-mode review (requires >=2 available reviewers)

  spawn-plan-review [--agents <list>] [--max-rounds <n>] [--mode <fast|smart|max>] [--consensus <majority|all|any>] [--context-file <path>] [--focus <text>] [--debate] [plan-path]
    Spawn reviewers for a plan file. If no plan path is provided, uses the
    most recent session plan from ~/.claude/plans/. Claude fixes plan until
    consensus passes.

  spawn-spec-review [--agents <list>] [--max-rounds <n>] [--mode <fast|smart|max>] [--consensus <majority|all|any>] [--context-file <path>] [--debate] <spec-path>
    Spawn reviewers for a spec file. Claude fixes spec until consensus passes.

  spawn-epic-verify [--agents <list>] [--max-rounds <n>] [--mode <fast|smart|max>] [--consensus <majority|all|any>] [--debate] <epic-file>
    Spawn reviewers to verify epic acceptance criteria against the codebase.
    Reviewers explore the code themselves to verify criteria are met.
    Claude fixes code until all criteria pass consensus verification.

  spawn-ask [--agents <list>] [--max-rounds <n>] [--mode <fast|smart|max>] [--consensus <majority|all|any>] [--context-file <path>] [--prompt-file <path>] [--debate] [--] <prompt>
    Send an arbitrary prompt to the reviewer panel. With --debate, routes the
    prompt through the debate coordinator (requires >=2 available reviewers).

  wait --json [--finalize] [--timeout <sec>] [--poll-interval <sec>] [--session-key <key>]
    Block/poll until consensus or timeout. Outputs machine-readable JSON.

  status --json [--session-key <key>] [--session-id <id>] [--transcript-path <path>]
    Non-mutating, non-blocking snapshot of the gate. Outputs canonical JSON
    consumed by Codex Stop and Amp Status surfaces. Exit 0 on success, 4
    when no active gate, 2 on internal error.

  resolve [--reason <text>]
    Resolve the active gate and allow the session to stop.

  artifact-path [--session-id <id>] [--transcript-path <path>]
    Print the session-scoped review artifact path.

  author-context [--session-id <id>] [--transcript-path <path>] [--clear] [text]
    Set or clear author context injected into reviewer prompts.

Agents list:
  --agents <list>
    Comma-separated subset of agents: codex, gemini, claude
USAGE
}

die() {
    echo "Error: $*" >&2
    exit 2
}

validate_max_rounds() {
    local value="${1:-}"
    if [[ -z "$value" ]]; then
        return 0
    fi
    if [[ ! "$value" =~ ^[0-9]+$ ]] || [[ "$value" -lt 0 ]]; then
        die "Invalid --max-rounds '$value' (must be >= 0)"
    fi
}

validate_consensus_mode() {
    local value="${1:-}"
    if [[ -z "$value" ]]; then
        return 0
    fi
    case "$value" in
        majority|all|any) return 0 ;;
        *) die "Invalid --consensus '$value' (must be: majority, all, or any)" ;;
    esac
}

# Read author context from a file (error on missing/empty).
read_context_file() {
    local path="${1:-}"
    if [[ -z "$path" ]]; then
        echo ""
        return 0
    fi
    if [[ ! -f "$path" ]]; then
        die "Context file not found: $path"
    fi
    local content
    content=$(cat "$path")
    if [[ -z "$content" ]]; then
        die "Context file is empty: $path"
    fi
    printf '%s' "$content"
}

resolve_realpath() {
    local p="${1:-}"
    if [[ -z "$p" ]]; then
        return 1
    fi

    local resolved=""
    if command -v realpath >/dev/null 2>&1; then
        if resolved=$(realpath -- "$p" 2>/dev/null); then
            printf '%s\n' "$resolved"
            return 0
        fi
        if resolved=$(realpath "$p" 2>/dev/null); then
            printf '%s\n' "$resolved"
            return 0
        fi
    fi

    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$p"
        return $?
    fi

    if [[ -d "$p" ]]; then
        ( cd -- "$p" && pwd -P )
    elif [[ -f "$p" ]]; then
        local d b
        d=$(dirname -- "$p")
        b=$(basename -- "$p")
        ( cd -- "$d" && printf '%s/%s\n' "$(pwd -P)" "$b" )
    else
        return 1
    fi
}

markdown_fence_for_content() {
    local content="$1"
    awk '
        BEGIN { max = 2 }
        {
            line = $0
            i = 0
            while (i < 3 && substr(line, 1, 1) == " ") {
                line = substr(line, 2)
                i++
            }
            if (match(line, /^`+/) && RLENGTH > max) max = RLENGTH
        }
        END {
            for (i = 0; i < max + 1; i++) printf "`"
            printf "\n"
        }
    ' <<< "$content"
}

# Resolve author context with precedence: context file > env override > stored state.
resolve_author_context() {
    local review_dir="${1:-}"
    local context_file="${2:-}"
    local context=""

    if [[ -n "$context_file" ]]; then
        context=$(read_context_file "$context_file")
        printf '%s' "$context"
        return 0
    fi

    if [[ -n "${REVIEW_GATE_AUTHOR_CONTEXT+x}" ]]; then
        printf '%s' "$REVIEW_GATE_AUTHOR_CONTEXT"
        return 0
    fi

    if [[ -n "$review_dir" ]]; then
        local state_file="$review_dir/gate-state.json"
        if [[ -f "$state_file" ]]; then
            context=$(jq -r '.author_context // ""' "$state_file" 2>/dev/null || echo "")
            if [[ "$context" == "null" ]]; then
                context=""
            fi
        fi
    fi

    printf '%s' "$context"
}

# Build the author context block for prompts.
author_context_block() {
    local context="$1"
    if [[ -z "$context" ]]; then
        echo ""
        return 0
    fi
    printf '%s' "## Author Context"$'\n\n'"Use these clarifications when evaluating the artifact and prior feedback."$'\n\n'"$context"
}

# Inject a context block before "## Output Format" (or append if not found).
inject_context_block() {
    local prompt_content="$1"
    local context_block="$2"
    if [[ -z "$context_block" ]]; then
        printf '%s' "$prompt_content"
        return 0
    fi

    local context_tmp
    context_tmp=$(mktemp -t review-gate-context.XXXXXX)
    printf '%s' "$context_block" > "$context_tmp"

    local updated
    updated=$(awk -v ctx_file="$context_tmp" '
        BEGIN { while ((getline line < ctx_file) > 0) ctx = ctx (ctx ? "\n" : "") line; close(ctx_file); inserted=0 }
        /^## Output Format/ && inserted==0 {
            print ctx
            print ""
            inserted=1
        }
        { print }
        END { if (inserted==0) { print ""; print ctx } }
    ' <<< "$prompt_content")
    rm -f "$context_tmp"
    printf '%s' "$updated"
}

# normalize_mode and validate_mode are provided by review-gate-models.sh

# Substitute debate-mode reviewer template placeholders:
#   ${CONFIDENCE_ANCHORS}, ${STRATEGY_DIRECTIVE}, ${PEER_BLOCK}, ${PRIOR_ROUND_SELF_BLOCK}, ${DEBATE_OUTPUT_SHAPE}
#
# Reads prompt content from stdin, writes the substituted content to stdout.
#
# Arguments:
#   $1 - debate flag ("true" enables anchor/strategy injection; anything else
#        consumes every placeholder line entirely so the rendered prompt is
#        byte-identical to a template that never had the placeholders, per
#        spec D2).
#   $2 - assigned strategy name (only used when debate=true; default
#        "verification-first"). T005 wires real per-(artifact, reviewer)
#        assignment via the coordinator stub; T004 leaves it as a no-op
#        default so the substitution is exercisable end-to-end.
#
# When --debate is absent: every placeholder line is removed in its entirety
# (line + trailing newline) using `sed -E`. This consumes the placeholder
# whitespace exactly once (D2 line-consume semantics).
#
# When --debate is set: ${CONFIDENCE_ANCHORS} is replaced with the literal
# bytes of prompts/strategies/confidence-anchors.md; ${STRATEGY_DIRECTIVE} is
# replaced with the literal bytes of prompts/strategies/<strategy>.md;
# ${PEER_BLOCK} and ${PRIOR_ROUND_SELF_BLOCK} are consumed entirely (T008
# fills them).
#
# Bash 3.2-portable (uses sed -E and awk only; no Bash-4 parameter
# expansions; no GNU-only sed extensions).
substitute_debate_placeholders() {
    local debate="${1:-false}"
    local strategy_name="${2:-verification-first}"

    if [[ "$debate" != "true" ]]; then
        # Consume entire placeholder lines (line + trailing newline) so the
        # rendered prompt is byte-identical to a template that never had
        # the placeholders. R9 byte-parity requirement.
        sed -E '/^\$\{(CONFIDENCE_ANCHORS|STRATEGY_DIRECTIVE|PEER_BLOCK|PRIOR_ROUND_SELF_BLOCK|DEBATE_OUTPUT_SHAPE)\}$/d'
        return 0
    fi

    # Resolve asset paths with project-local override support, mirroring the
    # template-resolution pattern used elsewhere in this file.
    local project_root
    project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

    local anchors_path=""
    local _path
    for _path in "$project_root/prompts/strategies/confidence-anchors.md" \
                 "$SCRIPT_DIR/../prompts/strategies/confidence-anchors.md"; do
        if [[ -f "$_path" ]]; then
            anchors_path="$_path"
            break
        fi
    done

    local strategy_path=""
    for _path in "$project_root/prompts/strategies/${strategy_name}.md" \
                 "$SCRIPT_DIR/../prompts/strategies/${strategy_name}.md"; do
        if [[ -f "$_path" ]]; then
            strategy_path="$_path"
            break
        fi
    done

    local debate_output_shape_path=""
    for _path in "$project_root/prompts/strategies/debate-output-shape.md" \
                 "$SCRIPT_DIR/../prompts/strategies/debate-output-shape.md"; do
        if [[ -f "$_path" ]]; then
            debate_output_shape_path="$_path"
            break
        fi
    done

    if [[ -z "$anchors_path" ]]; then
        die "Confidence anchors strategy file not found: prompts/strategies/confidence-anchors.md"
    fi
    if [[ -z "$strategy_path" ]]; then
        die "Strategy directive file not found: prompts/strategies/${strategy_name}.md"
    fi
    if [[ -z "$debate_output_shape_path" ]]; then
        die "Debate output shape file not found: prompts/strategies/debate-output-shape.md"
    fi

    # Substitute via awk: read each strategy / per-recipient block file once
    # via getline (preserving exact line bytes), then for each input line,
    # replace whole-line placeholders with the file contents (or consume the
    # line for PEER_BLOCK / PRIOR_ROUND_SELF_BLOCK when the matching env vars
    # are unset). The accumulator+`print` pattern produces output bytes
    # byte-identical to the source files (each source ends with a single
    # trailing \n, which is what `print` emits).
    #
    # T008: Round-2 prompt construction may pre-render per-recipient PEER_BLOCK
    # and PRIOR_ROUND_SELF_BLOCK content into env vars before invoking
    # build_prompt; when set (non-empty), the matching placeholder line is
    # substituted with the env-var content (in place of consume). When unset
    # (or empty — Round 1 default), the placeholder line is consumed entirely
    # (line + trailing newline) so the rendered prompt is byte-identical to a
    # template that never had the placeholder. Under `--debate` absent the
    # consume path runs unconditionally above (the early `sed -E` branch).
    #
    # Multi-line content portability: PEER_BLOCK / PRIOR_ROUND_SELF_BLOCK
    # contain markdown with literal LFs. Many `awk` implementations (BSD
    # awk, mawk) DO NOT accept literal newlines in `-v var="..."` value
    # arguments — they replace the LF with whitespace or split the assign
    # across multiple `-v` evaluations. The portable pattern that the
    # rest of this function already uses is to write multi-line content
    # to a temp file and read it via `getline` in BEGIN. We mirror that
    # pattern here: stage env-var content (when set) into temp files,
    # then pass file paths (single-line, no newlines) via -v. The temp
    # files are cleaned up after awk returns.
    local _peer_block_file=""
    local _prior_self_block_file=""
    if [[ -n "${PEER_BLOCK:-}" ]]; then
        _peer_block_file=$(mktemp -t cerberus-debate-peer-block.XXXXXX) || \
            die "substitute_debate_placeholders: cannot allocate temp file for PEER_BLOCK"
        printf '%s' "$PEER_BLOCK" > "$_peer_block_file"
    fi
    if [[ -n "${PRIOR_ROUND_SELF_BLOCK:-}" ]]; then
        _prior_self_block_file=$(mktemp -t cerberus-debate-prior-self.XXXXXX) || \
            die "substitute_debate_placeholders: cannot allocate temp file for PRIOR_ROUND_SELF_BLOCK"
        printf '%s' "$PRIOR_ROUND_SELF_BLOCK" > "$_prior_self_block_file"
    fi

    awk -v anchors_file="$anchors_path" -v strategy_file="$strategy_path" \
        -v debate_output_shape_file="$debate_output_shape_path" \
        -v peer_block_file="$_peer_block_file" \
        -v prior_self_block_file="$_prior_self_block_file" '
        BEGIN {
            n = 0
            while ((getline line < anchors_file) > 0) {
                if (n++) anchors = anchors "\n" line
                else      anchors = line
            }
            close(anchors_file)
            n = 0
            while ((getline line < strategy_file) > 0) {
                if (n++) strategy = strategy "\n" line
                else      strategy = line
            }
            close(strategy_file)
            n = 0
            while ((getline line < debate_output_shape_file) > 0) {
                if (n++) debate_output_shape = debate_output_shape "\n" line
                else      debate_output_shape = line
            }
            close(debate_output_shape_file)
            peer_block = ""
            prior_self_block = ""
            if (peer_block_file != "") {
                n = 0
                while ((getline line < peer_block_file) > 0) {
                    if (n++) peer_block = peer_block "\n" line
                    else      peer_block = line
                }
                close(peer_block_file)
            }
            if (prior_self_block_file != "") {
                n = 0
                while ((getline line < prior_self_block_file) > 0) {
                    if (n++) prior_self_block = prior_self_block "\n" line
                    else      prior_self_block = line
                }
                close(prior_self_block_file)
            }
        }
        /^\$\{CONFIDENCE_ANCHORS\}$/     { print anchors;              next }
        /^\$\{STRATEGY_DIRECTIVE\}$/     { print strategy;             next }
        /^\$\{DEBATE_OUTPUT_SHAPE\}$/    { print debate_output_shape;  next }
        /^\$\{PEER_BLOCK\}$/             {
                                            if (peer_block != "") print peer_block
                                            next
                                         }
        /^\$\{PRIOR_ROUND_SELF_BLOCK\}$/ {
                                            if (prior_self_block != "") print prior_self_block
                                            next
                                         }
        { print }
    '
    local _awk_rc=$?
    [[ -n "$_peer_block_file" ]] && rm -f "$_peer_block_file"
    [[ -n "$_prior_self_block_file" ]] && rm -f "$_prior_self_block_file"
    return $_awk_rc
}

review_gate_spawn_code_review() {
    # --- Parse diff mode args ---
    local diff_mode="--uncommitted"
    local diff_target=""
    local diff_args_str="--uncommitted"  # Default matches diff_mode default
    local agents_csv=""
    local max_rounds=""
    local mode=""
    local context_file=""
    local focus_area=""
    local -a positionals=()
    local force_focus="false"
    local artifact_only="false"
    local -a exclude_pathspecs=()
    local consensus_mode=""
    local debate="false"
    local debate_seed=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --artifact-only)
                artifact_only="true"
                shift
                ;;
            --debate)
                debate="true"
                shift
                ;;
            --debate-seed=*)
                debate_seed="${1#*=}"
                shift
                ;;
            --debate-seed)
                debate_seed="${2:-}"
                shift 2
                ;;
            --agents=*)
                agents_csv="${1#*=}"
                shift
                ;;
            --agents)
                agents_csv="${2:-}"
                shift 2
                ;;
            --max-rounds=*)
                max_rounds="${1#*=}"
                shift
                ;;
            --max-rounds)
                max_rounds="${2:-}"
                shift 2
                ;;
            --mode=*)
                mode="${1#*=}"
                shift
                ;;
            --mode)
                mode="${2:-}"
                shift 2
                ;;
            --context-file=*)
                context_file="${1#*=}"
                shift
                ;;
            --context-file)
                context_file="${2:-}"
                shift 2
                ;;
            --focus=*)
                focus_area="${1#*=}"
                shift
                ;;
            --focus)
                focus_area="${2:-}"
                shift 2
                ;;
            --exclude=*)
                exclude_pathspecs+=("${1#*=}")
                shift
                ;;
            --exclude)
                exclude_pathspecs+=("${2:-}")
                shift 2
                ;;
            --consensus=*)
                consensus_mode="${1#*=}"
                shift
                ;;
            --consensus)
                consensus_mode="${2:-}"
                shift 2
                ;;
            --uncommitted)
                diff_mode="--uncommitted"
                diff_args_str="--uncommitted"
                shift
                ;;
            --base)
                diff_mode="--base"
                diff_target="${2:-main}"
                diff_args_str="--base $diff_target"
                shift 2
                ;;
            --commit)
                diff_mode="--commit"
                shift
                # Collect all following args that are valid commits; stop at first non-commit
                local -a commit_shas=()
                while [[ $# -gt 0 && ! "$1" =~ ^- ]]; do
                    local arg="$1"
                    # Check if this looks like comma-separated SHAs
                    if [[ "$arg" == *,* ]]; then
                        # Handle comma-separated SHAs in a single arg
                        local all_valid=true
                        for sha in ${arg//,/ }; do
                            if ! git rev-parse --verify "$sha^{commit}" &>/dev/null; then
                                all_valid=false
                                break
                            fi
                        done
                        if [[ "$all_valid" == "true" ]]; then
                            shift
                            for sha in ${arg//,/ }; do
                                commit_shas+=("$sha")
                            done
                        else
                            # Not valid commits - stop collecting, rest is focus text
                            break
                        fi
                    elif git rev-parse --verify "$arg^{commit}" &>/dev/null; then
                        shift
                        commit_shas+=("$arg")
                    else
                        # Not a valid commit - stop collecting, rest becomes focus text
                        break
                    fi
                done
                if [[ ${#commit_shas[@]} -eq 0 ]]; then
                    die "--commit requires at least one commit SHA"
                fi
                # Store as comma-separated for consistent round-tripping
                diff_target=$(IFS=,; echo "${commit_shas[*]}")
                diff_args_str="--commit $diff_target"
                # Remaining non-option args will be collected as focus text by the positionals handler
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} spawn-code-review [options]

Options:
  --agents <list>      Comma-separated subset of agents: codex,gemini,claude
  --max-rounds <n>     Maximum review iterations before manual resolution (0 disables auto-respawn)
  --mode <level>       Intelligence mode: fast, smart, max
  --consensus <mode>   Consensus mode: majority (default), all, any
  --context-file <path> Inject task context from file (provides background for reviewers)
  --focus <text>       Focus area to emphasize in the review
  --exclude <pathspec> Exclude files matching pattern (auto-prefixed with :! for git)
  --uncommitted       Review uncommitted changes (default)
  --base <branch>     Review changes from branch to HEAD
  --commit <sha...>   Review one or more commits as a net diff (space or comma separated)
  <range>             Review a commit range (e.g., main..feature)
  --debate            Opt in to debate-mode review (requires >=2 available reviewers)
  [--] <focus>        Optional focus text (use --focus or trailing text; -- forces focus)

Consensus modes:
  majority  At least 2 reviewers PASS, or all valid PASS (default)
  all       All valid reviewers must PASS (errored reviewers skipped)
  any       At least one reviewer PASS

Note: FAIL verdicts and P0/P1 findings always block regardless of mode.

Spawns reviewers to evaluate code changes. Claude fixes code until consensus passes.
USAGE
                return 0
                ;;
            --)
                shift
                force_focus="true"
                if [[ $# -gt 0 ]]; then
                    positionals+=("$@")
                fi
                break
                ;;
            -*)
                die "Unknown option '$1'"
                ;;
            *)
                positionals+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${#positionals[@]} -gt 0 ]]; then
        if [[ "$force_focus" != "true" && "$diff_mode" == "--uncommitted" ]]; then
            local first_pos="${positionals[0]}"
            if [[ "$first_pos" == *..* ]]; then
                # Commit range like main..feature - validate it exists
                if ! git rev-parse --verify "${first_pos%%..*}^{commit}" >/dev/null 2>&1 || \
                   ! git rev-parse --verify "${first_pos##*..}^{commit}" >/dev/null 2>&1; then
                    die "Invalid commit range: $first_pos (use -- to force as focus text)"
                fi
                diff_mode="range"
                diff_target="$first_pos"
                diff_args_str="$first_pos"
                positionals=("${positionals[@]:1}")
            elif git rev-parse --verify "${first_pos}^{commit}" >/dev/null 2>&1; then
                # Valid git reference (branch, tag, or SHA)
                diff_mode="--base"
                diff_target="$first_pos"
                diff_args_str="--base $first_pos"
                positionals=("${positionals[@]:1}")
            elif [[ "$first_pos" =~ ^[a-zA-Z0-9_/-]+$ ]] && [[ ${#positionals[@]} -eq 1 ]]; then
                # Single word that looks like a git ref but doesn't exist - likely a typo
                die "Unknown git reference: $first_pos (use -- to force as focus text)"
            fi
        fi

        if [[ ${#positionals[@]} -gt 0 ]]; then
            if [[ -n "$focus_area" ]]; then
                die "Focus provided both via --focus and positional arguments"
            fi
            focus_area="${positionals[*]}"
        fi
    fi

    if [[ ${#exclude_pathspecs[@]} -gt 0 ]]; then
        local spec
        local -a normalized_excludes=()
        for spec in "${exclude_pathspecs[@]}"; do
            if [[ -z "$spec" ]]; then
                die "--exclude requires a pathspec"
            fi
            # Auto-prefix with :! if not already a git exclude pathspec
            if [[ "$spec" != :!* && "$spec" != ":(exclude"* ]]; then
                spec=":!$spec"
            fi
            normalized_excludes+=("$spec")
        done
        exclude_pathspecs=("${normalized_excludes[@]}")
    fi

    mode=$(normalize_mode "$mode")
    if [[ -z "$mode" ]]; then
        mode="smart"
    fi
    validate_mode "$mode"
    resolve_intelligence_mode "$mode"

    # Default max_rounds: CLI flag > env var > hardcoded 3
    if [[ -z "$max_rounds" ]]; then
        max_rounds="${REVIEW_GATE_MAX_ROUNDS:-3}"
    fi

    validate_max_rounds "$max_rounds"

    # Default consensus_mode: CLI flag > env var > hardcoded "majority"
    if [[ -z "$consensus_mode" ]]; then
        consensus_mode="${REVIEW_GATE_CONSENSUS:-majority}"
    fi
    validate_consensus_mode "$consensus_mode"

    if [[ ${#exclude_pathspecs[@]} -gt 0 ]]; then
        local spec
        for spec in "${exclude_pathspecs[@]}"; do
            diff_args_str+=" --exclude $spec"
        done
    fi

    # --- Session metadata ---
    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"

    if [[ -z "$session_id" && -n "$transcript_path" ]]; then
        session_id="$(basename "$transcript_path" .jsonl)"
    fi

    # --- Gather the diff ---
    local diff_content=""
    local -a pathspec_args=()
    if [[ ${#exclude_pathspecs[@]} -gt 0 ]]; then
        pathspec_args=(-- . "${exclude_pathspecs[@]}")
    fi

    # net_diff_from_commits: Compute net diff from a list of commits
    # Args: output_file reason_file commit1 [commit2 ...]
    # Returns: 0 = success (output in output_file)
    #          1 = fallback needed (reason in reason_file)
    #          2 = strict mode failure (reason in reason_file, caller should die)
    net_diff_from_commits() {
        local output_file="$1"
        local reason_file="$2"
        shift 2
        local -a commits=("$@")

        # Clear output and reason files
        : > "$output_file"
        : > "$reason_file"

        if [[ ${#commits[@]} -eq 0 ]]; then
            return 0  # Success with empty output
        fi
        local strict_mode="${REVIEW_GATE_COMMIT_NET_STRICT:-0}"

        local -a parent_shas=()
        local sha
        for sha in "${commits[@]}"; do
            local parent_sha
            parent_sha=$(git rev-parse "$sha^" 2>/dev/null || true)
            if [[ -n "$parent_sha" ]]; then
                parent_shas+=("$parent_sha")
            fi
        done

        local base_sha=""
        if [[ ${#parent_shas[@]} -gt 0 ]]; then
            base_sha=$(git merge-base --octopus "${parent_shas[@]}" 2>/dev/null || true)
        fi

        if [[ -z "$base_sha" ]]; then
            base_sha=$(git hash-object -t tree /dev/null 2>/dev/null || true)
            if [[ -z "$base_sha" ]]; then
                if [[ "$strict_mode" == "1" ]]; then
                    printf '%s' "Unable to compute base for --commit net diff" > "$reason_file"
                    return 2
                fi
                printf '%s' "unable to compute base" > "$reason_file"
                return 1
            fi
        fi

        local base_tree
        if git cat-file -e "${base_sha}^{commit}" 2>/dev/null; then
            base_tree="${base_sha}^{tree}"
        else
            base_tree="$base_sha"
        fi

        local tmp_index
        tmp_index=$(mktemp -t review-gate-index.XXXXXX)
        if ! GIT_INDEX_FILE="$tmp_index" git read-tree "$base_tree" >/dev/null 2>&1; then
            rm -f "$tmp_index"
            if [[ "$strict_mode" == "1" ]]; then
                printf '%s' "Failed to read base tree for --commit net diff" > "$reason_file"
                return 2
            fi
            printf '%s' "failed to read base tree" > "$reason_file"
            return 1
        fi

        for sha in "${commits[@]}"; do
            local patch=""
            local parent_sha
            parent_sha=$(git rev-parse "$sha^" 2>/dev/null || true)
            if [[ -n "$parent_sha" ]]; then
                if [[ ${#pathspec_args[@]} -gt 0 ]]; then
                    patch=$(git diff --binary "$parent_sha" "$sha" "${pathspec_args[@]}" 2>/dev/null || true)
                else
                    patch=$(git diff --binary "$parent_sha" "$sha" 2>/dev/null || true)
                fi
            else
                if [[ ${#pathspec_args[@]} -gt 0 ]]; then
                    patch=$(git show --binary --pretty=format: --root "$sha" "${pathspec_args[@]}" 2>/dev/null || true)
                else
                    patch=$(git show --binary --pretty=format: --root "$sha" 2>/dev/null || true)
                fi
            fi

            if [[ -z "$patch" ]]; then
                continue
            fi

            if ! printf '%s\n' "$patch" | GIT_INDEX_FILE="$tmp_index" git apply --cached --3way --whitespace=nowarn - >/dev/null 2>&1; then
                rm -f "$tmp_index"
                if [[ "$strict_mode" == "1" ]]; then
                    printf '%s' "Failed to apply commit $sha while building net diff" > "$reason_file"
                    return 2
                fi
                printf '%s' "apply failed for commit $sha" > "$reason_file"
                return 1
            fi
        done

        local new_tree
        new_tree=$(GIT_INDEX_FILE="$tmp_index" git write-tree 2>/dev/null || true)
        if [[ -z "$new_tree" ]]; then
            rm -f "$tmp_index"
            if [[ "$strict_mode" == "1" ]]; then
                printf '%s' "Failed to write tree for --commit net diff" > "$reason_file"
                return 2
            fi
            printf '%s' "failed to write tree" > "$reason_file"
            return 1
        fi

        if [[ ${#pathspec_args[@]} -gt 0 ]]; then
            git diff-tree -r --binary -p "$base_tree" "$new_tree" "${pathspec_args[@]}" 2>/dev/null > "$output_file" || true
        else
            git diff-tree -r --binary -p "$base_tree" "$new_tree" 2>/dev/null > "$output_file" || true
        fi

        rm -f "$tmp_index"
        return 0
    }
    
    case "$diff_mode" in
        --uncommitted)
            if [[ ${#pathspec_args[@]} -gt 0 ]]; then
                diff_content=$(git diff "${pathspec_args[@]}" 2>/dev/null || true)
            else
                diff_content=$(git diff 2>/dev/null || true)
            fi
            local cached_diff
            if [[ ${#pathspec_args[@]} -gt 0 ]]; then
                cached_diff=$(git diff --cached "${pathspec_args[@]}" 2>/dev/null || true)
            else
                cached_diff=$(git diff --cached 2>/dev/null || true)
            fi
            if [[ -n "$cached_diff" ]]; then
                if [[ -n "$diff_content" ]]; then
                    diff_content+=$'\n'"$cached_diff"
                else
                    diff_content="$cached_diff"
                fi
            fi
            ;;
        --base)
            local base_sha
            base_sha=$(git merge-base "$diff_target" HEAD 2>/dev/null || true)
            local head_sha
            head_sha=$(git rev-parse HEAD 2>/dev/null || true)
            if [[ ${#pathspec_args[@]} -gt 0 ]]; then
                diff_content=$(git diff "${base_sha}..${head_sha}" "${pathspec_args[@]}" 2>/dev/null || true)
            else
                diff_content=$(git diff "${base_sha}..${head_sha}" 2>/dev/null || true)
            fi
            ;;
        --commit)
            local commits_list="${diff_target//,/ }"
            local net_diff_output_file net_diff_reason_file
            net_diff_output_file=$(mktemp -t review-gate-net-diff-out.XXXXXX)
            net_diff_reason_file=$(mktemp -t review-gate-net-diff-reason.XXXXXX)

            local net_diff_rc=0
            net_diff_from_commits "$net_diff_output_file" "$net_diff_reason_file" $commits_list || net_diff_rc=$?

            if [[ $net_diff_rc -eq 0 ]]; then
                # Success - use net diff (even if empty, which will be caught later)
                diff_content=$(cat "$net_diff_output_file")
            elif [[ $net_diff_rc -eq 2 ]]; then
                # Strict mode failure - die with the reason
                local strict_reason
                strict_reason=$(cat "$net_diff_reason_file")
                rm -f "$net_diff_output_file" "$net_diff_reason_file"
                die "$strict_reason"
            else
                # Non-strict failure (rc=1) - fallback to per-commit diffs
                local fallback_reason
                fallback_reason=$(cat "$net_diff_reason_file")
                if [[ -n "$fallback_reason" ]]; then
                    commit_net_warning="Note: Net diff failed ($fallback_reason); falling back to per-commit diffs."
                fi
                local sha
                for sha in $commits_list; do
                    local commit_diff
                    if [[ ${#pathspec_args[@]} -gt 0 ]]; then
                        commit_diff=$(git show "$sha" "${pathspec_args[@]}" 2>/dev/null || true)
                    else
                        commit_diff=$(git show "$sha" 2>/dev/null || true)
                    fi
                    if [[ -n "$commit_diff" ]]; then
                        if [[ -n "$diff_content" ]]; then
                            diff_content+=$'\n'"$commit_diff"
                        else
                            diff_content="$commit_diff"
                        fi
                    fi
                done
            fi
            rm -f "$net_diff_output_file" "$net_diff_reason_file"
            ;;
        range)
            if [[ ${#pathspec_args[@]} -gt 0 ]]; then
                diff_content=$(git diff "$diff_target" "${pathspec_args[@]}" 2>/dev/null || true)
            else
                diff_content=$(git diff "$diff_target" 2>/dev/null || true)
            fi
            ;;
    esac

    if [[ -z "$diff_content" ]]; then
        die "No changes found for diff mode: $diff_mode ${diff_target:-}"
    fi

    if [[ -z "$session_id" ]]; then
        # T002: host-neutral fallback. resolve_review_dir() delegates run-key
        # resolution to __cerberus_resolve_run_key, so any non-empty value
        # here satisfies its non-empty check. Using the neutral run key as
        # session_id lets Codex/Amp/generic spawns work without
        # CLAUDE_SESSION_ID set.
        session_id="$(__cerberus_resolve_run_key)"
    fi
    if [[ -z "$session_id" ]]; then
        die "Unable to determine session id. Set CERBERUS_RUN_KEY or CLAUDE_SESSION_ID."
    fi

    # --- Setup review directory ---
    local review_dir
    review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
    mkdir -p "$review_dir"

    # --- Archive existing reviews so previous iteration is visible in prompt ---
    local reviews_dir="$review_dir/reviews"
    local iteration_file="$review_dir/iteration.txt"
    local iter=0
    if [[ -f "$iteration_file" ]]; then
        iter=$(cat "$iteration_file" 2>/dev/null || echo "0")
    fi
    archive_reviews "$review_dir" "$reviews_dir" "$iter" >/dev/null 2>&1 || true

    # --- Previous reviews (for iterative context) ---
    code_review_previous_reviews() {
        local review_dir="$1"
        local latest_archive=""
        local latest_iter=-1
        local latest_dir_name=""

        for archive_dir in "$review_dir"/reviews-iter-*; do
            if [[ -d "$archive_dir" ]]; then
                local dir_name
                dir_name=$(basename "$archive_dir")
                local iter
                iter=$(echo "$dir_name" | sed 's/reviews-iter-\([0-9]*\).*/\1/')
                if [[ "$iter" =~ ^[0-9]+$ ]]; then
                    if [[ "$iter" -gt "$latest_iter" ]] || \
                       [[ "$iter" -eq "$latest_iter" && "$dir_name" > "$latest_dir_name" ]]; then
                        latest_iter="$iter"
                        latest_archive="$archive_dir"
                        latest_dir_name="$dir_name"
                    fi
                fi
            fi
        done

        if [[ -z "$latest_archive" ]]; then
            return 0
        fi

        echo "## Previous Reviews (Iteration $latest_iter)"
        echo ""
        echo "You have access to the reviews from your previous iteration. Use these to understand what issues were raised and ensure they have been addressed."
        echo ""

        for reviewer_file in "$latest_archive"/*.json; do
            if [[ -f "$reviewer_file" ]]; then
                local reviewer_name
                reviewer_name=$(basename "$reviewer_file" .json)

                case "$reviewer_name" in
                    review-schema|review) continue ;;
                esac

                echo "### Previous Review: $reviewer_name"
                echo ""

                local review_json=""
                if review_json=$(extract_last_json_object "$reviewer_file" 2>/dev/null); then
                    review_json=$(unwrap_review_json "$review_json" 2>/dev/null || echo "$review_json")

                    local verdict summary findings
                    verdict=$(echo "$review_json" | jq -r '.verdict // "UNKNOWN"' 2>/dev/null || echo "UNKNOWN")
                    summary=$(echo "$review_json" | jq -r '.summary // ""' 2>/dev/null || echo "")
                    findings=$(echo "$review_json" | jq -r '.findings // [] | .[] | .title // "No title"' 2>/dev/null || echo "")

                    echo "**Verdict:** $verdict"
                    if [[ -n "$summary" && "$summary" != "null" ]]; then
                        echo "**Summary:** $summary"
                    fi
                    if [[ -n "$findings" ]]; then
                        echo "**Findings:**"
                        while IFS= read -r finding; do
                            echo "- $finding"
                        done <<< "$findings"
                    fi
                else
                    echo "(Could not parse review output)"
                fi
                echo ""
            fi
        done
    }

    # Task context from --context-file (issue description, scope, acceptance criteria)
    local task_context=""
    if [[ -n "$context_file" ]]; then
        task_context=$(read_context_file "$context_file")
    fi

    # Author context from stored state (agent's clarifications during review iterations)
    local author_context=""
    author_context=$(resolve_author_context "$review_dir" "")

    local previous_reviews=""
    previous_reviews=$(code_review_previous_reviews "$review_dir")

    # --- Build prompt with diff ---
    # Resolve template with project-local override support
    local project_root
    project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    local prompt_template_path=""
    for path in "$project_root/prompts/reviewers/code.md" "$SCRIPT_DIR/../prompts/reviewers/code.md"; do
        if [[ -f "$path" ]]; then
            prompt_template_path="$path"
            break
        fi
    done

    local prompt_content
    if [[ -n "${commit_net_warning:-}" ]]; then
        task_context="${task_context:-No additional context provided.}"$'\n\n'"$commit_net_warning"
    fi
    if [[ -n "$prompt_template_path" && -f "$prompt_template_path" ]]; then
        # Substitute debate-mode placeholders on the TEMPLATE first (D2
        # line-consume semantics under --debate absent; canonical anchor +
        # strategy bytes injected under --debate set). This MUST happen
        # before the diff/context substitution so that artifact content
        # containing literal `${CONFIDENCE_ANCHORS}` etc. (e.g., a diff that
        # touches these very templates) is not corrupted by the placeholder
        # pass.
        local template_substituted_tmp="${review_dir}/template-substituted.tmp"
        substitute_debate_placeholders "$debate" "${REVIEW_GATE_DEBATE_STRATEGY:-verification-first}" \
            < "$prompt_template_path" > "$template_substituted_tmp"

        # Load substituted template and substitute ${DIFF_CONTENT} and ${CONTEXT} using temp files to avoid ARG_MAX limits
        local diff_tmp="${review_dir}/diff_content.tmp"
        local context_tmp="${review_dir}/context_content.tmp"
        printf '%s' "$diff_content" > "$diff_tmp"
        printf '%s' "${task_context:-No additional context provided.}" > "$context_tmp"
        prompt_content=$(awk -v diff_file="$diff_tmp" -v context_file="$context_tmp" '
            BEGIN {
                while ((getline line < diff_file) > 0) diff = diff (diff ? "\n" : "") line; close(diff_file)
                while ((getline line < context_file) > 0) ctx = ctx (ctx ? "\n" : "") line; close(context_file)
            }
            {
                while (match($0, /\$\{DIFF_CONTENT\}/)) {
                    printf "%s", substr($0, 1, RSTART-1)
                    printf "%s", diff
                    $0 = substr($0, RSTART+RLENGTH)
                }
                while (match($0, /\$\{CONTEXT\}/)) {
                    printf "%s", substr($0, 1, RSTART-1)
                    printf "%s", ctx
                    $0 = substr($0, RSTART+RLENGTH)
                }
                print
            }
        ' "$template_substituted_tmp")
        rm -f "$diff_tmp" "$context_tmp" "$template_substituted_tmp"
    else
        die "Code review prompt template not found in project or built-in locations"
    fi

    # --- Inject previous reviews / author context near the top of the prompt ---
    local review_context=""
    if [[ -n "$author_context" ]]; then
        if [[ -n "$review_context" ]]; then
            review_context+=$'\n'
        fi
        review_context+=$'## Author Context\nUse these clarifications when evaluating the changes and prior feedback.\n\n'"$author_context"
    fi
    if [[ -n "$previous_reviews" ]]; then
        if [[ -n "$review_context" ]]; then
            review_context+=$'\n'
        fi
        review_context+="$previous_reviews"
    fi
    if [[ -n "$focus_area" ]]; then
        if [[ -n "$review_context" ]]; then
            review_context+=$'\n'
        fi
        review_context+=$'## Focus Area\nPay special attention to the following when reviewing:\n\n'"$focus_area"
    fi

    if [[ -n "$review_context" ]]; then
        local context_tmp="${review_dir}/review_context.tmp"
        printf '%s' "$review_context" > "$context_tmp"
        prompt_content=$(awk -v ctx_file="$context_tmp" '
            BEGIN { while ((getline line < ctx_file) > 0) ctx = ctx (ctx ? "\n" : "") line; close(ctx_file); inserted=0 }
            /^## Task Context/ && inserted==0 {
                print ctx
                print ""
                inserted=1
            }
            /^## Output Format/ && inserted==0 {
                print ctx
                print ""
                inserted=1
            }
            { print }
            END { if (inserted==0) { print ""; print ctx } }
        ' <<< "$prompt_content")
        rm -f "$context_tmp"
    fi

    if [[ "${PROMPT_ULTRATHINK:-false}" == "true" ]]; then
        prompt_content=$'ultrathink\n\n'"$prompt_content"
    fi

    # --- Write artifact for review gate ---
    local artifact_path="$review_dir/latest.md"
    {
        echo "<!-- review-type: code -->"
        echo "<!-- diff-args: $diff_args_str -->"
        if [[ -n "$max_rounds" ]]; then
            echo "<!-- max-rounds: $max_rounds -->"
        fi
        if [[ -n "$agents_csv" ]]; then
            echo "<!-- agents: $agents_csv -->"
        fi
        echo "<!-- mode: $mode -->"
        echo ""
        echo "# Code Review (Iterative)"
        echo ""
        echo "## Diff Mode"
        echo "$diff_mode ${diff_target:-}"
        echo ""
        echo "## Changes"
        echo ""
        echo '```diff'
        printf '%s\n' "$diff_content"
        echo '```'
    } > "$artifact_path"

    echo "Artifact written: $artifact_path" >&2

    # --- Exit early if artifact-only mode (for testing) ---
    if [[ "$artifact_only" == "true" ]]; then
        return 0
    fi

    # --- Export diff args for re-spawn on iteration ---
    export REVIEW_GATE_DIFF_ARGS="$diff_args_str"

    # --- Write the prompt file directly (bypass build_prompt to use our template) ---
    local reviews_dir="$review_dir/reviews"
    mkdir -p "$reviews_dir"
    local prompt_file="$reviews_dir/review.prompt"
    echo "$prompt_content" > "$prompt_file"

    # --- Spawn reviewers using existing infrastructure ---
    local -a spawn_cmd=("$0" "spawn")
    if [[ -n "$agents_csv" ]]; then
        spawn_cmd+=(--agents "$agents_csv")
    fi
    if [[ -n "$max_rounds" ]]; then
        spawn_cmd+=(--max-rounds "$max_rounds")
    fi
    if [[ -n "$mode" ]]; then
        spawn_cmd+=(--mode "$mode")
    fi
    # NOTE: Do not pass --context-file to spawn for code.
    # Task context is already injected into the prompt via ${CONTEXT} template variable.
    # Passing it to spawn would duplicate it and mislabel it as Author Context.
    if [[ -n "$consensus_mode" ]]; then
        spawn_cmd+=(--consensus "$consensus_mode")
    fi
    if [[ "$debate" == "true" ]]; then
        spawn_cmd+=(--debate)
    fi
    if [[ -n "$debate_seed" ]]; then
        spawn_cmd+=(--debate-seed "$debate_seed")
    fi
    spawn_cmd+=("$artifact_path")
    # T002: propagate the full neutral-env block to the spawned subprocess
    # in addition to the existing CLAUDE_*/REVIEW_GATE_* cmd-prefix vars.
    # See __cerberus_export_neutral_env_for_subprocess at top of file.
    __cerberus_export_neutral_env_for_subprocess "$session_id" "$transcript_path"
    CLAUDE_SESSION_ID="$session_id" \
    REVIEW_GATE_TRANSCRIPT_PATH="$transcript_path" \
    REVIEW_TYPE="code" \
    REVIEW_GATE_PROMPT_FILE="$prompt_file" \
    "${spawn_cmd[@]}"
}

review_gate_spawn_plan_review() {
    local plan_path=""
    local agents_csv=""
    local max_rounds=""
    local mode=""
    local context_file=""
    local focus_area=""
    local -a positionals=()
    local force_focus="false"
    local consensus_mode=""
    local debate="false"
    local debate_seed=""

    # --- Session metadata ---
    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debate)
                debate="true"
                shift
                ;;
            --debate-seed=*)
                debate_seed="${1#*=}"
                shift
                ;;
            --debate-seed)
                debate_seed="${2:-}"
                shift 2
                ;;
            --agents=*)
                agents_csv="${1#*=}"
                shift
                ;;
            --agents)
                agents_csv="${2:-}"
                shift 2
                ;;
            --max-rounds=*)
                max_rounds="${1#*=}"
                shift
                ;;
            --max-rounds)
                max_rounds="${2:-}"
                shift 2
                ;;
            --mode=*)
                mode="${1#*=}"
                shift
                ;;
            --mode)
                mode="${2:-}"
                shift 2
                ;;
            --context-file=*)
                context_file="${1#*=}"
                shift
                ;;
            --context-file)
                context_file="${2:-}"
                shift 2
                ;;
            --focus=*)
                focus_area="${1#*=}"
                shift
                ;;
            --focus)
                focus_area="${2:-}"
                shift 2
                ;;
            --consensus=*)
                consensus_mode="${1#*=}"
                shift
                ;;
            --consensus)
                consensus_mode="${2:-}"
                shift 2
                ;;
            --session-id)
                session_id="${2:-}"
                shift 2
                ;;
            --transcript-path)
                transcript_path="${2:-}"
                shift 2
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} spawn-plan-review [options] [plan-path]

Spawn reviewers for a plan file. If no plan path is provided, attempts to find
the most recent session plan from ~/.claude/plans/.

Options:
  --agents <list>           Comma-separated subset of agents: codex,gemini,claude
  --max-rounds <n>          Maximum review iterations before manual resolution (0 disables auto-respawn)
  --mode <level>           Intelligence mode: fast, smart, max
  --context-file <path>     Inject author context from file into the prompt
  --focus <text>            Focus area to emphasize in the review
  --consensus <mode>        Consensus mode: majority (default), all, any
  --debate                  Opt in to debate-mode review (requires >=2 available reviewers)
  --session-id <id>        Session ID for scoping
  --transcript-path <path> Path to transcript file
  [--] <focus>             Optional focus text (or trailing text; -- forces focus)

The reviewers will evaluate the plan for:
- Completeness and correctness
- Order of operations and dependencies
- Edge cases and error handling
USAGE
                return 0
                ;;
            --)
                shift
                force_focus="true"
                if [[ $# -gt 0 ]]; then
                    positionals+=("$@")
                fi
                break
                ;;
            -*)
                die "Unknown option '$1'"
                ;;
            *)
                positionals+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${#positionals[@]} -gt 0 ]]; then
        local first_arg="${positionals[0]}"
        # Only treat as plan path if not forcing focus mode
        if [[ "$force_focus" != "true" ]]; then
            # Check for path-like patterns: existing file, explicit prefixes, .md extension, or contains /
            if [[ -f "$first_arg" || "$first_arg" == /* || "$first_arg" == ./* || "$first_arg" == ../* || "$first_arg" == *.md ]]; then
                plan_path="$first_arg"
                positionals=("${positionals[@]:1}")
            elif [[ "$first_arg" == *"/"* ]]; then
                # Looks like a path (contains /) but file doesn't exist - error early
                die "Plan file not found: $first_arg (use -- to force as focus text)"
            fi
        fi

        if [[ ${#positionals[@]} -gt 0 ]]; then
            if [[ -n "$focus_area" ]]; then
                die "Focus provided both via --focus and positional arguments"
            fi
            focus_area="${positionals[*]}"
        fi
    fi

    mode=$(normalize_mode "$mode")
    if [[ -z "$mode" ]]; then
        mode="smart"
    fi
    validate_mode "$mode"
    resolve_intelligence_mode "$mode"

    # Default max_rounds: CLI flag > env var > hardcoded 3
    if [[ -z "$max_rounds" ]]; then
        max_rounds="${REVIEW_GATE_MAX_ROUNDS:-3}"
    fi

    validate_max_rounds "$max_rounds"

    # Default consensus_mode: CLI flag > env var > hardcoded "majority"
    if [[ -z "$consensus_mode" ]]; then
        consensus_mode="${REVIEW_GATE_CONSENSUS:-majority}"
    fi
    validate_consensus_mode "$consensus_mode"

    # Find session plan if not specified
    if [[ -z "$plan_path" ]]; then
        if [[ -d "$HOME/.claude/plans" ]]; then
            plan_path=$(ls -t "$HOME/.claude/plans"/*.md 2>/dev/null | head -1 || true)
        fi
    fi

    if [[ -z "$plan_path" ]]; then
        die "No plan found. Provide a plan path or create a plan first."
    fi

    if [[ ! -f "$plan_path" ]]; then
        die "Plan file not found: $plan_path"
    fi

    plan_path=$(resolve_realpath "$plan_path")

    # Resolve transcript and session ID if not provided
    if [[ -z "$session_id" && -n "$transcript_path" ]]; then
        session_id="$(basename "$transcript_path" .jsonl)"
    fi

    if [[ -z "$session_id" ]]; then
        # T002: host-neutral fallback. resolve_review_dir() delegates run-key
        # resolution to __cerberus_resolve_run_key, so any non-empty value
        # here satisfies its non-empty check. Using the neutral run key as
        # session_id lets Codex/Amp/generic spawns work without
        # CLAUDE_SESSION_ID set.
        session_id="$(__cerberus_resolve_run_key)"
    fi
    if [[ -z "$session_id" ]]; then
        die "Unable to determine session id. Set CERBERUS_RUN_KEY or CLAUDE_SESSION_ID."
    fi

    # --- Setup review directory ---
    local review_dir
    review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
    mkdir -p "$review_dir"

    # --- Read plan content ---
    local plan_content
    plan_content=$(cat "$plan_path")
    local plan_sha
    plan_sha=$(compute_sha256 "$plan_path" 2>/dev/null || echo "")

    # --- Write artifact for review gate ---
    local artifact_path="$review_dir/latest.md"
    {
        echo "<!-- review-type: plan -->"
        echo "<!-- plan-path: $plan_path -->"
        echo "<!-- plan-sha: $plan_sha -->"
        if [[ -n "$max_rounds" ]]; then
            echo "<!-- max-rounds: $max_rounds -->"
        fi
        if [[ -n "$agents_csv" ]]; then
            echo "<!-- agents: $agents_csv -->"
        fi
        echo "<!-- mode: $mode -->"
        echo ""
        echo "# Plan Review (Iterative)"
        echo ""
        echo "## Plan Path"
        echo "$plan_path"
        echo ""
        echo "## Plan Content"
        echo ""
        echo '```markdown'
        cat "$plan_path"
        echo '```'
    } > "$artifact_path"

    echo "Artifact written: $artifact_path" >&2

    # --- Build prompt with plan content ---
    # Resolve template with project-local override support
    local project_root
    project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    local prompt_template_path=""
    for path in "$project_root/prompts/reviewers/plan.md" "$SCRIPT_DIR/../prompts/reviewers/plan.md"; do
        if [[ -f "$path" ]]; then
            prompt_template_path="$path"
            break
        fi
    done

    local prompt_content
    if [[ -n "$prompt_template_path" && -f "$prompt_template_path" ]]; then
        # Substitute debate-mode placeholders on the TEMPLATE first so
        # plan content containing literal `${CONFIDENCE_ANCHORS}` etc.
        # is not corrupted by the placeholder pass. (D2 line-consume
        # under --debate absent; canonical anchor + strategy injection
        # under --debate set.)
        local template_substituted_tmp="${review_dir}/template-substituted.tmp"
        substitute_debate_placeholders "$debate" "${REVIEW_GATE_DEBATE_STRATEGY:-verification-first}" \
            < "$prompt_template_path" > "$template_substituted_tmp"

        # Load substituted template and substitute ${PLAN_CONTENT} using temp file to avoid ARG_MAX limits
        local plan_tmp="${review_dir}/plan_content.tmp"
        printf '%s' "$plan_content" > "$plan_tmp"
        prompt_content=$(awk -v plan_file="$plan_tmp" '
            BEGIN { while ((getline line < plan_file) > 0) plan = plan (plan ? "\n" : "") line; close(plan_file) }
            {
                while (match($0, /\$\{PLAN_CONTENT\}/)) {
                    printf "%s", substr($0, 1, RSTART-1)
                    printf "%s", plan
                    $0 = substr($0, RSTART+RLENGTH)
                }
                print
            }
        ' "$template_substituted_tmp")
        rm -f "$plan_tmp" "$template_substituted_tmp"
    else
        # Fallback: use plan content directly with basic prompt structure
        prompt_content="You are reviewing a plan for quality and correctness.

## Plan
Path: $plan_path

\`\`\`
$plan_content
\`\`\`

## Evaluation Criteria
1. Completeness - Are all necessary steps covered?
2. Order of Operations - Are steps in the correct sequence?
3. Dependencies - Are dependencies properly identified?
4. Edge Cases - Are edge cases and error handling addressed?
5. Actionability - Are next steps clear and concrete?

## Output Format
JSON only, no markdown code fences:
{
  \"findings\": [
    {\"title\": \"[P1] Issue title\", \"body\": \"Why this is a problem\", \"priority\": 1, \"file_path\": null, \"line_start\": null, \"line_end\": null}
  ],
  \"verdict\": \"PASS\" | \"FAIL\" | \"NEEDS_WORK\",
  \"summary\": \"1-2 sentences\"
}

- PASS: No significant findings
- FAIL: Blocking issues (P0/P1)
- NEEDS_WORK: Non-blocking issues (P2/P3)
- file_path, line_start, line_end are optional (use null if not applicable)
"
        # Fallback path uses a synthetic prompt with no placeholders, so the
        # fallback intentionally bypasses substitute_debate_placeholders.
    fi

    # --- Inject focus area before Output Format section if provided ---
    if [[ -n "$focus_area" ]]; then
        local focus_section=$'## Focus Area\nPay special attention to the following when reviewing:\n\n'"$focus_area"
        local focus_tmp="${review_dir}/focus.tmp"
        printf '%s' "$focus_section" > "$focus_tmp"
        prompt_content=$(awk -v focus_file="$focus_tmp" '
            BEGIN { while ((getline line < focus_file) > 0) focus = focus (focus ? "\n" : "") line; close(focus_file); inserted=0 }
            /^## Output Format/ && inserted==0 {
                print focus
                print ""
                inserted=1
            }
            { print }
            END { if (inserted==0 && focus != "") { print ""; print focus } }
        ' <<< "$prompt_content")
        rm -f "$focus_tmp"
    fi

    if [[ "${PROMPT_ULTRATHINK:-false}" == "true" ]]; then
        prompt_content=$'ultrathink\n\n'"$prompt_content"
    fi

    # --- Write the prompt file directly (bypass build_prompt to use our template) ---
    local reviews_dir="$review_dir/reviews"
    mkdir -p "$reviews_dir"
    local prompt_file="$reviews_dir/review.prompt"
    echo "$prompt_content" > "$prompt_file"

    # --- Spawn reviewers using existing infrastructure ---
    local -a spawn_cmd=("$0" "spawn" "--type=plan")
    if [[ -n "$agents_csv" ]]; then
        spawn_cmd+=(--agents "$agents_csv")
    fi
    if [[ -n "$max_rounds" ]]; then
        spawn_cmd+=(--max-rounds "$max_rounds")
    fi
    if [[ -n "$mode" ]]; then
        spawn_cmd+=(--mode "$mode")
    fi
    if [[ -n "$context_file" ]]; then
        spawn_cmd+=(--context-file "$context_file")
    fi
    if [[ -n "$consensus_mode" ]]; then
        spawn_cmd+=(--consensus "$consensus_mode")
    fi
    if [[ "$debate" == "true" ]]; then
        spawn_cmd+=(--debate)
    fi
    if [[ -n "$debate_seed" ]]; then
        spawn_cmd+=(--debate-seed "$debate_seed")
    fi
    spawn_cmd+=("$artifact_path")
    # Export REVIEW_GATE_DEBATE_PLAN_PATH so the bare-spawn debate
    # preflight uses the canonical user-passed plan path (already
    # realpath'd above) for spec R3 stability rather than the session-
    # scoped latest.md artifact path.
    # T002: also propagate the full neutral-env block to the spawned
    # subprocess via __cerberus_export_neutral_env_for_subprocess.
    __cerberus_export_neutral_env_for_subprocess "$session_id" "$transcript_path"
    CLAUDE_SESSION_ID="$session_id" \
    REVIEW_GATE_TRANSCRIPT_PATH="$transcript_path" \
    REVIEW_TYPE="plan" \
    REVIEW_GATE_PROMPT_FILE="$prompt_file" \
    REVIEW_GATE_DEBATE_PLAN_PATH="$plan_path" \
    "${spawn_cmd[@]}"

    # Update state to include plan path in mode
    local state_file="$review_dir/gate-state.json"
    if [[ -f "$state_file" ]]; then
        local temp_file="${state_file}.tmp.$$"
        jq --arg plan_path "$plan_path" \
           --arg plan_sha "$plan_sha" \
           '.mode.plan_path = $plan_path
            | .mode.type = "plan"
            | .artifact.plan_sha = $plan_sha' \
           "$state_file" > "$temp_file"
        mv "$temp_file" "$state_file"
    fi

    echo "Plan review spawned for: $plan_path" >&2
    echo "" >&2
    echo "STOP now. The stop hook will wait for reviewers and present findings." >&2
}

review_gate_spawn_spec_review() {
    local spec_path=""
    local agents_csv=""
    local max_rounds=""
    local mode=""
    local context_file=""
    local consensus_mode=""
    local debate="false"
    local debate_seed=""

    # --- Session metadata ---
    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debate)
                debate="true"
                shift
                ;;
            --debate-seed=*)
                debate_seed="${1#*=}"
                shift
                ;;
            --debate-seed)
                debate_seed="${2:-}"
                shift 2
                ;;
            --agents=*)
                agents_csv="${1#*=}"
                shift
                ;;
            --agents)
                agents_csv="${2:-}"
                shift 2
                ;;
            --max-rounds=*)
                max_rounds="${1#*=}"
                shift
                ;;
            --max-rounds)
                max_rounds="${2:-}"
                shift 2
                ;;
            --mode=*)
                mode="${1#*=}"
                shift
                ;;
            --mode)
                mode="${2:-}"
                shift 2
                ;;
            --context-file=*)
                context_file="${1#*=}"
                shift
                ;;
            --context-file)
                context_file="${2:-}"
                shift 2
                ;;
            --consensus=*)
                consensus_mode="${1#*=}"
                shift
                ;;
            --consensus)
                consensus_mode="${2:-}"
                shift 2
                ;;
            --session-id)
                session_id="${2:-}"
                shift 2
                ;;
            --transcript-path)
                transcript_path="${2:-}"
                shift 2
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} spawn-spec-review [options] <spec-path>

Spawn reviewers for a feature specification file.

Options:
  --agents <list>           Comma-separated subset of agents: codex,gemini,claude
  --max-rounds <n>          Maximum review iterations before manual resolution (0 disables auto-respawn)
  --mode <level>           Intelligence mode: fast, smart, max
  --context-file <path>     Inject author context from file into the prompt
  --consensus <mode>        Consensus mode: majority (default), all, any
  --debate                  Opt in to debate-mode review (requires >=2 available reviewers)
  --session-id <id>        Session ID for scoping
  --transcript-path <path> Path to transcript file

The reviewers will evaluate the spec for:
- Clarity of goals and scope definition
- Technical feasibility and completeness
- Edge case coverage and testability
- Actionability for implementation
USAGE
                return 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                die "Unknown option '$1'"
                ;;
            *)
                spec_path="$1"
                shift
                break
                ;;
        esac
    done

    mode=$(normalize_mode "$mode")
    if [[ -z "$mode" ]]; then
        mode="smart"
    fi
    validate_mode "$mode"
    resolve_intelligence_mode "$mode"

    # Default max_rounds: CLI flag > env var > hardcoded 3
    if [[ -z "$max_rounds" ]]; then
        max_rounds="${REVIEW_GATE_MAX_ROUNDS:-3}"
    fi

    validate_max_rounds "$max_rounds"

    # Default consensus_mode: CLI flag > env var > hardcoded "majority"
    if [[ -z "$consensus_mode" ]]; then
        consensus_mode="${REVIEW_GATE_CONSENSUS:-majority}"
    fi
    validate_consensus_mode "$consensus_mode"

    if [[ -z "$spec_path" ]]; then
        die "Spec path is required. Usage: ${CLI_CMD} spawn-spec-review <spec-path>"
    fi

    if [[ ! -f "$spec_path" ]]; then
        die "Spec file not found: $spec_path"
    fi

    spec_path=$(resolve_realpath "$spec_path")

    # Resolve transcript and session ID if not provided
    if [[ -z "$session_id" && -n "$transcript_path" ]]; then
        session_id="$(basename "$transcript_path" .jsonl)"
    fi

    if [[ -z "$session_id" ]]; then
        # T002: host-neutral fallback. resolve_review_dir() delegates run-key
        # resolution to __cerberus_resolve_run_key, so any non-empty value
        # here satisfies its non-empty check. Using the neutral run key as
        # session_id lets Codex/Amp/generic spawns work without
        # CLAUDE_SESSION_ID set.
        session_id="$(__cerberus_resolve_run_key)"
    fi
    if [[ -z "$session_id" ]]; then
        die "Unable to determine session id. Set CERBERUS_RUN_KEY or CLAUDE_SESSION_ID."
    fi

    # --- Setup review directory ---
    local review_dir
    review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
    mkdir -p "$review_dir"

    # --- Read spec content ---
    local spec_content
    spec_content=$(cat "$spec_path")
    local spec_sha
    spec_sha=$(compute_sha256 "$spec_path" 2>/dev/null || echo "")

    # --- Write artifact for review gate ---
    local artifact_path="$review_dir/latest.md"
    {
        echo "<!-- review-type: spec -->"
        echo "<!-- spec-path: $spec_path -->"
        echo "<!-- spec-sha: $spec_sha -->"
        if [[ -n "$max_rounds" ]]; then
            echo "<!-- max-rounds: $max_rounds -->"
        fi
        if [[ -n "$agents_csv" ]]; then
            echo "<!-- agents: $agents_csv -->"
        fi
        echo "<!-- mode: $mode -->"
        echo ""
        echo "# Spec Review (Iterative)"
        echo ""
        echo "## Spec Path"
        echo "$spec_path"
        echo ""
        echo "## Spec Content"
        echo ""
        echo "<spec-content>"
        cat "$spec_path"
        echo "</spec-content>"
    } > "$artifact_path"

    echo "Artifact written: $artifact_path" >&2

    # --- Build prompt with spec content ---
    # Resolve template with project-local override support
    local project_root
    project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    local prompt_template_path=""
    for path in "$project_root/prompts/reviewers/spec.md" "$SCRIPT_DIR/../prompts/reviewers/spec.md"; do
        if [[ -f "$path" ]]; then
            prompt_template_path="$path"
            break
        fi
    done

    local prompt_content
    if [[ -n "$prompt_template_path" && -f "$prompt_template_path" ]]; then
        # Substitute debate-mode placeholders on the TEMPLATE first so spec
        # content containing literal `${CONFIDENCE_ANCHORS}` etc. is not
        # corrupted by the placeholder pass. (D2 line-consume under
        # --debate absent; canonical anchor + strategy injection under
        # --debate set.)
        local template_substituted_tmp="${review_dir}/template-substituted.tmp"
        substitute_debate_placeholders "$debate" "${REVIEW_GATE_DEBATE_STRATEGY:-verification-first}" \
            < "$prompt_template_path" > "$template_substituted_tmp"

        # Load substituted template and substitute ${SPEC_CONTENT} using temp file to avoid ARG_MAX limits
        local spec_tmp="${review_dir}/spec_content.tmp"
        printf '%s' "$spec_content" > "$spec_tmp"
        prompt_content=$(awk -v spec_file="$spec_tmp" '
            BEGIN { while ((getline line < spec_file) > 0) spec = spec (spec ? "\n" : "") line; close(spec_file) }
            {
                while (match($0, /\$\{SPEC_CONTENT\}/)) {
                    printf "%s", substr($0, 1, RSTART-1)
                    printf "%s", spec
                    $0 = substr($0, RSTART+RLENGTH)
                }
                print
            }
        ' "$template_substituted_tmp")
        rm -f "$spec_tmp" "$template_substituted_tmp"
    else
        # Fallback: use spec content directly with basic prompt structure
        prompt_content="You are reviewing a feature specification for quality and correctness.

## Spec
Path: $spec_path

\`\`\`
$spec_content
\`\`\`

## Evaluation Criteria
1. Clarity - Are goals and scope clearly defined?
2. Completeness - Are all necessary requirements covered?
3. Technical Feasibility - Is the spec technically sound?
4. Edge Cases - Are edge cases and error handling addressed?
5. Testability - Can the requirements be verified?
6. Actionability - Is it clear how to implement this?

## Output Format
JSON only, no markdown code fences:
{
  \"findings\": [
    {\"title\": \"[P1] Issue title\", \"body\": \"Why this is a problem\", \"priority\": 1, \"file_path\": null, \"line_start\": null, \"line_end\": null}
  ],
  \"verdict\": \"PASS\" | \"FAIL\" | \"NEEDS_WORK\",
  \"summary\": \"1-2 sentences\"
}

- PASS: No significant findings
- FAIL: Blocking issues (P0/P1)
- NEEDS_WORK: Non-blocking issues (P2/P3)
- file_path, line_start, line_end are optional (use null if not applicable)"
        # Fallback path uses a synthetic prompt with no placeholders, so the
        # fallback intentionally bypasses substitute_debate_placeholders.
    fi

    if [[ "${PROMPT_ULTRATHINK:-false}" == "true" ]]; then
        prompt_content=$'ultrathink\n\n'"$prompt_content"
    fi

    # --- Write the prompt file directly (bypass build_prompt to use our template) ---
    local reviews_dir="$review_dir/reviews"
    mkdir -p "$reviews_dir"
    local prompt_file="$reviews_dir/review.prompt"
    echo "$prompt_content" > "$prompt_file"

    # --- Spawn reviewers using existing infrastructure ---
    local -a spawn_cmd=("$0" "spawn" "--type=spec")
    if [[ -n "$agents_csv" ]]; then
        spawn_cmd+=(--agents "$agents_csv")
    fi
    if [[ -n "$max_rounds" ]]; then
        spawn_cmd+=(--max-rounds "$max_rounds")
    fi
    if [[ -n "$mode" ]]; then
        spawn_cmd+=(--mode "$mode")
    fi
    if [[ -n "$context_file" ]]; then
        spawn_cmd+=(--context-file "$context_file")
    fi
    if [[ -n "$consensus_mode" ]]; then
        spawn_cmd+=(--consensus "$consensus_mode")
    fi
    if [[ "$debate" == "true" ]]; then
        spawn_cmd+=(--debate)
    fi
    if [[ -n "$debate_seed" ]]; then
        spawn_cmd+=(--debate-seed "$debate_seed")
    fi
    spawn_cmd+=("$artifact_path")
    # Export REVIEW_GATE_DEBATE_SPEC_PATH so the bare-spawn debate
    # preflight uses the canonical user-passed spec path (already
    # realpath'd above) for spec R3 stability rather than the session-
    # scoped latest.md artifact path.
    # T002: also propagate the full neutral-env block to the spawned
    # subprocess via __cerberus_export_neutral_env_for_subprocess.
    __cerberus_export_neutral_env_for_subprocess "$session_id" "$transcript_path"
    CLAUDE_SESSION_ID="$session_id" \
    REVIEW_GATE_TRANSCRIPT_PATH="$transcript_path" \
    REVIEW_TYPE="spec" \
    REVIEW_GATE_PROMPT_FILE="$prompt_file" \
    REVIEW_GATE_DEBATE_SPEC_PATH="$spec_path" \
    "${spawn_cmd[@]}"

    # Update state to include spec path in mode
    local state_file="$review_dir/gate-state.json"
    if [[ -f "$state_file" ]]; then
        local temp_file="${state_file}.tmp.$$"
        jq --arg spec_path "$spec_path" \
           --arg spec_sha "$spec_sha" \
           '.mode.spec_path = $spec_path
            | .mode.type = "spec"
            | .artifact.spec_sha = $spec_sha' \
           "$state_file" > "$temp_file"
        mv "$temp_file" "$state_file"
    fi

    echo "Spec review spawned for: $spec_path" >&2
    echo "" >&2
    echo "STOP now. The stop hook will wait for reviewers and present findings." >&2
}

review_gate_spawn_epic_verify() {
    local epic_path=""
    local agents_csv=""
    local max_rounds=""
    local mode=""
    local consensus_mode=""
    local debate="false"
    local debate_seed=""

    # --- Session metadata ---
    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debate)
                debate="true"
                shift
                ;;
            --debate-seed=*)
                debate_seed="${1#*=}"
                shift
                ;;
            --debate-seed)
                debate_seed="${2:-}"
                shift 2
                ;;
            --agents=*)
                agents_csv="${1#*=}"
                shift
                ;;
            --agents)
                agents_csv="${2:-}"
                shift 2
                ;;
            --max-rounds=*)
                max_rounds="${1#*=}"
                shift
                ;;
            --max-rounds)
                max_rounds="${2:-}"
                shift 2
                ;;
            --mode=*)
                mode="${1#*=}"
                shift
                ;;
            --mode)
                mode="${2:-}"
                shift 2
                ;;
            --consensus=*)
                consensus_mode="${1#*=}"
                shift
                ;;
            --consensus)
                consensus_mode="${2:-}"
                shift 2
                ;;
            --session-id)
                session_id="${2:-}"
                shift 2
                ;;
            --transcript-path)
                transcript_path="${2:-}"
                shift 2
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} spawn-epic-verify [options] <epic-file>

Spawn reviewers to verify epic acceptance criteria against the codebase.
Reviewers use their tools to explore the code and verify criteria are met.

Options:
  --agents <list>           Comma-separated subset of agents: codex,gemini,claude
  --max-rounds <n>          Maximum verification iterations (0 disables auto-respawn)
  --mode <level>            Intelligence mode: fast, smart, max
  --consensus <mode>        Consensus mode: majority (default), all, any
  --debate                  Opt in to debate-mode review (requires >=2 available reviewers)
  --session-id <id>         Session ID for scoping
  --transcript-path <path>  Path to transcript file

The reviewers will verify each acceptance criterion against the code:
- Implementation exists and is traceable
- Correctness matches specification
- All aspects of criterion are addressed
USAGE
                return 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                die "Unknown option '$1'"
                ;;
            *)
                if [[ -z "$epic_path" ]]; then
                    epic_path="$1"
                    shift
                else
                    echo "Warning: ignoring unknown argument '$1'" >&2
                    shift
                fi
                ;;
        esac
    done

    mode=$(normalize_mode "$mode")
    if [[ -z "$mode" ]]; then
        mode="smart"
    fi
    validate_mode "$mode"
    resolve_intelligence_mode "$mode"

    # Default max_rounds: CLI flag > env var > hardcoded 3
    if [[ -z "$max_rounds" ]]; then
        max_rounds="${REVIEW_GATE_MAX_ROUNDS:-3}"
    fi
    validate_max_rounds "$max_rounds"

    # Default consensus_mode: CLI flag > env var > hardcoded "majority"
    if [[ -z "$consensus_mode" ]]; then
        consensus_mode="${REVIEW_GATE_CONSENSUS:-majority}"
    fi
    validate_consensus_mode "$consensus_mode"

    if [[ -z "$epic_path" ]]; then
        die "Epic file or criteria is required. Usage: ${CLI_CMD} spawn-epic-verify <epic-file-or-criteria>"
    fi

    # Resolve transcript and session ID if not provided
    if [[ -z "$session_id" && -n "$transcript_path" ]]; then
        session_id="$(basename "$transcript_path" .jsonl)"
    fi

    if [[ -z "$session_id" ]]; then
        # T002: host-neutral fallback. resolve_review_dir() delegates run-key
        # resolution to __cerberus_resolve_run_key, so any non-empty value
        # here satisfies its non-empty check. Using the neutral run key as
        # session_id lets Codex/Amp/generic spawns work without
        # CLAUDE_SESSION_ID set.
        session_id="$(__cerberus_resolve_run_key)"
    fi
    if [[ -z "$session_id" ]]; then
        die "Unable to determine session id. Set CERBERUS_RUN_KEY or CLAUDE_SESSION_ID."
    fi

    # --- Setup review directory ---
    local review_dir
    review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
    mkdir -p "$review_dir"

    # --- Archive existing reviews for iteration context ---
    local reviews_dir="$review_dir/reviews"
    local iteration_file="$review_dir/iteration.txt"
    local iter=0
    if [[ -f "$iteration_file" ]]; then
        iter=$(cat "$iteration_file" 2>/dev/null || echo "0")
    fi
    archive_reviews "$review_dir" "$reviews_dir" "$iter" >/dev/null 2>&1 || true

    # --- Determine epic context (file path or raw criteria) ---
    local project_root
    project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    
    local epic_context
    local is_file=false
    
    # Check if it's a file (try both as-is and relative to project root)
    if [[ -f "$epic_path" ]]; then
        epic_context=$(resolve_realpath "$epic_path")
        is_file=true
    elif [[ -f "$project_root/$epic_path" ]]; then
        epic_context=$(resolve_realpath "$project_root/$epic_path")
        is_file=true
    elif [[ "$epic_path" == */* ]] || [[ "$epic_path" == *.md ]]; then
        # Looks like a path but doesn't exist - likely a typo
        die "File not found: $epic_path (looks like a path but doesn't exist. Use raw criteria without path-like characters, or fix the path.)"
    else
        # Raw criteria text
        epic_context="$epic_path"
    fi

    # --- Write artifact for review gate ---
    local artifact_path="$review_dir/latest.md"
    {
        echo "<!-- review-type: epic-verify -->"
        echo "<!-- epic-context: ${epic_context:0:100} -->"
        if [[ -n "$max_rounds" ]]; then
            echo "<!-- max-rounds: $max_rounds -->"
        fi
        if [[ -n "$agents_csv" ]]; then
            echo "<!-- agents: $agents_csv -->"
        fi
        echo "<!-- mode: $mode -->"
        echo ""
        echo "# Epic Verification (Iterative)"
        echo ""
        if [[ "$is_file" == "true" ]]; then
            echo "## Epic File"
            echo "Path: $epic_context"
        else
            echo "## Acceptance Criteria"
            echo ""
            echo "$epic_context"
        fi
    } > "$artifact_path"

    echo "Artifact written: $artifact_path" >&2

    # --- Previous reviews (for iterative context) ---
    epic_verify_previous_reviews() {
        local review_dir="$1"
        local latest_archive=""
        local latest_iter=-1
        local latest_dir_name=""

        for archive_dir in "$review_dir"/reviews-iter-*; do
            if [[ -d "$archive_dir" ]]; then
                local dir_name
                dir_name=$(basename "$archive_dir")
                local iter
                iter=$(echo "$dir_name" | sed 's/reviews-iter-\([0-9]*\).*/\1/')
                if [[ "$iter" =~ ^[0-9]+$ ]]; then
                    if [[ "$iter" -gt "$latest_iter" ]] || \
                       [[ "$iter" -eq "$latest_iter" && "$dir_name" > "$latest_dir_name" ]]; then
                        latest_iter="$iter"
                        latest_archive="$archive_dir"
                        latest_dir_name="$dir_name"
                    fi
                fi
            fi
        done

        if [[ -z "$latest_archive" ]]; then
            return 0
        fi

        echo "## Previous Verification (Iteration $latest_iter)"
        echo ""
        echo "These are the findings from the previous verification round. Check whether the issues have been addressed."
        echo ""

        for reviewer_file in "$latest_archive"/*.json; do
            if [[ -f "$reviewer_file" ]]; then
                local reviewer_name
                reviewer_name=$(basename "$reviewer_file" .json)

                case "$reviewer_name" in
                    review-schema|review) continue ;;
                esac

                echo "### Previous: $reviewer_name"
                echo ""

                local review_json=""
                if review_json=$(extract_last_json_object "$reviewer_file" 2>/dev/null); then
                    review_json=$(unwrap_review_json "$review_json" 2>/dev/null || echo "$review_json")

                    local verdict summary findings
                    verdict=$(echo "$review_json" | jq -r '.verdict // "UNKNOWN"' 2>/dev/null || echo "UNKNOWN")
                    summary=$(echo "$review_json" | jq -r '.summary // ""' 2>/dev/null || echo "")
                    findings=$(echo "$review_json" | jq -r '.findings // [] | .[] | .title // "No title"' 2>/dev/null || echo "")

                    echo "**Verdict:** $verdict"
                    if [[ -n "$summary" && "$summary" != "null" ]]; then
                        echo "**Summary:** $summary"
                    fi
                    if [[ -n "$findings" ]]; then
                        echo "**Findings:**"
                        while IFS= read -r finding; do
                            echo "- $finding"
                        done <<< "$findings"
                    fi
                else
                    echo "(Could not parse review output)"
                fi
                echo ""
            fi
        done
    }

    local previous_reviews=""
    previous_reviews=$(epic_verify_previous_reviews "$review_dir")

    # --- Build prompt with epic context ---
    local project_root
    project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    local prompt_template_path=""
    for path in "$project_root/prompts/reviewers/epic-verify.md" "$SCRIPT_DIR/../prompts/reviewers/epic-verify.md"; do
        if [[ -f "$path" ]]; then
            prompt_template_path="$path"
            break
        fi
    done

    local prompt_content
    if [[ -n "$prompt_template_path" && -f "$prompt_template_path" ]]; then
        # Substitute debate-mode placeholders on the TEMPLATE first so epic
        # context containing literal `${CONFIDENCE_ANCHORS}` etc. is not
        # corrupted by the placeholder pass. (D2 line-consume under
        # --debate absent; canonical anchor + strategy injection under
        # --debate set.)
        local template_substituted_tmp="${review_dir}/template-substituted.tmp"
        substitute_debate_placeholders "$debate" "${REVIEW_GATE_DEBATE_STRATEGY:-verification-first}" \
            < "$prompt_template_path" > "$template_substituted_tmp"

        # Load substituted template and substitute epic context (file path or raw criteria)
        # Use match+printf loop to avoid gsub & and \ interpretation issues
        local context_tmp="${review_dir}/epic_context.tmp"
        printf '%s' "$epic_context" > "$context_tmp"
        prompt_content=$(awk -v ctx_file="$context_tmp" '
            BEGIN { while ((getline line < ctx_file) > 0) ctx = ctx (ctx ? "\n" : "") line; close(ctx_file) }
            {
                while (match($0, /\$\{EPIC_CONTEXT\}/)) {
                    printf "%s", substr($0, 1, RSTART-1)
                    printf "%s", ctx
                    $0 = substr($0, RSTART+RLENGTH)
                }
                print
            }
        ' "$template_substituted_tmp")
        rm -f "$context_tmp" "$template_substituted_tmp"
    else
        die "Epic verification prompt template not found in project or built-in locations"
    fi

    # --- Inject previous reviews context before Output Format section ---
    if [[ -n "$previous_reviews" ]]; then
        local prev_tmp="${review_dir}/previous_reviews.tmp"
        printf '%s' "$previous_reviews" > "$prev_tmp"
        prompt_content=$(awk -v prev_file="$prev_tmp" '
            BEGIN { while ((getline line < prev_file) > 0) prev = prev (prev ? "\n" : "") line; close(prev_file); inserted=0 }
            /^## Output Format/ && inserted==0 {
                print prev
                print ""
                inserted=1
            }
            { print }
            END { if (inserted==0 && prev != "") { print ""; print prev } }
        ' <<< "$prompt_content")
        rm -f "$prev_tmp"
    fi

    if [[ "${PROMPT_ULTRATHINK:-false}" == "true" ]]; then
        prompt_content=$'ultrathink\n\n'"$prompt_content"
    fi

    # --- Write the prompt file ---
    mkdir -p "$reviews_dir"
    local prompt_file="$reviews_dir/review.prompt"
    echo "$prompt_content" > "$prompt_file"

    # --- Spawn reviewers using existing infrastructure ---
    local -a spawn_cmd=("$0" "spawn" "--type=epic-verify")
    if [[ -n "$agents_csv" ]]; then
        spawn_cmd+=(--agents "$agents_csv")
    fi
    if [[ -n "$max_rounds" ]]; then
        spawn_cmd+=(--max-rounds "$max_rounds")
    fi
    if [[ -n "$mode" ]]; then
        spawn_cmd+=(--mode "$mode")
    fi
    if [[ -n "$consensus_mode" ]]; then
        spawn_cmd+=(--consensus "$consensus_mode")
    fi
    if [[ "$debate" == "true" ]]; then
        spawn_cmd+=(--debate)
    fi
    if [[ -n "$debate_seed" ]]; then
        spawn_cmd+=(--debate-seed "$debate_seed")
    fi
    spawn_cmd+=("$artifact_path")
    # Export REVIEW_GATE_EPIC_CONTEXT so the bare-spawn debate preflight can
    # compute the canonical artifact_id for spec R3's per-(artifact, reviewer)
    # strategy assignment. Without this, bare-spawn would fall back to the
    # session-scoped `latest.md` artifact_path (which varies across sessions
    # and breaks the stability requirement). The value matches the
    # `<!-- epic-context: ... -->` frontmatter source used in artifact prep.
    # T002: also propagate the full neutral-env block to the spawned
    # subprocess via __cerberus_export_neutral_env_for_subprocess.
    __cerberus_export_neutral_env_for_subprocess "$session_id" "$transcript_path"
    CLAUDE_SESSION_ID="$session_id" \
    REVIEW_GATE_TRANSCRIPT_PATH="$transcript_path" \
    REVIEW_TYPE="epic-verify" \
    REVIEW_GATE_PROMPT_FILE="$prompt_file" \
    REVIEW_GATE_EPIC_CONTEXT="$epic_context" \
    "${spawn_cmd[@]}"

    # Update state to include epic path in mode
    local state_file="$review_dir/gate-state.json"
    if [[ -f "$state_file" ]]; then
        local temp_file="${state_file}.tmp.$$"
        jq --arg epic_path "$epic_path" \
           '.mode.epic_path = $epic_path
            | .mode.type = "epic-verify"' \
           "$state_file" > "$temp_file"
        mv "$temp_file" "$state_file"
    fi

    echo "Epic verification spawned for: $epic_path" >&2
    echo "" >&2
    echo "STOP now. The stop hook will wait for reviewers and present findings." >&2
}

review_gate_spawn_ask() {
    local ask_content=""
    local prompt_file_arg=""
    local agents_csv=""
    local max_rounds=""
    local mode=""
    local context_file=""
    local context_content=""
    local consensus_mode=""
    local debate="false"
    local debate_seed=""
    local artifact_only="false"
    local -a positionals=()

    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --artifact-only)
                artifact_only="true"
                shift
                ;;
            --debate)
                debate="true"
                shift
                ;;
            --debate-seed=*)
                debate_seed="${1#*=}"
                shift
                ;;
            --debate-seed)
                debate_seed="${2:-}"
                shift 2
                ;;
            --agents=*)
                agents_csv="${1#*=}"
                shift
                ;;
            --agents)
                agents_csv="${2:-}"
                shift 2
                ;;
            --max-rounds=*)
                max_rounds="${1#*=}"
                shift
                ;;
            --max-rounds)
                max_rounds="${2:-}"
                shift 2
                ;;
            --mode=*)
                mode="${1#*=}"
                shift
                ;;
            --mode)
                mode="${2:-}"
                shift 2
                ;;
            --context-file=*)
                context_file="${1#*=}"
                shift
                ;;
            --context-file)
                context_file="${2:-}"
                shift 2
                ;;
            --prompt-file=*)
                prompt_file_arg="${1#*=}"
                shift
                ;;
            --prompt-file)
                prompt_file_arg="${2:-}"
                shift 2
                ;;
            --consensus=*)
                consensus_mode="${1#*=}"
                shift
                ;;
            --consensus)
                consensus_mode="${2:-}"
                shift 2
                ;;
            --session-id)
                session_id="${2:-}"
                shift 2
                ;;
            --transcript-path)
                transcript_path="${2:-}"
                shift 2
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} spawn-ask [options] [--] <prompt>

Send an arbitrary prompt to the reviewer panel. Use --debate to run the prompt
through the multi-round debate coordinator.

Options:
  --agents <list>           Comma-separated subset of agents: codex,gemini,claude
  --max-rounds <n>          Maximum review iterations before manual resolution (default: 0 for ask)
  --mode <level>            Intelligence mode: fast, smart, max
  --context-file <path>     Add background context to the prompt
  --prompt-file <path>      Read the prompt body from a file
  --consensus <mode>        Consensus mode: majority (default), all, any
  --debate                  Opt in to debate-mode answering (requires >=2 available reviewers)
  --session-id <id>         Session ID for scoping
  --transcript-path <path>  Path to transcript file
  [--] <prompt>             Prompt text. Use -- before text that starts with '-'.

Examples:
  ${CLI_CMD} spawn-ask --debate "Should we ship this design?"
  ${CLI_CMD} spawn-ask --prompt-file /tmp/question.md --debate
USAGE
                return 0
                ;;
            --)
                shift
                if [[ $# -gt 0 ]]; then
                    positionals+=("$@")
                fi
                break
                ;;
            -*)
                die "Unknown option '$1'"
                ;;
            *)
                positionals+=("$1")
                shift
                ;;
        esac
    done

    if [[ -n "$prompt_file_arg" ]]; then
        if [[ ${#positionals[@]} -gt 0 ]]; then
            die "Prompt provided both via --prompt-file and positional arguments"
        fi
        if [[ ! -f "$prompt_file_arg" ]]; then
            die "Prompt file not found: $prompt_file_arg"
        fi
        ask_content=$(cat "$prompt_file_arg")
    elif [[ ${#positionals[@]} -gt 0 ]]; then
        ask_content="${positionals[*]}"
    fi

    if [[ -z "$ask_content" ]]; then
        die "Ask prompt is required. Provide prompt text or --prompt-file <path>."
    fi

    if [[ -n "$context_file" ]]; then
        context_content=$(read_context_file "$context_file")
    fi

    mode=$(normalize_mode "$mode")
    if [[ -z "$mode" ]]; then
        mode="smart"
    fi
    validate_mode "$mode"
    resolve_intelligence_mode "$mode"

    if [[ -z "$max_rounds" ]]; then
        max_rounds="${REVIEW_GATE_MAX_ROUNDS:-0}"
    fi
    validate_max_rounds "$max_rounds"

    if [[ -z "$consensus_mode" ]]; then
        consensus_mode="${REVIEW_GATE_CONSENSUS:-majority}"
    fi
    validate_consensus_mode "$consensus_mode"

    if [[ -z "$session_id" && -n "$transcript_path" ]]; then
        session_id="$(basename "$transcript_path" .jsonl)"
    fi

    if [[ -z "$session_id" ]]; then
        # T002: host-neutral fallback. resolve_review_dir() delegates run-key
        # resolution to __cerberus_resolve_run_key, so any non-empty value
        # here satisfies its non-empty check. Using the neutral run key as
        # session_id lets Codex/Amp/generic spawns work without
        # CLAUDE_SESSION_ID set.
        session_id="$(__cerberus_resolve_run_key)"
    fi
    if [[ -z "$session_id" ]]; then
        die "Unable to determine session id. Set CERBERUS_RUN_KEY or CLAUDE_SESSION_ID."
    fi

    local review_dir
    review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
    mkdir -p "$review_dir"

    local reviews_dir="$review_dir/reviews"
    local iteration_file="$review_dir/iteration.txt"
    local iter=0
    if [[ -f "$iteration_file" ]]; then
        iter=$(cat "$iteration_file" 2>/dev/null || echo "0")
    fi
    archive_reviews "$review_dir" "$reviews_dir" "$iter" >/dev/null 2>&1 || true

    local artifact_path="$review_dir/latest.md"
    local ask_fence
    ask_fence=$(markdown_fence_for_content "$ask_content")
    {
        echo "<!-- review-type: ask -->"
        if [[ -n "$max_rounds" ]]; then
            echo "<!-- max-rounds: $max_rounds -->"
        fi
        if [[ -n "$agents_csv" ]]; then
            echo "<!-- agents: $agents_csv -->"
        fi
        echo "<!-- mode: $mode -->"
        echo ""
        echo "# Ask"
        echo ""
        echo "## Prompt"
        echo ""
        echo "${ask_fence}text"
        printf '%s\n' "$ask_content"
        echo "$ask_fence"
        if [[ -n "$context_content" ]]; then
            local context_fence
            context_fence=$(markdown_fence_for_content "$context_content")
            echo ""
            echo "## Context"
            echo ""
            echo "${context_fence}text"
            printf '%s\n' "$context_content"
            echo "$context_fence"
        fi
    } > "$artifact_path"

    echo "Artifact written: $artifact_path" >&2

    local project_root
    project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    local prompt_template_path=""
    local path
    for path in "$project_root/prompts/reviewers/ask.md" "$SCRIPT_DIR/../prompts/reviewers/ask.md"; do
        if [[ -f "$path" ]]; then
            prompt_template_path="$path"
            break
        fi
    done

    if [[ -z "$prompt_template_path" ]]; then
        die "Ask prompt template not found in project or built-in locations"
    fi

    local template_substituted_tmp="${review_dir}/template-substituted.tmp"
    substitute_debate_placeholders "$debate" "${REVIEW_GATE_DEBATE_STRATEGY:-verification-first}" \
        < "$prompt_template_path" > "$template_substituted_tmp"

    local ask_tmp="${review_dir}/ask_content.tmp"
    local context_tmp="${review_dir}/ask_context.tmp"
    printf '%s' "$ask_content" > "$ask_tmp"
    printf '%s' "${context_content:-No additional context provided.}" > "$context_tmp"

    local prompt_content
    prompt_content=$(awk -v ask_file="$ask_tmp" -v context_file="$context_tmp" '
        BEGIN {
            while ((getline line < ask_file) > 0) ask = ask (ask ? "\n" : "") line; close(ask_file)
            while ((getline line < context_file) > 0) ctx = ctx (ctx ? "\n" : "") line; close(context_file)
        }
        {
            while (match($0, /\$\{ASK_CONTENT\}/)) {
                printf "%s", substr($0, 1, RSTART-1)
                printf "%s", ask
                $0 = substr($0, RSTART+RLENGTH)
            }
            while (match($0, /\$\{CONTEXT\}/)) {
                printf "%s", substr($0, 1, RSTART-1)
                printf "%s", ctx
                $0 = substr($0, RSTART+RLENGTH)
            }
            print
        }
    ' "$template_substituted_tmp")
    rm -f "$ask_tmp" "$context_tmp" "$template_substituted_tmp"

    if [[ "${PROMPT_ULTRATHINK:-false}" == "true" ]]; then
        prompt_content=$'ultrathink\n\n'"$prompt_content"
    fi

    mkdir -p "$reviews_dir"
    local prompt_file="$reviews_dir/review.prompt"
    echo "$prompt_content" > "$prompt_file"

    if [[ "$artifact_only" == "true" ]]; then
        return 0
    fi

    local -a spawn_cmd=("$0" "spawn" "--type=ask")
    if [[ -n "$agents_csv" ]]; then
        spawn_cmd+=(--agents "$agents_csv")
    fi
    if [[ -n "$max_rounds" ]]; then
        spawn_cmd+=(--max-rounds "$max_rounds")
    fi
    if [[ -n "$mode" ]]; then
        spawn_cmd+=(--mode "$mode")
    fi
    if [[ -n "$consensus_mode" ]]; then
        spawn_cmd+=(--consensus "$consensus_mode")
    fi
    if [[ "$debate" == "true" ]]; then
        spawn_cmd+=(--debate)
    fi
    if [[ -n "$debate_seed" ]]; then
        spawn_cmd+=(--debate-seed "$debate_seed")
    fi
    spawn_cmd+=("$artifact_path")

    # T002: propagate the full neutral-env block to the spawned subprocess
    # in addition to the existing CLAUDE_*/REVIEW_GATE_* cmd-prefix vars.
    # See __cerberus_export_neutral_env_for_subprocess at top of file.
    __cerberus_export_neutral_env_for_subprocess "$session_id" "$transcript_path"
    CLAUDE_SESSION_ID="$session_id" \
    REVIEW_GATE_TRANSCRIPT_PATH="$transcript_path" \
    REVIEW_TYPE="ask" \
    REVIEW_GATE_PROMPT_FILE="$prompt_file" \
    REVIEW_GATE_ASK_CONTENT="$ask_content" \
    REVIEW_GATE_ASK_CONTEXT="$context_content" \
    "${spawn_cmd[@]}"

    echo "Ask spawned" >&2
}

review_gate_artifact_path() {
    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"
    local session_id_from_arg="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --session-id)
                session_id="${2:-}"
                session_id_from_arg="true"
                shift 2
                ;;
            --transcript-path)
                transcript_path="${2:-}"
                shift 2
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} artifact-path [--session-id <id>] [--transcript-path <path>]
USAGE
                return 0
                ;;
            *)
                die "Unknown option '$1'"
                ;;
        esac
    done

    if [[ -z "$session_id" ]]; then
        # T002: host-neutral fallback. See spawn-* sites above.
        session_id="$(__cerberus_resolve_run_key)"
    fi
    if [[ -z "$session_id" ]]; then
        die "Unable to determine session id. Set CERBERUS_RUN_KEY or CLAUDE_SESSION_ID (via SessionStart hook), or pass --session-id."
    fi

    local review_dir
    # When the caller explicitly passed --session-id, that value MUST take
    # precedence over any ambient CERBERUS_RUN_KEY / REVIEW_GATE_SESSION_KEY.
    # resolve_review_dir() routes through __cerberus_resolve_run_key() which
    # gives the env aliases precedence over the positional session_id, so
    # without unsetting them an explicit --session-id lookup from a Codex/Amp
    # shell with an exported run key would silently read the ambient run.
    # Scope the unset to the command-substitution subshell so the parent's
    # env is preserved.
    if [[ "$session_id_from_arg" == "true" ]]; then
        review_dir=$(unset CERBERUS_RUN_KEY REVIEW_GATE_SESSION_KEY; resolve_review_dir "$session_id" "$transcript_path")
    else
        review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
    fi
    echo "$review_dir/latest.md"
}

review_gate_author_context() {
    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"
    local clear="false"
    local context=""
    local session_id_from_arg="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --session-id)
                session_id="${2:-}"
                session_id_from_arg="true"
                shift 2
                ;;
            --transcript-path)
                transcript_path="${2:-}"
                shift 2
                ;;
            --clear)
                clear="true"
                shift
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} author-context [options] [text]

Set or clear author context injected into reviewer prompts.

Options:
  --session-id <id>        Session ID for scoping
  --transcript-path <path> Path to transcript file
  --clear                 Remove any stored author context
USAGE
                return 0
                ;;
            --)
                shift
                break
                ;;
            *)
                context="$1"
                shift
                if [[ $# -gt 0 ]]; then
                    context="$context $*"
                    break
                fi
                ;;
        esac
    done

    if [[ -z "$session_id" && -n "$transcript_path" ]]; then
        session_id="$(basename "$transcript_path" .jsonl)"
    fi

    if [[ -z "$session_id" ]]; then
        # T002: host-neutral fallback. resolve_review_dir() delegates run-key
        # resolution to __cerberus_resolve_run_key, so any non-empty value
        # here satisfies its non-empty check. Using the neutral run key as
        # session_id lets Codex/Amp/generic spawns work without
        # CLAUDE_SESSION_ID set.
        session_id="$(__cerberus_resolve_run_key)"
    fi
    if [[ -z "$session_id" ]]; then
        die "Unable to determine session id. Set CERBERUS_RUN_KEY or CLAUDE_SESSION_ID."
    fi

    if [[ "$clear" == "false" && -z "$context" ]]; then
        if [[ ! -t 0 ]]; then
            context=$(cat)
        fi
    fi

    local review_dir
    local state_file

    # First try resolving with transcript path.
    #
    # When the caller explicitly passed --session-id, that value MUST take
    # precedence over any ambient CERBERUS_RUN_KEY / REVIEW_GATE_SESSION_KEY.
    # resolve_review_dir() routes through __cerberus_resolve_run_key() which
    # gives the env aliases precedence over the positional session_id, so
    # without unsetting them an explicit --session-id lookup from a Codex/Amp
    # shell with an exported run key would silently read the ambient run.
    # Scope the unset to the command-substitution subshell so the parent's
    # env is preserved.
    if [[ "$session_id_from_arg" == "true" ]]; then
        review_dir=$(unset CERBERUS_RUN_KEY REVIEW_GATE_SESSION_KEY; resolve_review_dir "$session_id" "$transcript_path")
    else
        review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
    fi
    state_file="$review_dir/gate-state.json"

    # If state doesn't exist and we don't have transcript path, search all projects
    if [[ ! -f "$state_file" && -z "$transcript_path" ]]; then
        local found_state=""
        for candidate in "$HOME/.claude/projects"/*/cerberus/"$session_id"/gate-state.json; do
            if [[ -f "$candidate" ]]; then
                found_state="$candidate"
                break
            fi
        done
        if [[ -n "$found_state" ]]; then
            state_file="$found_state"
            review_dir="$(dirname "$state_file")"
        fi
    fi

    mkdir -p "$review_dir"

    # Create minimal state if not exists (state may have been cleaned between iterations)
    if [[ ! -f "$state_file" ]]; then
        local now
        now=$(date -Iseconds)
        echo "{\"status\": \"pending\", \"created_at\": \"$now\"}" > "$state_file"
    fi

    if ! command -v jq >/dev/null 2>&1; then
        die "jq is required but not installed"
    fi

    local temp_file="${state_file}.tmp.$$"
    # T002: include the alias-warning marker in cleanup so the top-level
    # marker-cleanup EXIT trap (which we clobber here) is not lost.
    trap 'rm -f "${temp_file:-}" "${TMPDIR:-/tmp}/cerberus-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-root-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-session-id-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-transcript-path-alias-warned.$$" 2>/dev/null || true' EXIT

    if [[ "$clear" == "true" ]]; then
        jq 'del(.author_context)' "$state_file" > "$temp_file"
        mv "$temp_file" "$state_file"
        echo "Author context cleared"
        return 0
    fi

    if [[ -z "$context" ]]; then
        die "No author context provided"
    fi

    jq --arg context "$context" '.author_context = $context' "$state_file" > "$temp_file"
    mv "$temp_file" "$state_file"
    echo "Author context updated"
}

review_gate_spawn() {
    # --- Review type (for template selection) ---
    REVIEW_TYPE="${REVIEW_TYPE:-}"

    # --- Session metadata ---
    OWNER_SESSION_KEY="$(__cerberus_resolve_run_key)"
    OWNER_SOURCE="${REVIEW_GATE_SESSION_SOURCE:-}"
    OWNER_SESSION_ID="$(__cerberus_resolve_session_id)"
    OWNER_TRANSCRIPT_PATH="$(__cerberus_resolve_transcript_path)"

    local artifact_arg=""
    local agents_csv=""
    local max_rounds=""
    local mode=""
    local context_file=""
    local consensus_mode=""
    local debate="false"
    local debate_seed=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agents=*)
                agents_csv="${1#*=}"
                shift
                ;;
            --agents)
                agents_csv="${2:-}"
                shift 2
                ;;
            --max-rounds=*)
                max_rounds="${1#*=}"
                shift
                ;;
            --max-rounds)
                max_rounds="${2:-}"
                shift 2
                ;;
            --mode=*)
                mode="${1#*=}"
                shift
                ;;
            --mode)
                mode="${2:-}"
                shift 2
                ;;
            --context-file=*)
                context_file="${1#*=}"
                shift
                ;;
            --context-file)
                context_file="${2:-}"
                shift 2
                ;;
            --consensus=*)
                consensus_mode="${1#*=}"
                shift
                ;;
            --consensus)
                consensus_mode="${2:-}"
                shift 2
                ;;
            --type=*)
                REVIEW_TYPE="${1#*=}"
                shift
                ;;
            --type)
                REVIEW_TYPE="${2:-}"
                shift 2
                ;;
            --debate)
                debate="true"
                shift
                ;;
            --debate-seed=*)
                debate_seed="${1#*=}"
                shift
                ;;
            --debate-seed)
                debate_seed="${2:-}"
                shift 2
                ;;
            --session-id)
                OWNER_SESSION_ID="${2:-}"
                shift 2
                ;;
            --transcript-path)
                OWNER_TRANSCRIPT_PATH="${2:-}"
                shift 2
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} spawn [--agents <list>] [--max-rounds <n>] [--mode <fast|smart|max>] [--consensus <majority|all|any>] [--context-file <path>] [--debate] [--session-id <id>] [--transcript-path <path>] [artifact-path]

Options:
  --debate              Opt in to debate-mode review/answering (supported types:
                        code, plan, spec, epic-verify, ask; requires >=2 reviewers).
USAGE
                return 0
                ;;
            --)
                shift
                break
                ;;
            *)
                artifact_arg="$1"
                shift
                break
                ;;
        esac
    done

    # Validate --debate-seed value (integer; no-op when --debate absent).
    if [[ -n "$debate_seed" ]]; then
        if ! [[ "$debate_seed" =~ ^[0-9]+$ ]]; then
            die "--debate-seed must be a non-negative integer; got: $debate_seed"
        fi
    fi

    mode=$(normalize_mode "$mode")
    if [[ -z "$mode" ]]; then
        mode="smart"
    fi
    validate_mode "$mode"
    resolve_intelligence_mode "$mode"

    # Default max_rounds: CLI flag > env var > hardcoded 3
    if [[ -z "$max_rounds" ]]; then
        max_rounds="${REVIEW_GATE_MAX_ROUNDS:-3}"
    fi

    validate_max_rounds "$max_rounds"

    # Default consensus_mode: CLI flag > env var > hardcoded "majority"
    if [[ -z "$consensus_mode" ]]; then
        consensus_mode="${REVIEW_GATE_CONSENSUS:-majority}"
    fi
    validate_consensus_mode "$consensus_mode"

    if [[ -z "$OWNER_SESSION_ID" && -n "$OWNER_TRANSCRIPT_PATH" ]]; then
        OWNER_SESSION_ID="$(basename "$OWNER_TRANSCRIPT_PATH" .jsonl)"
    fi

    if [[ -z "$OWNER_SESSION_ID" ]]; then
        # T002: host-neutral fallback. resolve_review_dir() delegates run-key
        # resolution to __cerberus_resolve_run_key, so any non-empty value
        # here satisfies its non-empty check. This lets non-Claude callers
        # invoke `bin/review-gate spawn` directly with only CERBERUS_RUN_KEY.
        OWNER_SESSION_ID="$(__cerberus_resolve_run_key)"
    fi

    if [[ -z "$OWNER_SESSION_ID" ]]; then
        die "Session id is required. Set CERBERUS_RUN_KEY or CLAUDE_SESSION_ID, or pass --session-id."
    fi

    # T002: propagate the full neutral-env block to the reviewer-agent
    # subprocesses spawned downstream. The five spawn-* wrappers also call
    # this helper, but `bin/review-gate spawn` can be invoked directly by
    # non-Claude adapters (Codex stop hook, Amp shell helper, generic CLI),
    # so the propagation must happen here as well.
    __cerberus_export_neutral_env_for_subprocess "$OWNER_SESSION_ID" "$OWNER_TRANSCRIPT_PATH"

    # Session-scoped path resolution.
    # T004: surface resolver validation failures (invalid CERBERUS_HOST, non-
    # absolute CERBERUS_STATE_ROOT, path-traversal in run/project key) as a
    # clean non-zero exit BEFORE any mkdir or state-creation side effect. The
    # resolver already prints a diagnostic to stderr; we just need to stop.
    REVIEW_DIR=$(resolve_review_dir "$OWNER_SESSION_ID" "$OWNER_TRANSCRIPT_PATH") || \
        die "Failed to resolve review state directory (check CERBERUS_HOST, CERBERUS_STATE_ROOT, CERBERUS_PROJECT_KEY, and run-key)"
    if [[ -z "$REVIEW_DIR" ]]; then
        die "resolve_review_dir returned empty path"
    fi
    STATE_FILE="$REVIEW_DIR/gate-state.json"
    REVIEWS_DIR="$REVIEW_DIR/reviews"
    ITERATION_FILE="$REVIEW_DIR/iteration.txt"

    # T004: capture host + project_key for gate-state.json metadata. Prefer
    # explicit CERBERUS_* env, fall back to deriving from REVIEW_DIR layout
    # (Claude legacy path includes a "/cerberus/" infix; neutral hosts do
    # not). These values populate the new top-level `host` field plus the
    # owner block per plan §Data Model (L455-L466).
    OWNER_HOST="${CERBERUS_HOST:-}"
    if [[ -z "$OWNER_HOST" ]]; then
        case "$REVIEW_DIR" in
            */.claude/projects/*) OWNER_HOST="claude" ;;
            *) OWNER_HOST="generic" ;;
        esac
    fi
    OWNER_PROJECT_KEY="${CERBERUS_PROJECT_KEY:-}"
    if [[ -z "$OWNER_PROJECT_KEY" ]]; then
        local _t004_parent _t004_parent_name
        _t004_parent=$(dirname "$REVIEW_DIR")
        _t004_parent_name=$(basename "$_t004_parent")
        if [[ "$_t004_parent_name" == "cerberus" ]]; then
            OWNER_PROJECT_KEY=$(basename "$(dirname "$_t004_parent")")
        else
            OWNER_PROJECT_KEY="$_t004_parent_name"
        fi
    fi

    # --- Preflight checks ---
    preflight_check() {
        local missing=()
        # Required: jq
        if ! command -v jq >/dev/null; then
            missing+=("jq")
        fi

        if [[ ${#missing[@]} -gt 0 ]]; then
            echo "Missing required commands: ${missing[*]}" >&2
            exit 2
        fi

        # Optional: agents (warn if missing, but continue)
        for cmd in "${agents_list[@]}"; do
            if ! command -v "$cmd" >/dev/null; then
                echo "Warning: $cmd not found, will skip this reviewer" >&2
            fi
        done
    }

    # --- Determine artifact path ---
    resolve_artifact() {
        local arg="${1:-}"

        if [[ -n "$arg" && -f "$arg" ]]; then
            resolve_realpath "$arg"
        elif [[ -f "$REVIEW_DIR/latest.md" ]]; then
            resolve_realpath "$REVIEW_DIR/latest.md"
        else
            echo "No artifact found. Provide path as argument." >&2
            exit 2
        fi
    }

    # --- Check for active gate ---
    check_existing_gate() {
        if [[ "${REVIEW_GATE_RERUN:-}" == "1" ]]; then
            return 0
        fi

        if [[ -f "$STATE_FILE" ]]; then
            local status
            status=$(jq -r '.status // "unknown"' "$STATE_FILE" 2>/dev/null || echo "unknown")

            if [[ "$status" == "pending" || "$status" == "awaiting_decision" ]]; then
                # Check if it's stale (>30 min old)
                local created_at age_seconds
                created_at=$(jq -r '.created_at // ""' "$STATE_FILE" 2>/dev/null || echo "")
                if [[ -n "$created_at" ]]; then
                    local created_epoch now_epoch
                    created_epoch=$(iso8601_to_epoch "$created_at")
                    now_epoch=$(date +%s)
                    age_seconds=$((now_epoch - created_epoch))

                    if [[ $age_seconds -lt 1800 ]]; then
                        echo "Review gate already active (status: $status, age: ${age_seconds}s)" >&2
                        echo "Use ${CLI_CMD} resolve to complete the existing gate first." >&2
                        exit 2
                    fi
                    # Stale, proceed to clean up
                    echo "Cleaning up stale gate (age: ${age_seconds}s)" >&2
                fi
            fi
        fi
    }

    # --- Archive previous reviews ---
    archive_previous_reviews() {
        # Get current iteration (or 0 if not set)
        local iteration
        iteration=$(load_iteration "$REVIEW_DIR")

        # Use shared archive function
        archive_reviews "$REVIEW_DIR" "$REVIEWS_DIR" "$iteration"
    }

    # --- Clean previous state ---
    clean_state() {
        archive_previous_reviews
        rm -f "$STATE_FILE"
        rm -rf "$REVIEWS_DIR"
        mkdir -p "$REVIEWS_DIR"
    }

    # --- Resolve review template ---
    resolve_template() {
        local type="$1"

        # Map iterative review types to their base template names
        case "$type" in
            code) ;;
            plan) ;;
        esac

        local project_root
        project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

        # Search order: project-local, then bundled with script, then user-global fallback
        local search_paths=(
            "$project_root/prompts/reviewers/${type}.md"
            "$SCRIPT_DIR/../prompts/reviewers/${type}.md"
            "$HOME/.claude/review-prompts/${type}.md"
        )

        for path in "${search_paths[@]}"; do
            if [[ -f "$path" ]]; then
                cat "$path"
                return 0
            fi
        done

        # Fallback to generic criteria
        cat <<'DEFAULT'
## Evaluation Criteria
1. Completeness - Are all necessary aspects covered?
2. Accuracy - Are claims grounded in evidence?
3. Actionability - Are next steps clear and concrete?
4. Consistency - Any contradictions?
5. Scope - Appropriately scoped?
DEFAULT
    }

    extract_ask_artifact_section() {
        local path="$1"
        local heading="$2"
        [[ -f "$path" ]] || return 0

        awk -v heading="$heading" '
            function strip_fence_indent(s,    i) {
                i = 0
                while (i < 3 && substr(s, 1, 1) == " ") {
                    s = substr(s, 2)
                    i++
                }
                return s
            }
            $0 == heading { seen=1; next }
            seen && !in_block {
                stripped = strip_fence_indent($0)
                if (stripped !~ /^```/) next
                match(stripped, /^`+/)
                fence = substr(stripped, 1, RLENGTH)
                in_block=1
                next
            }
            seen && in_block && strip_fence_indent($0) == fence { exit }
            seen && in_block { print }
        ' "$path"
    }

    # --- Get previous reviews if available ---
    get_previous_reviews() {
        # Find the most recent archived reviews directory
        local latest_archive=""
        local latest_iter=-1
        local latest_dir_name=""

        for archive_dir in "$REVIEW_DIR"/reviews-iter-*; do
            if [[ -d "$archive_dir" ]]; then
                # Extract iteration number from directory name
                local dir_name
                dir_name=$(basename "$archive_dir")
                local iter
                iter=$(echo "$dir_name" | sed 's/reviews-iter-\([0-9]*\).*/\1/')
                if [[ "$iter" =~ ^[0-9]+$ ]]; then
                    # Compare iteration numbers, break ties with lexicographic comparison
                    # (timestamps like -20231225-123456 sort correctly)
                    if [[ "$iter" -gt "$latest_iter" ]] || \
                       [[ "$iter" -eq "$latest_iter" && "$dir_name" > "$latest_dir_name" ]]; then
                        latest_iter="$iter"
                        latest_archive="$archive_dir"
                        latest_dir_name="$dir_name"
                    fi
                fi
            fi
        done

        if [[ -z "$latest_archive" ]]; then
            return 0
        fi

        echo "## Previous Reviews (Iteration $latest_iter)"
        echo ""
        echo "You have access to the reviews from your previous iteration. Use these to understand what issues were raised and ensure they have been addressed."
        echo ""

        for reviewer_file in "$latest_archive"/*.json; do
            if [[ -f "$reviewer_file" ]]; then
                local reviewer_name
                reviewer_name=$(basename "$reviewer_file" .json)

                # Skip non-review files
                case "$reviewer_name" in
                    review-schema|review) continue ;;
                esac

                echo "### Previous Review: $reviewer_name"
                echo ""

                # Try to extract and format the review using robust JSON extraction
                local review_json=""
                if review_json=$(extract_last_json_object "$reviewer_file" 2>/dev/null); then
                    # Unwrap if needed (handle codex/gemini output formats)
                    review_json=$(unwrap_review_json "$review_json" 2>/dev/null || echo "$review_json")

                    local verdict summary findings
                    verdict=$(echo "$review_json" | jq -r '.verdict // "UNKNOWN"' 2>/dev/null || echo "UNKNOWN")
                    summary=$(echo "$review_json" | jq -r '.summary // ""' 2>/dev/null || echo "")
                    findings=$(echo "$review_json" | jq -r '.findings // [] | .[] | .title // "No title"' 2>/dev/null || echo "")

                    echo "**Verdict:** $verdict"
                    if [[ -n "$summary" && "$summary" != "null" ]]; then
                        echo "**Summary:** $summary"
                    fi
                    if [[ -n "$findings" ]]; then
                        echo "**Findings:**"
                        while IFS= read -r finding; do
                            echo "- $finding"
                        done <<< "$findings"
                    fi
                else
                    echo "(Could not parse review output)"
                fi
                echo ""
            fi
        done
    }

    # --- Build review prompt ---
    build_prompt() {
        local artifact_path="$1"
        local review_type="${2:-}"
        local content
        content=$(cat "$artifact_path")

        # Substitute debate-mode placeholders on the TEMPLATE only,
        # before it is concatenated with the artifact content. This prevents
        # artifact bytes that happen to contain literal `${CONFIDENCE_ANCHORS}`
        # etc. (e.g., a diff that touches these very templates) from being
        # corrupted by the substitution. (D2 line-consume under --debate
        # absent; canonical anchor + strategy injection under --debate set.)
        local criteria
        criteria=$(resolve_template "$review_type" \
            | substitute_debate_placeholders "$debate" "${REVIEW_GATE_DEBATE_STRATEGY:-verification-first}")

        if [[ "$review_type" == "ask" ]]; then
            local ask_source="${REVIEW_GATE_ASK_CONTENT:-}"
            local context_source="${REVIEW_GATE_ASK_CONTEXT:-}"
            if [[ -z "$ask_source" ]]; then
                ask_source=$(extract_ask_artifact_section "$artifact_path" "## Prompt")
            fi
            if [[ -z "$ask_source" ]]; then
                ask_source="$content"
            fi
            if [[ -z "$context_source" ]]; then
                context_source=$(extract_ask_artifact_section "$artifact_path" "## Context")
            fi
            if [[ -z "$context_source" ]]; then
                context_source="No additional context provided."
            fi

            local ask_tmp context_tmp
            ask_tmp=$(mktemp -t review-gate-ask-content.XXXXXX)
            context_tmp=$(mktemp -t review-gate-ask-context.XXXXXX)
            printf '%s' "$ask_source" > "$ask_tmp"
            printf '%s' "$context_source" > "$context_tmp"
            criteria=$(awk -v ask_file="$ask_tmp" -v context_file="$context_tmp" '
                BEGIN {
                    while ((getline line < ask_file) > 0) ask = ask (ask ? "\n" : "") line; close(ask_file)
                    while ((getline line < context_file) > 0) ctx = ctx (ctx ? "\n" : "") line; close(context_file)
                }
                {
                    while (match($0, /\$\{ASK_CONTENT\}/)) {
                        printf "%s", substr($0, 1, RSTART-1)
                        printf "%s", ask
                        $0 = substr($0, RSTART+RLENGTH)
                    }
                    while (match($0, /\$\{CONTEXT\}/)) {
                        printf "%s", substr($0, 1, RSTART-1)
                        printf "%s", ctx
                        $0 = substr($0, RSTART+RLENGTH)
                    }
                    print
                }
            ' <<< "$criteria")
            rm -f "$ask_tmp" "$context_tmp"
        fi

        local previous_reviews
        previous_reviews=$(get_previous_reviews)

        if [[ "${PROMPT_ULTRATHINK:-false}" == "true" ]]; then
            echo "ultrathink"
            echo ""
        fi

        # Use different framing for architecture-review (verification vs evaluation)
        local intro_text
        if [[ "$review_type" == "architecture-review" ]]; then
            intro_text="You are verifying an architecture review artifact. Your task is to check whether the claims in the artifact are accurate by examining the actual codebase. Use tools to read files and search code to verify each finding."
        elif [[ "$review_type" == "ask" ]]; then
            intro_text="You are answering an arbitrary user prompt as part of a multi-model panel."
        else
            intro_text="You are reviewing an artifact for quality and correctness."
        fi

        cat <<PROMPT
$intro_text

## Artifact
Path: $artifact_path

\`\`\`
$content
\`\`\`

$criteria
PROMPT

        # Include previous reviews if available
        if [[ -n "$previous_reviews" ]]; then
            echo ""
            echo "$previous_reviews"
        fi

        # Include author context if available
        if [[ -n "$author_context" ]]; then
            echo ""
            echo "## Author Context"
            echo ""
            echo "Use these clarifications when evaluating the artifact and prior feedback."
            echo ""
            echo "$author_context"
        fi

        cat <<PROMPT

## Output Format
JSON only, no markdown code fences:
{
  "findings": [
    {"title": "[P1] Issue title", "body": "Why this is a problem", "priority": 1, "file_path": null, "line_start": null, "line_end": null}
  ],
  "verdict": "PASS" | "FAIL" | "NEEDS_WORK",
  "summary": "1-2 sentences"
}

- PASS: No significant findings
- FAIL: Blocking issues (P0/P1)
- NEEDS_WORK: Non-blocking issues (P2/P3)
- file_path, line_start, line_end are optional (use null if not applicable)
PROMPT
    }

    # --- Determine trigger source ---
    determine_source() {
        local artifact_path="$1"
        local basename
        basename=$(basename "$artifact_path")

        case "$basename" in
            healthcheck*) echo "healthcheck" ;;
            architecture*) echo "architecture-review" ;;
            breakdown*) echo "create-tasks" ;;
            latest.md) echo "auto" ;;
            *) echo "manual" ;;
        esac
    }

    # --- Parse reviewer subset ---
    local -a agents_list=()
    local agents_raw=""
    if [[ -n "$agents_csv" ]]; then
        agents_raw=$(echo "$agents_csv" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [[ -z "$agents_raw" ]]; then
            die "Agents list cannot be empty"
        fi
        IFS=',' read -r -a agents_list <<< "$agents_raw"
    else
        agents_list=(gemini codex claude)
    fi

    # Validate and dedupe agents list without associative arrays so this works
    # with the Bash 3.2 that ships on macOS.
    local agents_final_csv=""
    local agent
    for agent in "${agents_list[@]}"; do
        if [[ -z "$agent" ]]; then
            die "Invalid agents list (empty entry). Use comma-separated names: codex,gemini,claude"
        fi

        case "$agent" in
            codex|gemini|claude)
                ;;
            *)
                die "Unknown agent '$agent'. Valid: codex, gemini, claude"
                ;;
        esac

        case ",${agents_final_csv}," in
            *,"$agent",*)
                ;;
            *)
                if [[ -n "$agents_final_csv" ]]; then
                    agents_final_csv+=",$agent"
                else
                    agents_final_csv="$agent"
                fi
                ;;
        esac
    done

    if [[ -z "$agents_final_csv" ]]; then
        die "Agents list cannot be empty"
    fi

    IFS=',' read -r -a agents_list <<< "$agents_final_csv"

    # --- Debate preflights (R10 whitelist + <2 reviewers hard error) ---
    # Both run BEFORE preflight_check so that no model is ever invoked when
    # --debate is misused. Per spec R9/R10 these errors are an explicit
    # exception to the byte-parity guarantee for valid invocations.
    if [[ "$debate" == "true" ]]; then
        # R10 whitelist: --debate is restricted to review/ask flows that have
        # debate-aware reviewer templates. Empty / auto-detected types are
        # rejected because debate requires an explicit type to select the right
        # reviewer template.
        case "$REVIEW_TYPE" in
            code|plan|spec|epic-verify|ask)
                ;;
            "")
                {
                    echo "Error: --debate requires an explicit --type (got: <auto-detected>)."
                    echo "       Allowed --type values: code, plan, spec, epic-verify, ask"
                    echo "       Pass --type=<value> or use a spawn-* subcommand."
                } >&2
                exit 2
                ;;
            *)
                {
                    echo "Error: --debate is not supported for --type=$REVIEW_TYPE (rejected at preflight)."
                    echo "       Allowed --type values: code, plan, spec, epic-verify, ask"
                    echo "       --debate is rejected for unsupported types"
                    echo "       (healthcheck, architecture-review, create-tasks, manual, auto, etc.)."
                } >&2
                exit 2
                ;;
        esac

        # <2 reviewers hard error: count agents with available CLIs. If fewer
        # than two are available, hard-error before any model invocation.
        local _debate_available=0
        local _debate_agent
        for _debate_agent in "${agents_list[@]}"; do
            if command -v "$_debate_agent" >/dev/null 2>&1; then
                _debate_available=$((_debate_available + 1))
            fi
        done
        if [[ $_debate_available -lt 2 ]]; then
            {
                echo "Error: --debate requires at least 2 available reviewers; only $_debate_available of ${#agents_list[@]} are available."
                echo "       Reviewers requested: ${agents_list[*]}"
                echo "       Install the missing reviewer CLIs or pass --agents with >=2 available reviewers."
            } >&2
            exit 6
        fi

        # --- Strategy assignment (T005 / spec R3) ---
        # Source the debate coordinator helpers (compute_artifact_id /
        # assign_strategies / _sha256_hex). Sourced only under --debate so
        # the byte-parity guarantee for non-debate runs is preserved (no
        # new env vars, no helper-side effects on the non-debate path).
        #
        # T005 contract (this commit): compute the canonical <artifact_id>,
        # run assign_strategies, and export per-reviewer
        # STRATEGY_DIRECTIVE_PATH_<REVIEWER> + STRATEGY_NAME_<REVIEWER>
        # plus DEBATE_ARTIFACT_ID. The substitution call in build_prompt /
        # spawn-*-review wrappers continues to use the
        # ${REVIEW_GATE_DEBATE_STRATEGY:-verification-first} default for v1
        # of the substitution, since per-reviewer prompt rendering is the
        # synchronous coordinator's job.
        #
        # T006 contract (next task): the synchronous coordinator's spawn
        # loop reads STRATEGY_DIRECTIVE_PATH_<REVIEWER> per-reviewer and
        # renders the prompt per-reviewer (either by setting
        # REVIEW_GATE_DEBATE_STRATEGY before each per-reviewer render or
        # by introducing a marker-and-replace step on the prebuilt prompt).
        # Until T006 lands the per-reviewer rendering is computed-but-not-
        # consumed; the byte-parity tests (test-debate-byte-parity.sh)
        # still assert the verification-first default bytes appear in the
        # prompt and will be updated to per-reviewer expectations alongside
        # T006.
        # shellcheck source=review-gate-debate.sh
        source "$SCRIPT_DIR/review-gate-debate.sh"

        # Compute the canonical <artifact_id> per review type. Debate-capable
        # review types use the input pinned by spec R3, with a
        # three-level fallback ladder for stability across sessions:
        #
        #   1. Wrapper-exported env var (canonical source). spawn-*-review
        #      wrappers pre-set the relevant env var so bare-spawn does
        #      NOT need to infer the source from the session-scoped
        #      `latest.md` artifact path:
        #        plan        → REVIEW_GATE_DEBATE_PLAN_PATH
        #        spec        → REVIEW_GATE_DEBATE_SPEC_PATH
        #        code        → REVIEW_GATE_DIFF_ARGS
        #        epic-verify → REVIEW_GATE_EPIC_CONTEXT
        #        ask         → REVIEW_GATE_ASK_CONTENT
        #
        #   2. Artifact frontmatter parse. The wrappers also embed the
        #      canonical source in artifact frontmatter; this is the
        #      direct-bare-spawn path where the user invokes
        #      `bin/review-gate spawn --type X --debate <wrapper-built-artifact>`:
        #        plan        → `<!-- plan-path: ... -->`
        #        spec        → `<!-- spec-path: ... -->`
        #        code        → `<!-- diff-args: ... -->`
        #        epic-verify → wrapper exports the FULL untruncated
        #                      epic_context via env var; the
        #                      `<!-- epic-context: ... -->` frontmatter
        #                      is presentational only and is truncated to
        #                      100 chars, so it is NOT used as a fallback
        #                      hash input (spec R3 explicitly: "The full
        #                      untruncated epic_context value is the hash
        #                      input regardless of whether it would be
        #                      truncated in frontmatter; the frontmatter
        #                      truncation is presentational only.")
        #        ask         → artifact body bytes when env var is absent.
        #
        #   3. Resolved artifact realpath. Last-ditch fallback for ad-hoc
        #      bare-spawn invocations on stub/minimal artifacts. Different
        #      artifact paths still produce different hashes (spec R3
        #      "different artifacts shuffle assignments"), but per-diff
        #      / per-source differentiation is not available on this
        #      branch — a stderr note records the limitation.
        local _debate_artifact_id=""
        # Resolve the artifact realpath up-front for fallback paths. Use
        # the same resolve_artifact helper that the rest of review_gate_spawn
        # uses so the path computation stays in one place.
        local _resolved_artifact_path=""
        if _resolved_artifact_path=$(resolve_artifact "$artifact_arg" 2>/dev/null); then
            :
        else
            _resolved_artifact_path=""
        fi
        case "$REVIEW_TYPE" in
            plan)
                local _plan_source="${REVIEW_GATE_DEBATE_PLAN_PATH:-}"
                if [[ -z "$_plan_source" && -n "$_resolved_artifact_path" && -f "$_resolved_artifact_path" ]]; then
                    _plan_source=$(sed -nE 's|^<!-- plan-path: (.*) -->$|\1|p' "$_resolved_artifact_path" | head -n 1)
                fi
                if [[ -z "$_plan_source" && -n "$_resolved_artifact_path" ]]; then
                    echo "Note: --debate plan review without REVIEW_GATE_DEBATE_PLAN_PATH or <!-- plan-path: ... --> frontmatter; using artifact realpath for artifact_id (per-source shuffle is not available on this invocation path)." >&2
                    _plan_source="$_resolved_artifact_path"
                fi
                if [[ -z "$_plan_source" ]]; then
                    die "--debate plan review: cannot determine plan source path for artifact_id (no env var, no frontmatter, no resolvable artifact)"
                fi
                _debate_artifact_id=$(compute_artifact_id plan "$_plan_source") || \
                    die "compute_artifact_id plan failed for: $_plan_source"
                ;;
            spec)
                local _spec_source="${REVIEW_GATE_DEBATE_SPEC_PATH:-}"
                if [[ -z "$_spec_source" && -n "$_resolved_artifact_path" && -f "$_resolved_artifact_path" ]]; then
                    _spec_source=$(sed -nE 's|^<!-- spec-path: (.*) -->$|\1|p' "$_resolved_artifact_path" | head -n 1)
                fi
                if [[ -z "$_spec_source" && -n "$_resolved_artifact_path" ]]; then
                    echo "Note: --debate spec review without REVIEW_GATE_DEBATE_SPEC_PATH or <!-- spec-path: ... --> frontmatter; using artifact realpath for artifact_id (per-source shuffle is not available on this invocation path)." >&2
                    _spec_source="$_resolved_artifact_path"
                fi
                if [[ -z "$_spec_source" ]]; then
                    die "--debate spec review: cannot determine spec source path for artifact_id (no env var, no frontmatter, no resolvable artifact)"
                fi
                _debate_artifact_id=$(compute_artifact_id spec "$_spec_source") || \
                    die "compute_artifact_id spec failed for: $_spec_source"
                ;;
            code)
                # Three-level fallback ladder per the comment block above.
                local _code_diff_args="${REVIEW_GATE_DIFF_ARGS:-}"
                if [[ -z "$_code_diff_args" && -n "$_resolved_artifact_path" && -f "$_resolved_artifact_path" ]]; then
                    _code_diff_args=$(sed -nE 's|^<!-- diff-args: (.*) -->$|\1|p' "$_resolved_artifact_path" | head -n 1)
                fi
                if [[ -n "$_code_diff_args" ]]; then
                    _debate_artifact_id=$(compute_artifact_id code "$_code_diff_args") || \
                        die "compute_artifact_id code failed"
                elif [[ -n "$_resolved_artifact_path" ]]; then
                    # Realpath fallback — emit a stderr note so debugging
                    # the determinism contract is easier when this branch
                    # fires. Use plan-style realpath since artifact path
                    # is the only stable identifier we have here.
                    echo "Note: --debate code review without REVIEW_GATE_DIFF_ARGS or <!-- diff-args: ... --> frontmatter; using artifact realpath for artifact_id (per-diff shuffle is not available on this invocation path)." >&2
                    _debate_artifact_id=$(compute_artifact_id plan "$_resolved_artifact_path") || \
                        die "compute_artifact_id (code-realpath fallback) failed for: $_resolved_artifact_path"
                else
                    die "--debate code review: cannot determine artifact_id (no env var, no frontmatter, no resolvable artifact)"
                fi
                ;;
            epic-verify)
                # spawn-epic-verify exports the FULL untruncated
                # epic_context via REVIEW_GATE_EPIC_CONTEXT. The artifact
                # frontmatter <!-- epic-context: ... --> is truncated to
                # 100 chars and is NOT used as a fallback hash input
                # (spec R3 explicit constraint).
                local _epic_source="${REVIEW_GATE_EPIC_CONTEXT:-}"
                if [[ -z "$_epic_source" ]]; then
                    # Fall back to the resolved artifact path / realpath
                    # for direct bare-spawn invocations.
                    if [[ -n "$_resolved_artifact_path" ]]; then
                        echo "Note: --debate epic-verify without REVIEW_GATE_EPIC_CONTEXT; using artifact realpath for artifact_id." >&2
                        _epic_source="$_resolved_artifact_path"
                    elif [[ -n "$artifact_arg" ]]; then
                        _epic_source="$artifact_arg"
                    else
                        die "--debate epic-verify: cannot determine epic_context for artifact_id (no env var, no resolvable artifact)"
                    fi
                fi
                _debate_artifact_id=$(compute_artifact_id epic-verify "$_epic_source") || \
                    die "compute_artifact_id epic-verify failed"
                ;;
            ask)
                local _ask_source="${REVIEW_GATE_ASK_CONTENT:-}"
                if [[ -z "$_ask_source" && -n "$_resolved_artifact_path" && -f "$_resolved_artifact_path" ]]; then
                    _ask_source=$(extract_ask_artifact_section "$_resolved_artifact_path" "## Prompt")
                    if [[ -z "$_ask_source" ]]; then
                        echo "Note: --debate ask without REVIEW_GATE_ASK_CONTENT or structured ## Prompt block; using artifact bytes as prompt content for artifact_id." >&2
                        _ask_source=$(cat "$_resolved_artifact_path")
                    fi
                fi
                if [[ -z "$_ask_source" ]]; then
                    die "--debate ask: cannot determine ask prompt content for artifact_id (no env var and no readable artifact)"
                fi
                _debate_artifact_id=$(compute_artifact_id ask "$_ask_source") || \
                    die "compute_artifact_id ask failed"
                ;;
        esac

        # Assign per-(artifact_id, reviewer) strategies via SHA-256 + canonical
        # collision walk. Export STRATEGY_DIRECTIVE_PATH_<reviewer> for each
        # reviewer in the active set so the per-reviewer prompt-rendering path
        # (T006 coordinator) can pick up the assigned strategy file. This
        # function is byte-deterministic per spec R3.
        #
        # Capture assign_strategies output EAGERLY before the read loop so a
        # non-zero return code from the helper (e.g., neither shasum nor
        # sha256sum on PATH) propagates to this shell. `set -euo pipefail`
        # does NOT propagate exit codes from a process substitution
        # `<(...)`, so a hard-error from _sha256_hex would otherwise be
        # silently swallowed and the loop body would run zero iterations.
        local _debate_assignments
        _debate_assignments=$(assign_strategies "$_debate_artifact_id" "${agents_list[@]}") || \
            die "Strategy assignment failed (artifact_id='$_debate_artifact_id', reviewers=${agents_list[*]})"

        local _debate_reviewer _debate_strategy _debate_strategy_path _upper
        # Empty reviewer list is defensive: assign_strategies returns empty
        # output, the loop body is skipped, no env vars are exported.
        if [[ -n "$_debate_assignments" ]]; then
            while IFS=$' \t' read -r _debate_reviewer _debate_strategy; do
                [[ -z "$_debate_reviewer" ]] && continue
                _debate_strategy_path=$(resolve_strategy_path "$_debate_strategy") || \
                    die "Failed to resolve strategy path for $_debate_strategy"
                # Export per-reviewer strategy directive path (consumed by T006).
                # The variable name is uppercase-canonical-reviewer so multiple
                # reviewers don't collide.
                _upper=$(echo "$_debate_reviewer" | tr '[:lower:]' '[:upper:]')
                export "STRATEGY_DIRECTIVE_PATH_${_upper}=$_debate_strategy_path"
                # Also export the strategy NAME for the same reviewer (handy for
                # report rendering and downstream tools that don't want to
                # re-read the file).
                export "STRATEGY_NAME_${_upper}=$_debate_strategy"
            done <<< "$_debate_assignments"
        fi

        # Export the canonical artifact_id so downstream tools (T006
        # coordinator, telemetry) can reference the same identifier without
        # recomputing it.
        export DEBATE_ARTIFACT_ID="$_debate_artifact_id"
    fi

    preflight_check

    # --- Resolve author context (context file > env override > previous state) ---
    local author_context=""
    author_context=$(resolve_author_context "$REVIEW_DIR" "$context_file")

    local artifact_path
    artifact_path=$(resolve_artifact "$artifact_arg")

    check_existing_gate

    # Read prebuilt prompt content BEFORE clean_state deletes it
    local prebuilt_prompt_content=""
    if [[ -n "${REVIEW_GATE_PROMPT_FILE:-}" && -f "$REVIEW_GATE_PROMPT_FILE" ]]; then
        prebuilt_prompt_content=$(cat "$REVIEW_GATE_PROMPT_FILE")
    fi

    clean_state

    local artifact_sha256
    artifact_sha256=$(compute_sha256 "$artifact_path")

    # Determine trigger source: prefer explicit REVIEW_TYPE, fallback to filename-based detection
    local trigger_source
    if [[ -n "$REVIEW_TYPE" ]]; then
        trigger_source="$REVIEW_TYPE"
    else
        trigger_source=$(determine_source "$artifact_path")
        REVIEW_TYPE="$trigger_source"
    fi

    local prompt_file="$REVIEWS_DIR/review.prompt"
    if [[ -n "$prebuilt_prompt_content" ]]; then
        if [[ -n "$author_context" ]]; then
            if ! printf '%s' "$prebuilt_prompt_content" | grep -Fq "## Author Context"; then
                local context_block
                context_block=$(author_context_block "$author_context")
                prebuilt_prompt_content=$(inject_context_block "$prebuilt_prompt_content" "$context_block")
            fi
        fi
        # Use pre-built prompt content (read before clean_state)
        echo "$prebuilt_prompt_content" > "$prompt_file"
    else
        # The bare-spawn path uses build_prompt, which substitutes the
        # debate-mode placeholders on the template via
        # substitute_debate_placeholders BEFORE merging artifact content.
        # That ordering keeps artifact bytes (which may contain literal
        # `${CONFIDENCE_ANCHORS}` etc., e.g., a diff that touches these
        # templates) untouched, while still removing the placeholders
        # under --debate absent (R9 byte-parity) and injecting canonical
        # anchor/strategy bytes under --debate set.
        build_prompt "$artifact_path" "$REVIEW_TYPE" > "$prompt_file"
    fi

    # Create JSON schema for structured output. Delegates to
    # `_emit_review_schema` (review-gate-models.sh) which owns the single
    # debate-conditional branch: byte-identical pre-feature schema bytes when
    # `--debate` is absent (R9 byte-parity), debate variant with the additive
    # fields when `--debate` is set. The repair path
    # (`repair_review_output()`) reads the same schema_file when present and
    # falls back to `default_review_schema()` (which honors the
    # `REVIEW_GATE_DEBATE` env var exported below) so the repair-prompt schema
    # picks the matching variant.
    local schema_file="$REVIEWS_DIR/review-schema.json"
    if [[ "$debate" == "true" ]]; then
        # Export REVIEW_GATE_DEBATE so downstream callers of
        # default_review_schema() (notably repair_review_output's fallback
        # when no schema_file is on disk) emit the debate variant. The env
        # var is scoped to this spawn invocation; non-debate runs never set
        # it, preserving R9 byte-parity for the schema artifact and the
        # repair-prompt schema text.
        export REVIEW_GATE_DEBATE=1
        _emit_review_schema "true" > "$schema_file"
    else
        _emit_review_schema "false" > "$schema_file"
    fi

    # Initialize state
    local now
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local current_iter
    current_iter=$(load_iteration "$REVIEW_DIR")

    # Mode configuration (for iterative review types)
    local mode_type="artifact"
    local mode_diff_args=""
    local mode_plan_path=""

    case "$trigger_source" in
        code)
            mode_type="code-diff"
            mode_diff_args="${REVIEW_GATE_DIFF_ARGS:-}"
            ;;
        plan)
            mode_type="plan"
            mode_plan_path="$artifact_path"
            ;;
        ask)
            mode_type="ask"
            ;;
    esac

    local state_json
    # T004 schema additions (plan L455-L466): top-level `host` plus
    # `owner.{host,project_key,run_key,session_key,session_id,
    # transcript_path,source}`. `session_key` is the legacy alias kept for
    # `find_state_by_session_key` glob lookups; `run_key` is the canonical
    # field. Both carry the same value (OWNER_SESSION_KEY).
    state_json=$(jq -n \
        --arg version "1" \
        --arg status "pending" \
        --arg source "$trigger_source" \
        --arg path "$artifact_path" \
        --arg sha256 "$artifact_sha256" \
        --arg created "$now" \
        --argjson iteration "$current_iter" \
        --arg author_context "$author_context" \
        --arg host "$OWNER_HOST" \
        --arg owner_host "$OWNER_HOST" \
        --arg owner_project_key "$OWNER_PROJECT_KEY" \
        --arg owner_run_key "$OWNER_SESSION_KEY" \
        --arg owner_key "$OWNER_SESSION_KEY" \
        --arg owner_source "$OWNER_SOURCE" \
        --arg owner_session_id "$OWNER_SESSION_ID" \
        --arg owner_transcript "$OWNER_TRANSCRIPT_PATH" \
        --arg mode_type "$mode_type" \
        --arg mode_diff_args "$mode_diff_args" \
        --arg mode_plan_path "$mode_plan_path" \
        --arg ask_prompt "${REVIEW_GATE_ASK_CONTENT:-}" \
        --arg ask_context "${REVIEW_GATE_ASK_CONTEXT:-}" \
        --arg mode "$mode" \
        --arg max_rounds "$max_rounds" \
        --arg consensus_mode "$consensus_mode" \
        --arg debate "$debate" \
        --arg debate_seed "$debate_seed" \
        '{
            version: ($version | tonumber),
            status: $status,
            trigger_source: $source,
            host: (if $host != "" then $host else null end),
            artifact: {path: $path, sha256: $sha256},
            mode: (
                {type: $mode_type}
                | (if $mode_diff_args != "" then .diff_args = $mode_diff_args else . end)
                | (if $mode_plan_path != "" then .plan_path = $mode_plan_path else . end)
                | (if $mode_type == "ask" and $ask_prompt != "" then .ask_prompt = $ask_prompt else . end)
                | (if $mode_type == "ask" and $ask_context != "" then .ask_context = $ask_context else . end)
            ),
            config: (
                {}
                | (if $max_rounds != "" then .max_rounds = ($max_rounds | tonumber) else . end)
                | (if $mode != "" then .intelligence_mode = $mode else . end)
                | (if $consensus_mode != "" then .consensus_mode = $consensus_mode else . end)
                | (if $debate == "true" then .debate = true else . end)
                | (if $debate == "true" and $debate_seed != "" then .debate_seed = $debate_seed else . end)
                | if length == 0 then null else . end
            ),
            owner: (
                {}
                | (if $owner_host != "" then .host = $owner_host else . end)
                | (if $owner_project_key != "" then .project_key = $owner_project_key else . end)
                | (if $owner_run_key != "" then .run_key = $owner_run_key else . end)
                | (if $owner_key != "" then .session_key = $owner_key else . end)
                | (if $owner_source != "" then .source = $owner_source else . end)
                | (if $owner_session_id != "" then .session_id = $owner_session_id else . end)
                | (if $owner_transcript != "" then .transcript_path = $owner_transcript else . end)
                | if length == 0 then null else . end
            ),
            author_context: (if $author_context != "" then $author_context else null end),
            reviewers: {},
            consensus: null,
            decision: null,
            created_at: $created,
            iteration: $iteration
        }')

    # Spawn reviewers and record in state
    local reviewers_json='{}'
    local spawned=0
    # Track the names of reviewers that successfully spawned. Under --debate
    # this is the set passed to run_debate_coordinator's wait loop; reviewers
    # that fail to spawn (missing CLI, gemini policy missing, etc.) MUST NOT
    # be polled for sentinels because no detached process will ever produce
    # one — passing the full agents_list would hang the coordinator for the
    # entire timeout budget on a missing-CLI invocation.
    local -a _debate_spawned_reviewers=()

    # Pre-resolve the default-strategy file content (verification-first.md)
    # ONCE for all reviewers; the prebuilt-prompt per-reviewer rendering
    # path uses string-replace to swap these bytes for each reviewer's
    # assigned-strategy bytes. Resolved here (outside the loop) so we hard-
    # error early if the asset is missing rather than mid-loop on the Nth
    # reviewer. Only resolved under --debate AND when there's a prebuilt
    # prompt to operate on; otherwise the variable is intentionally unset.
    local _debate_default_strategy_file=""
    if [[ "$debate" == "true" ]] && [[ -n "$prebuilt_prompt_content" ]]; then
        _debate_default_strategy_file=$(resolve_strategy_path "verification-first") || \
            die "Failed to resolve default verification-first.md (required for prebuilt-prompt per-reviewer rendering)"
    fi

    # ----------------------------------------------------------------------
    # Debate-mode staging directory. Under --debate, spawn_reviewer writes
    # per-reviewer outputs into the per-round staging dir
    # `iterations/<iter>/round-1/` rather than the canonical $REVIEWS_DIR.
    # The synchronous coordinator (run_debate_coordinator below) sync-waits
    # for the staging sentinels, runs the Phase D stub aggregator, and
    # atomically promotes per-reviewer JSONs into $REVIEWS_DIR with the
    # additive debate fields. Non-debate runs leave _debate_staging_dir
    # empty and spawn_reviewer falls back to $REVIEWS_DIR (R9 byte-parity
    # is preserved since spawn_reviewer's 5th-arg default is REVIEWS_DIR).
    # ----------------------------------------------------------------------
    local _debate_staging_dir=""
    if [[ "$debate" == "true" ]]; then
        _debate_staging_dir="$REVIEW_DIR/iterations/$current_iter/round-1"
        mkdir -p "$_debate_staging_dir"
        # Defensive cleanup: a re-spawn under REVIEW_GATE_RERUN=1 in the
        # same iteration must not see stale sentinels from a prior run
        # (otherwise the coordinator's wait loop would short-circuit on
        # stale .done files before reviewers have re-written outputs).
        rm -f "$_debate_staging_dir"/*.done \
              "$_debate_staging_dir"/*.failed \
              "$_debate_staging_dir"/*.json \
              "$_debate_staging_dir"/*.jsonl 2>/dev/null || true
    fi

    for reviewer in "${agents_list[@]}"; do
        # Per-reviewer prompt rendering under --debate (T005). Two branches:
        #
        #   (1) Bare-spawn build_prompt branch (no prebuilt content): re-
        #       render the prompt for THIS reviewer using their assigned
        #       strategy (STRATEGY_NAME_<REVIEWER>) by setting
        #       REVIEW_GATE_DEBATE_STRATEGY and recalling build_prompt.
        #
        #   (2) Prebuilt-prompt branch (spawn-*-review wrappers wrote
        #       review.prompt with the default verification-first.md
        #       content inlined by T004's substitute_debate_placeholders):
        #       string-replace those default bytes with the per-reviewer
        #       strategy file's bytes via python3. python3 is already a
        #       hard dependency of the helper (used by _resolve_realpath
        #       fallback and the test harness). The replacement is
        #       limited to a single occurrence (the strategy block
        #       inserted by the substitute pass).
        #
        # Both branches write to `$REVIEWS_DIR/review.<reviewer>.prompt`
        # and pass that to spawn_reviewer. Per-reviewer rendering makes
        # the per-(artifact_id, reviewer) R3 strategy assignment ACTUALLY
        # appear in the prompts sent to each model; the env-var exports
        # alone are not sufficient (they would be computed-but-unused
        # without this rendering step).
        local _rendered_prompt_file="$prompt_file"
        if [[ "$debate" == "true" ]]; then
            local _rev_upper _strategy_name_var _per_reviewer_strategy _per_reviewer_strategy_file
            _rev_upper=$(echo "$reviewer" | tr '[:lower:]' '[:upper:]')
            _strategy_name_var="STRATEGY_NAME_${_rev_upper}"
            _per_reviewer_strategy="${!_strategy_name_var:-verification-first}"
            _rendered_prompt_file="$REVIEWS_DIR/review.${reviewer}.prompt"

            if [[ -z "$prebuilt_prompt_content" ]]; then
                # Branch (1): build_prompt path.
                REVIEW_GATE_DEBATE_STRATEGY="$_per_reviewer_strategy" \
                    build_prompt "$artifact_path" "$REVIEW_TYPE" > "$_rendered_prompt_file"
            else
                # Branch (2): prebuilt path. String-replace the default
                # strategy bytes with the per-reviewer strategy bytes.
                _per_reviewer_strategy_file=$(resolve_strategy_path "$_per_reviewer_strategy") || \
                    die "Failed to resolve per-reviewer strategy file for $reviewer ($_per_reviewer_strategy)"
                if [[ "$_per_reviewer_strategy" == "verification-first" ]]; then
                    # Optimization: assigned strategy matches the default;
                    # no string replace needed. Just copy the prebuilt
                    # prompt to the per-reviewer location.
                    cp "$prompt_file" "$_rendered_prompt_file"
                else
                    if ! python3 -c '
import sys
prompt_path, default_path, new_path, out_path = sys.argv[1:5]
with open(prompt_path, "rb") as f: prompt = f.read()
with open(default_path, "rb") as f: default_bytes = f.read()
with open(new_path, "rb") as f: new_bytes = f.read()
if default_bytes not in prompt:
    sys.stderr.write(
        "error: default verification-first.md bytes not found in prebuilt prompt; "
        "cannot perform per-reviewer strategy substitution. The wrapper that wrote "
        "this prompt must use the canonical T004 substitute_debate_placeholders pass "
        "with the default strategy.\n"
    )
    sys.exit(1)
out = prompt.replace(default_bytes, new_bytes, 1)
with open(out_path, "wb") as f: f.write(out)
' "$prompt_file" "$_debate_default_strategy_file" "$_per_reviewer_strategy_file" "$_rendered_prompt_file"; then
                        die "Failed to render per-reviewer prompt for $reviewer (strategy=$_per_reviewer_strategy)"
                    fi
                fi
            fi
        fi
        # Under --debate, override spawn_reviewer's output_dir to the
        # per-round staging dir so reviewer JSON/sentinels land there
        # rather than the canonical $REVIEWS_DIR. Non-debate runs omit
        # the 5th arg so spawn_reviewer's default ($REVIEWS_DIR) applies
        # — keeping R9 byte-parity for non-debate invocations.
        local _rdc_spawn_rc=0
        if [[ "$debate" == "true" ]]; then
            spawn_reviewer "$reviewer" "$reviewer" "$_rendered_prompt_file" "$schema_file" "$_debate_staging_dir" || _rdc_spawn_rc=$?
        else
            spawn_reviewer "$reviewer" "$reviewer" "$_rendered_prompt_file" "$schema_file" || _rdc_spawn_rc=$?
        fi
        if [[ $_rdc_spawn_rc -eq 0 ]]; then
            # state_json.reviewers always points at the canonical
            # $REVIEWS_DIR paths since the synchronous coordinator
            # promotes per-reviewer JSONs there before returning. Stop-
            # hook (today) reads $REVIEWS_DIR; the staging dir is an
            # implementation detail not surfaced via state_json.
            reviewers_json=$(echo "$reviewers_json" | jq \
                --arg name "$reviewer" \
                --arg output "$REVIEWS_DIR/${reviewer}.json" \
                --arg sentinel "$REVIEWS_DIR/${reviewer}.done" \
                '.[$name] = {output_file: $output, sentinel_file: $sentinel, completed_at: null, result: null}')
            spawned=$((spawned + 1))
            _debate_spawned_reviewers+=("$reviewer")
        fi
    done

    if [[ $spawned -eq 0 ]]; then
        # Under `--debate`, zero successful spawns is the realistic
        # degraded-before-round case (every spawn_reviewer invocation
        # returned non-zero — gemini policy lookup failure, missing CLI
        # under runtime PATH, etc.) and MUST take the T012 distinct-
        # exit-codes contract: exit 6, awaiting_decision/requires_decision,
        # iterations/<iter>/debate-telemetry.json. Pre-write the gate
        # state with .reviewers = {} so the degraded helper's
        # `_rdc_mark_state_degraded` jq patch lands cleanly.
        if [[ "$debate" == "true" ]]; then
            state_json=$(echo "$state_json" | jq '.reviewers = {}')
            echo "$state_json" > "$STATE_FILE"
            echo "Debate coordinator: 0 reviewer(s) spawned successfully (need >=2); aborting before sync-wait." >&2
            _RDC_ITER_DIR="$(dirname "$_debate_staging_dir")" \
            _RDC_REVIEWS_DIR="$REVIEWS_DIR" \
            _RDC_CONSENSUS_MODE="$consensus_mode" \
            _RDC_DEBATE_MODE="$mode" \
            _RDC_STRATEGIES_JSON='{}' \
            _RDC_ROUNDS_JSON='[]' \
            _RDC_ROUNDS_COMPLETED=0 \
            _RDC_AGGREGATOR_NOTES_JSON='[]' \
            _rdc_pre_round_degraded_exit
        fi

        # Non-debate path: resolve gate as proceed/no_reviewers to avoid
        # blocking the Stop hook (legacy behavior, unchanged).
        state_json=$(echo "$state_json" | jq \
            --arg status "resolved" \
            --arg verdict "no_reviewers" \
            --arg action "proceed" \
            --arg decided "$now" \
            '.status = $status
             | .consensus = {verdict: $verdict, iteration: 0}
             | .decision = {action: $action, decided_at: $decided, reason: "no_reviewers"}
             | .reviewers = {}')

        echo "$state_json" > "$STATE_FILE"
        echo "No reviewers available; gate resolved as proceed" >&2
        echo "State file: $STATE_FILE" >&2
        exit 0
    fi

    # Update state with reviewers
    state_json=$(echo "$state_json" | jq --argjson reviewers "$reviewers_json" '.reviewers = $reviewers')

    # Write gate-state.json file
    echo "$state_json" > "$STATE_FILE"

    echo "Review gate spawned: $spawned reviewers for $artifact_path" >&2
    echo "State file: $STATE_FILE" >&2

    # ----------------------------------------------------------------------
    # Debate-mode synchronous coordinator (Phase D scope: Round 1 + stub
    # aggregate + atomic promotion).
    #
    # By this point under --debate, reviewer processes have been detached
    # against the per-round staging dir ($_debate_staging_dir). The
    # coordinator sync-waits for sentinels, runs the stub aggregator, and
    # atomically promotes per-reviewer JSONs (with additive debate fields:
    # overall_confidence, strategy, round=1, peer_responses_seen=[]) plus
    # `aggregate.json` into the canonical $REVIEWS_DIR. By the time control
    # returns from this call, $REVIEWS_DIR is populated exactly as the
    # Stop-hook expects today.
    #
    # On any aggregator error: $REVIEWS_DIR is left UNTOUCHED (no
    # per-reviewer JSONs, no sentinels, no aggregate.json). Staging is
    # preserved under iterations/<iter>/round-1/ for inspection. The
    # process exits non-zero so the failure is not silently swallowed
    # (T012 will pin the exact reserved exit code; for now any non-zero
    # exit is acceptable per the task spec).
    # ----------------------------------------------------------------------
    if [[ "$debate" == "true" ]]; then
        local _rdc_timeout="${REVIEW_GATE_MAX_WAIT_SECONDS:-1800}"
        local _rdc_poll="${REVIEW_GATE_POLL_INTERVAL_SECONDS:-3}"

        # Coordinator-failure state mutation. Per spec
        # (docs/2026-04-25-debate-spec.md "Aggregator failure" / AC-7),
        # an aggregator crash (rc=5) MUST mirror the Cancellation
        # on-disk shape exactly: status stays "pending", no .debate
        # block, no consensus/decision mutation, reviews/ empty. The
        # distinct stderr `aggregator failed: <reason>` marker plus the
        # reserved exit code 5 (emitted by the coordinator's
        # _rdc_aggregator_fail_exit before this caller sees the rc) is
        # the only signal that distinguishes an aggregator crash from
        # a SIGINT cancel or a hang. Therefore the rc=5 arm below does
        # NOT invoke _debate_mark_state_failed.
        #
        # _debate_mark_state_failed remains in place for OTHER
        # unexpected coordinator non-zero exits (the `*` arm — codes
        # not pinned by the spec): those represent a coordinator bug
        # rather than a spec-defined failure mode, and surfacing them
        # via status="resolved" + verdict="ERROR" prevents the
        # Stop-hook auto-respawn loop (bin/review-gate-hook.sh:795)
        # from silently demoting a buggy debate run to a non-debate
        # re-review (the Stop-hook's `spawn_reviewers` helper does NOT
        # propagate --debate). Spec-pinned failure modes (5/6/130) all
        # have explicit case arms below; the `*` arm only fires for
        # genuinely unexpected codes.
        _debate_mark_state_failed() {
            if [[ -f "$STATE_FILE" ]]; then
                local _state_tmp="$STATE_FILE.coord-fail.tmp.$$"
                local _now_ts
                _now_ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")
                if jq --arg now "$_now_ts" \
                      --arg reason "debate_aggregator_failed" \
                   '.reviewers = {}
                    | .status = "resolved"
                    | .consensus = {verdict: "ERROR", iteration: (.iteration // 0), reason: $reason}
                    | .decision = {action: "manual_resolve", decided_at: $now, reason: $reason}' \
                   "$STATE_FILE" > "$_state_tmp" 2>/dev/null; then
                    mv -f "$_state_tmp" "$STATE_FILE"
                else
                    rm -f "$_state_tmp" 2>/dev/null || true
                fi
            fi
        }

        # Pass ONLY the successfully-spawned reviewers to the coordinator.
        # Reviewers that failed to spawn (missing CLI, missing gemini policy,
        # spawn_reviewer non-zero return) never produce a sentinel, so a
        # wait loop over the full agents_list would block for the entire
        # timeout budget. The <2 reviewers preflight already runs above on
        # the requested set; if we end up with <2 successfully-spawned
        # reviewers here (e.g., due to a runtime CLI failure that the
        # `command -v` preflight missed), this is a realistic
        # degraded-before-round path under the T012 distinct-exit-codes
        # contract: stderr the canonical degraded-below-2 message,
        # transition gate-state.json to awaiting_decision/requires_decision
        # via `_rdc_mark_state_degraded`, write
        # iterations/<iter>/debate-telemetry.json with empty
        # rounds_telemetry (no round reached the wait loop), and exit 6.
        if [[ ${#_debate_spawned_reviewers[@]} -lt 2 ]]; then
            echo "" >&2
            echo "Debate coordinator: only ${#_debate_spawned_reviewers[@]} reviewer(s) spawned successfully (need >=2); aborting before sync-wait." >&2
            echo "Spawned: ${_debate_spawned_reviewers[*]:-(none)}" >&2
            _RDC_ITER_DIR="$(dirname "$_debate_staging_dir")" \
            _RDC_REVIEWS_DIR="$REVIEWS_DIR" \
            _RDC_CONSENSUS_MODE="$consensus_mode" \
            _RDC_DEBATE_MODE="$mode" \
            _RDC_STRATEGIES_JSON='{}' \
            _RDC_ROUNDS_JSON='[]' \
            _RDC_ROUNDS_COMPLETED=0 \
            _RDC_AGGREGATOR_NOTES_JSON='[]' \
            _rdc_pre_round_degraded_exit
        fi
        # Export the captured `--debate-seed N` value (if any) so the
        # synchronous coordinator's T007 anonymization pass can pick the
        # seeded vs. production-path shuffle without widening
        # run_debate_coordinator's positional signature. Empty `debate_seed`
        # ⇒ the production-path /dev/urandom shuffle.
        export REVIEW_GATE_DEBATE_SEED="$debate_seed"
        # Export the captured --mode so the coordinator can determine the
        # max round count (2 under fast/smart, 3 under max — T010 wires
        # Round 3). T008 caps at 2 rounds always; T010 lifts this when
        # max-mode is the active mode.
        export REVIEW_GATE_DEBATE_MODE="$mode"
        # Capture the staging-dir's iteration parent so the coordinator can
        # locate iterations/<iter>/round-2/ relative to the round-1 staging
        # without re-deriving the path from REVIEW_DIR + iter#.
        local _rdc_rc=0
        run_debate_coordinator \
                "$_debate_staging_dir" "$REVIEWS_DIR" \
                "$consensus_mode" "$_rdc_timeout" "$_rdc_poll" \
                "${_debate_spawned_reviewers[@]}" || _rdc_rc=$?
        case "$_rdc_rc" in
            0) ;;
            5)
                # Aggregator failure (spec AC-7 / "Aggregator failure"
                # subsection): the coordinator's
                # _rdc_aggregator_fail_exit already emitted the canonical
                # `aggregator failed: <reason>` stderr marker and exited
                # with the spec-reserved code 5. Per spec the on-disk
                # shape MUST mirror Cancellation: gate-state.json.status
                # stays "pending", no .debate block, no consensus or
                # decision mutation; canonical $REVIEWS_DIR stays empty;
                # partial round telemetry lives under iterations/<iter>/.
                # We deliberately do NOT call _debate_mark_state_failed
                # here. Recovery is identical to Cancellation: re-spawn
                # under REVIEW_GATE_RERUN=1 (or `${CLI_CMD} resolve` for
                # cleanup). Propagate the reserved exit code unchanged so
                # users and CI can distinguish aggregator failure from
                # cancel (130) or degraded-below-2 (6) without parsing
                # telemetry.
                echo "" >&2
                echo "Debate coordinator: aggregator failed; reviews/ left empty, gate-state status remains 'pending' (staging preserved at $_debate_staging_dir)." >&2
                echo "Recovery: re-spawn with REVIEW_GATE_RERUN=1 (or '${CLI_CMD} resolve' for cleanup); identical to Cancellation recovery." >&2
                exit 5
                ;;
            6)
                # Degraded-below-2 (mid-debate or final-round): coordinator
                # already wrote `gate-state.json.status="awaiting_decision"`
                # and `consensus.verdict="requires_decision"` per spec R6
                # (see _rdc_mark_state_degraded in review-gate-debate.sh).
                # Canonical $REVIEWS_DIR is left empty; partial outputs
                # preserved under iterations/<iter>/round-N/. T012 will pin
                # the public exit code; for T008 we surface non-zero so the
                # caller's failure path is exercised.
                echo "" >&2
                echo "Debate coordinator: degraded below 2 active reviewers in the final peer round." >&2
                echo "Reviews/ left empty; partial outputs preserved under $_debate_staging_dir (and round-2 staging if reached)." >&2
                echo "Recovery: '${CLI_CMD} resolve --reason \"...\"' or re-spawn under REVIEW_GATE_RERUN=1." >&2
                exit 6
                ;;
            *)
                # Unexpected coordinator failure (NOT one of the spec-
                # pinned modes 5/6/130). This represents a coordinator
                # bug rather than a spec-defined failure mode, so we
                # mark gate-state.json terminal (status="resolved",
                # consensus.verdict="ERROR", decision.action=
                # "manual_resolve") to keep the Stop-hook from auto-
                # respawning into a non-debate re-review.
                echo "" >&2
                echo "Debate coordinator failed unexpectedly (rc=$_rdc_rc); reviews/ left empty (staging preserved at $_debate_staging_dir)." >&2
                echo "Recovery: 'bin/review-gate resolve' to mark the gate resolved, or re-spawn with REVIEW_GATE_RERUN=1 to bypass the active-gate guard." >&2
                _debate_mark_state_failed
                exit 1
                ;;
        esac
        echo "Debate coordinator completed: aggregate.json + per-reviewer JSONs promoted to $REVIEWS_DIR" >&2
    fi

    echo "" >&2
    echo "STOP now. The stop hook will wait for reviewers and present findings." >&2
}

# find_state_by_session_key — locate a gate-state.json by owner.session_key.
#
# Glob-walks the legacy Claude tree, the neutral host tree, and any
# explicit CERBERUS_STATE_ROOT, returning the most-recently-created
# gate-state.json whose `.owner.session_key` matches the supplied key.
# Used by `wait --session-key` and `status --session-key` as the
# fallback after the env-passing resolve_review_dir() lookup misses
# (e.g., a Codex/Amp adapter calling `--session-key` without exporting
# CERBERUS_PROJECT_KEY).
#
# Plan reference: §Run-key lookup parity (L613-L630). T002 added the
# neutral-roots search path. T003 promoted this from a nested helper
# inside review_gate_wait to a top-level function so review_gate_status
# can share the exact same lookup. No behavior change versus the prior
# nested definition.
#
# Stdout: absolute path to the matched gate-state.json, or empty string.
find_state_by_session_key() {
    local key="$1"
    local candidate=""
    local candidate_epoch=0
    shopt -s nullglob
    local -a state_files=(
        "$HOME/.claude/projects"/*/cerberus/*/gate-state.json
        "$HOME/.cerberus/projects"/*/*/gate-state.json
    )
    if [[ -n "${CERBERUS_STATE_ROOT:-}" && "${CERBERUS_STATE_ROOT:-}" == /* ]]; then
        # CERBERUS_STATE_ROOT can be used by Claude callers too, in
        # which case the layout is /<proj>/cerberus/<run>/. Cover both
        # layouts so the search is host-agnostic.
        state_files+=(
            "${CERBERUS_STATE_ROOT}"/*/*/gate-state.json
            "${CERBERUS_STATE_ROOT}"/*/cerberus/*/gate-state.json
        )
    fi
    local state_file
    for state_file in ${state_files[@]+"${state_files[@]}"}; do
        [[ ! -f "$state_file" ]] && continue
        local owner_key
        owner_key=$(jq -r '.owner.session_key // ""' "$state_file" 2>/dev/null || echo "")
        if [[ "$owner_key" != "$key" ]]; then
            continue
        fi
        local created_at epoch
        created_at=$(jq -r '.created_at // ""' "$state_file" 2>/dev/null || echo "")
        epoch=0
        if [[ -n "$created_at" ]]; then
            epoch=$(iso8601_to_epoch "$created_at")
        fi
        if [[ "$epoch" -eq 0 ]]; then
            epoch=$(stat -c %Y "$state_file" 2>/dev/null || stat -f %m "$state_file" 2>/dev/null || echo 0)
        fi
        if [[ -z "$candidate" || "$epoch" -gt "$candidate_epoch" ]]; then
            candidate="$state_file"
            candidate_epoch="$epoch"
        fi
    done
    shopt -u nullglob
    printf '%s' "$candidate"
}

review_gate_resolve() {
    local reason=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reason)
                shift
                if [[ -z "${1:-}" ]]; then
                    die "Missing value for --reason"
                fi
                reason="$1"
                ;;
            *)
                die "Invalid argument '$1'. Usage: ${CLI_CMD} resolve [--reason <text>]"
                ;;
        esac
        shift
    done

    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"

    # T002: host-neutral fallback. When CLAUDE_SESSION_ID is unset but a
    # CERBERUS_RUN_KEY (or REVIEW_GATE_SESSION_KEY alias) is provided,
    # resolve_review_dir() routes through __cerberus_resolve_run_key
    # internally, but we still need a non-empty session_id to take the
    # direct-resolution branch instead of the find_active_gate fallback.
    if [[ -z "$session_id" ]]; then
        session_id="$(__cerberus_resolve_run_key)"
    fi

    local state_file=""

    if [[ -n "$session_id" ]]; then
        local review_dir
        review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
        state_file="$review_dir/gate-state.json"
    else
        local active_session
        active_session=$(find_active_gate "$transcript_path" 2>/dev/null || echo "")
        if [[ -n "$active_session" ]]; then
            local base_dir
            base_dir=$(get_review_base_dir "$transcript_path")
            state_file="$base_dir/$active_session/gate-state.json"
        else
            echo "No active review gate found" >&2
            exit 0
        fi
    fi

    if [[ ! -f "$state_file" ]]; then
        echo "No active review gate" >&2
        exit 0
    fi

    if ! command -v jq >/dev/null 2>&1; then
        die "jq is required but not installed"
    fi

    local timestamp
    timestamp=$(date -Iseconds)

    local temp_file="${state_file}.tmp.$$"
    # T002: include the alias-warning marker in the cleanup so the top-level
    # marker-cleanup trap (which we clobber here) is not lost.
    trap 'rm -f "${temp_file:-}" "${TMPDIR:-/tmp}/cerberus-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-root-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-session-id-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-transcript-path-alias-warned.$$" 2>/dev/null || true' EXIT

    # Update shas to current values so subsequent hook runs don't detect "changes"
    # This prevents respawning reviewers after auto_approve when files were edited during review
    local plan_path spec_path artifact_path review_dir
    review_dir=$(dirname "$state_file")
    plan_path=$(jq -r '.mode.plan_path // empty' "$state_file" 2>/dev/null || echo "")
    spec_path=$(jq -r '.mode.spec_path // empty' "$state_file" 2>/dev/null || echo "")
    artifact_path="$review_dir/latest.md"

    local plan_sha="" spec_sha="" artifact_sha=""
    if [[ -n "$plan_path" && -f "$plan_path" ]]; then
        plan_sha=$(compute_sha256 "$plan_path" 2>/dev/null || echo "")
    fi
    if [[ -n "$spec_path" && -f "$spec_path" ]]; then
        spec_sha=$(compute_sha256 "$spec_path" 2>/dev/null || echo "")
    fi
    if [[ -f "$artifact_path" ]]; then
        artifact_sha=$(compute_sha256 "$artifact_path" 2>/dev/null || echo "")
    fi

    if [[ -n "$reason" ]]; then
        jq --arg timestamp "$timestamp" \
           --arg reason "$reason" \
           --arg plan_sha "$plan_sha" \
           --arg spec_sha "$spec_sha" \
           --arg artifact_sha "$artifact_sha" \
           '.status = "resolved"
            | .decision.action = "proceed"
            | .decision.decided_at = $timestamp
            | .decision.reason = $reason
            | if $plan_sha != "" then .artifact.plan_sha = $plan_sha else . end
            | if $spec_sha != "" then .artifact.spec_sha = $spec_sha else . end
            | if $artifact_sha != "" then .artifact.sha256 = $artifact_sha else . end' \
           "$state_file" > "$temp_file"
    else
        jq --arg timestamp "$timestamp" \
           --arg plan_sha "$plan_sha" \
           --arg spec_sha "$spec_sha" \
           --arg artifact_sha "$artifact_sha" \
           '.status = "resolved"
            | .decision.action = "proceed"
            | .decision.decided_at = $timestamp
            | del(.decision.reason)
            | if $plan_sha != "" then .artifact.plan_sha = $plan_sha else . end
            | if $spec_sha != "" then .artifact.spec_sha = $spec_sha else . end
            | if $artifact_sha != "" then .artifact.sha256 = $artifact_sha else . end' \
           "$state_file" > "$temp_file"
    fi

    if ! jq -e . "$temp_file" >/dev/null 2>&1; then
        die "Failed to create valid JSON output"
    fi

    mv "$temp_file" "$state_file"

    # Update run telemetry on resolution
    if declare -f update_run_telemetry_on_resolve >/dev/null 2>&1; then
        update_run_telemetry_on_resolve "$review_dir" "resolved" "${reason:-manual}" 2>/dev/null || true
    fi

    echo "Review gate resolved"
}

review_gate_wait() {
    # Defensive error handling: ensure we always output JSON even on unexpected errors
    # This trap catches any unhandled errors from set -e and outputs valid JSON
    _wait_error_json() {
        trap - ERR  # Clear trap to prevent recursion
        local exit_code="${1:-1}"  # Exit code passed explicitly from trap
        local line_no="${2:-unknown}"
        # Use printf to avoid any jq issues in error path
        printf '{"status":"error","consensus_verdict":null,"reviewers":{},"aggregated_findings":[],"parse_errors":[{"reviewer":null,"error":"internal_error","details":"Unexpected error at line %s (exit %d)"}]}\n' "$line_no" "$exit_code"
        exit 2
    }
    trap '_wait_error_json $? $LINENO' ERR

    local json_mode="false"
    local finalize="false"
    local timeout="${REVIEW_GATE_MAX_WAIT_SECONDS:-1800}"
    local session_key="$(__cerberus_resolve_run_key)"
    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"
    local poll_interval="${REVIEW_GATE_POLL_INTERVAL_SECONDS:-3}"
    local session_key_from_arg="false"
    local session_id_from_arg="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)
                json_mode="true"
                shift
                ;;
            --finalize)
                finalize="true"
                shift
                ;;
            --timeout=*)
                timeout="${1#*=}"
                shift
                ;;
            --timeout)
                timeout="${2:-}"
                shift 2
                ;;
            --poll-interval=*)
                poll_interval="${1#*=}"
                shift
                ;;
            --poll-interval)
                poll_interval="${2:-}"
                shift 2
                ;;
            --session-key=*)
                session_key="${1#*=}"
                session_key_from_arg="true"
                shift
                ;;
            --session-key)
                session_key="${2:-}"
                session_key_from_arg="true"
                shift 2
                ;;
            --session-id)
                session_id="${2:-}"
                session_id_from_arg="true"
                shift 2
                ;;
            --transcript-path)
                transcript_path="${2:-}"
                shift 2
                ;;
            -h|--help)
                # Note: No need to clear ERR trap here - return 0 doesn't trigger it
                cat <<USAGE
Usage: ${CLI_CMD} wait --json [--finalize] [--timeout <sec>] [--poll-interval <sec>] [--session-key <key>] [--session-id <id>] [--transcript-path <path>]
USAGE
                return 0
                ;;
            *)
                trap - ERR  # Clear trap before die
                die "Unknown option '$1'"
                ;;
        esac
    done

    if [[ "$json_mode" != "true" ]]; then
        trap - ERR
        die "wait requires --json output"
    fi

    if ! command -v jq >/dev/null 2>&1; then
        # Output JSON even when jq is missing (use printf)
        printf '{"status":"error","consensus_verdict":null,"reviewers":{},"aggregated_findings":[],"parse_errors":[{"reviewer":null,"error":"missing_dependency","details":"jq is required but not installed"}]}\n'
        trap - ERR
        exit 2
    fi

    wait_error() {
        local message="$1"
        trap - ERR  # Clear trap before explicit error exit
        jq -n --arg status "error" --arg error "$message" \
            '{status:$status, consensus_verdict:null, reviewers:{}, aggregated_findings:[], parse_errors:[{reviewer:null, error:$error}]}'
        exit 2
    }

    wait_no_reviewers() {
        trap - ERR  # Clear trap before explicit exit
        jq -n --arg status "no_reviewers" \
            '{status:$status, consensus_verdict:null, reviewers:{}, aggregated_findings:[], parse_errors:[]}'
        exit 4
    }

    if [[ -z "$timeout" || ! "$timeout" =~ ^[0-9]+$ ]]; then
        wait_error "Invalid --timeout '$timeout' (must be >= 0)"
    fi

    if [[ -z "$poll_interval" || ! "$poll_interval" =~ ^[0-9]+$ || "$poll_interval" -lt 1 ]]; then
        wait_error "Invalid --poll-interval '$poll_interval' (must be >= 1)"
    fi

    if [[ "$session_id_from_arg" != "true" && -z "$session_id" && -n "$transcript_path" ]]; then
        session_id="$(basename "$transcript_path" .jsonl)"
    fi

    if [[ "$session_key_from_arg" == "true" && "$session_id_from_arg" != "true" ]]; then
        session_id=""
    fi

    # T003: when --session-key is supplied via flag (and --session-id is
    # NOT also supplied), set CERBERUS_RUN_KEY transiently so the
    # resolve_review_dir() path below can find the run. This implements
    # the run-key lookup parity contract from plan §Run-key lookup parity
    # (L613-L630): both `wait --session-key K` and `status --session-key
    # K` resolve the same path via
    # `resolve_review_dir(session_id="", transcript_path)` with
    # CERBERUS_RUN_KEY=K. The glob-based find_state_by_session_key remains
    # as a fallback for cross-host lookups when the project key cannot be
    # inferred from env/transcript_path (the common Codex/Amp case).
    #
    # CRITICAL: gate the export on session_id_from_arg too. When both
    # --session-id S and --session-key K are passed, the session_id
    # branch below calls resolve_review_dir("$session_id", ...). The
    # resolver reads __cerberus_resolve_run_key() (= CERBERUS_RUN_KEY)
    # first, so an unguarded export would silently override the
    # explicit --session-id S with K. The clearing guard ~10 lines
    # below preserves session_id specifically for this "both flags
    # present" case.
    if [[ "$session_key_from_arg" == "true" && "$session_id_from_arg" != "true" && -n "$session_key" ]]; then
        export CERBERUS_RUN_KEY="$session_key"
    fi

    local state_file=""
    if [[ -n "$session_id" ]]; then
        local review_dir
        # When the caller explicitly passed --session-id, that value MUST take
        # precedence over any ambient CERBERUS_RUN_KEY / REVIEW_GATE_SESSION_KEY.
        # resolve_review_dir() routes through __cerberus_resolve_run_key() which
        # gives the env aliases precedence over the positional session_id, so
        # without unsetting them an explicit --session-id lookup from a
        # Codex/Amp shell with an exported run key would silently read the
        # ambient run instead of the requested gate. Scope the unset to the
        # command-substitution subshell so the parent's env is preserved (this
        # also means we don't disturb the transient CERBERUS_RUN_KEY exported
        # by the --session-key-only branch above).
        if [[ "$session_id_from_arg" == "true" ]]; then
            review_dir=$(unset CERBERUS_RUN_KEY REVIEW_GATE_SESSION_KEY; resolve_review_dir "$session_id" "$transcript_path")
        else
            review_dir=$(resolve_review_dir "$session_id" "$transcript_path")
        fi
        state_file="$review_dir/gate-state.json"
    elif [[ -n "$session_key" ]]; then
        # Strategy 1 (env-passing parity, plan §Run-key lookup parity):
        # resolve_review_dir picks up the transient CERBERUS_RUN_KEY plus
        # any CERBERUS_PROJECT_KEY / transcript_path-derived project key.
        local _wait_review_dir=""
        if _wait_review_dir=$(resolve_review_dir "" "$transcript_path" 2>/dev/null); then
            if [[ -n "$_wait_review_dir" && -f "$_wait_review_dir/gate-state.json" ]]; then
                state_file="$_wait_review_dir/gate-state.json"
            fi
        fi
        # Strategy 2 (glob fallback): scan the legacy Claude tree AND the
        # neutral host roots for a matching .owner.session_key. This is the
        # path Codex/Amp adapters take when invoking `wait --session-key K`
        # without exporting CERBERUS_PROJECT_KEY.
        if [[ -z "$state_file" ]]; then
            state_file=$(find_state_by_session_key "$session_key")
        fi
    else
        wait_error "session key or session id is required"
    fi

    if [[ -z "$state_file" || ! -f "$state_file" ]]; then
        wait_no_reviewers
    fi

    local review_dir
    review_dir=$(dirname "$state_file")
    local reviews_dir="$review_dir/reviews"

    local state_consensus
    state_consensus=$(jq -r '.consensus.verdict // ""' "$state_file" 2>/dev/null || echo "")
    if [[ "$state_consensus" == "no_reviewers" ]]; then
        wait_no_reviewers
    fi

    local reviewers
    reviewers=$(jq -r '.reviewers | keys[]' "$state_file" 2>/dev/null || echo "")
    if [[ -z "$reviewers" ]]; then
        wait_no_reviewers
    fi

    local start_time
    start_time=$(date +%s)
    local timed_out="false"
    local resolved_early="false"

    while true; do
        local state_status
        state_status=$(jq -r '.status // ""' "$state_file" 2>/dev/null || echo "")
        if [[ "$state_status" == "resolved" ]]; then
            resolved_early="true"
            break
        fi

        local all_done="true"
        local reviewer
        for reviewer in $reviewers; do
            local done_file="$reviews_dir/${reviewer}.done"
            local failed_file="$reviews_dir/${reviewer}.failed"
            if [[ -f "$done_file" || -f "$failed_file" ]]; then
                continue
            fi
            all_done="false"
            break
        done

        if [[ "$all_done" == "true" ]]; then
            break
        fi

        local now elapsed
        now=$(date +%s)
        elapsed=$((now - start_time))
        if [[ "$elapsed" -ge "$timeout" ]]; then
            timed_out="true"
            break
        fi
        sleep "$poll_interval"
    done

    local result_json
    result_json=$(jq -n '{status:null, consensus_verdict:null, reviewers:{}, aggregated_findings:[], parse_errors:[]}')

    local parse_error_count=0
    local has_pass=0
    local has_fail=0
    local has_needs=0

    local reviewer
    for reviewer in $reviewers; do
        local done_file="$reviews_dir/${reviewer}.done"
        local failed_file="$reviews_dir/${reviewer}.failed"
        local output_file="$reviews_dir/${reviewer}.json"
        local result=""
        local parsed_failed_output="false"

        if [[ "$timed_out" == "true" && ! -f "$done_file" && ! -f "$failed_file" ]]; then
            local reviewer_entry
            reviewer_entry=$(jq -n --arg verdict "PENDING" --arg summary "Timed out waiting for reviewer" \
                '{verdict:$verdict, summary:$summary, findings: []}')
            result_json=$(echo "$result_json" | jq --arg reviewer "$reviewer" --argjson entry "$reviewer_entry" \
                '.reviewers[$reviewer] = $entry')
            continue
        fi

        if [[ -f "$failed_file" && -f "$output_file" ]]; then
            if result=$(extract_valid_review_json_no_repair "$output_file" "$reviewer" 2>/dev/null); then
                parsed_failed_output="true"
            fi
        fi

        if [[ -f "$failed_file" && "$parsed_failed_output" != "true" ]]; then
            # Extract error details from the output file if it exists
            local error_details="Reviewer process failed"
            if [[ -f "$output_file" ]]; then
                # Try to get meaningful error message from output
                local raw_output
                raw_output=$(head -c 4000 "$output_file" 2>/dev/null || true)
                if [[ -n "$raw_output" ]]; then
                    # Check for external error report file (Gemini CLI pattern)
                    # e.g., "Full report available at: /tmp/gemini-client-error-*.json"
                    local external_error_file
                    external_error_file=$(echo "$raw_output" | grep -oiE 'available at: [^ ]+\.json' 2>/dev/null | sed 's/.*available at: //' | head -1 || true)
                    if [[ -n "$external_error_file" && -f "$external_error_file" ]]; then
                        # Read and format the external error report
                        local ext_error
                        if ! ext_error=$(jq -r 'to_entries | map("\(.key): \(.value | if type == "object" then (to_entries | map("\(.key)=\(.value)") | join(", ")) else . end)") | join("; ")' "$external_error_file" 2>/dev/null); then
                            ext_error=$(head -c 1000 "$external_error_file" 2>/dev/null || true)
                        fi
                        if [[ -n "$ext_error" ]]; then
                            error_details="$ext_error"
                        fi
                    fi
                    # If no external file or couldn't read it, try inline error extraction
                    if [[ "$error_details" == "Reviewer process failed" ]]; then
                        # Try to extract error message from JSON if present
                        local json_error
                        json_error=$(echo "$raw_output" | jq -r '.error.message // .error // .message // empty' 2>/dev/null || true)
                        if [[ -n "$json_error" && "$json_error" != "[object Object]" ]]; then
                            error_details="$json_error"
                        elif [[ "$raw_output" == *"Error"* || "$raw_output" == *"error"* ]]; then
                            # Capture lines containing error info (|| true to avoid set -e exit)
                            error_details=$(echo "$raw_output" | grep -i "error" 2>/dev/null | head -3 | tr '\n' ' ' | sed 's/  */ /g' | head -c 500 || true)
                            [[ -z "$error_details" ]] && error_details=$(echo "$raw_output" | head -5 | tr '\n' ' ' | sed 's/  */ /g' | head -c 500)
                        fi
                    fi
                fi
            fi
            local reviewer_entry
            reviewer_entry=$(jq -n --arg verdict "ERROR" --arg summary "$error_details" \
                '{verdict:$verdict, summary:$summary, findings: []}')
            result_json=$(echo "$result_json" | jq --arg reviewer "$reviewer" --argjson entry "$reviewer_entry" \
                --arg error "reviewer_failed" --arg details "$error_details" \
                '.reviewers[$reviewer] = $entry | .parse_errors += [{reviewer:$reviewer, error:$error, details:$details}]')
            parse_error_count=$((parse_error_count + 1))
            continue
        fi

        if [[ ! -f "$output_file" ]]; then
            local reviewer_entry
            reviewer_entry=$(jq -n --arg verdict "ERROR" --arg summary "Reviewer output missing" \
                '{verdict:$verdict, summary:$summary, findings: []}')
            result_json=$(echo "$result_json" | jq --arg reviewer "$reviewer" --argjson entry "$reviewer_entry" \
                --arg error "missing_output" \
                '.reviewers[$reviewer] = $entry | .parse_errors += [{reviewer:$reviewer, error:$error}]')
            parse_error_count=$((parse_error_count + 1))
            continue
        fi

        if [[ "$parsed_failed_output" != "true" ]] && \
           ! result=$(extract_json "$output_file" "$reviewer" 2>/dev/null); then
            local reviewer_entry
            reviewer_entry=$(jq -n --arg verdict "ERROR" --arg summary "Invalid reviewer output" \
                '{verdict:$verdict, summary:$summary, findings: []}')
            result_json=$(echo "$result_json" | jq --arg reviewer "$reviewer" --argjson entry "$reviewer_entry" \
                --arg error "invalid_output" \
                '.reviewers[$reviewer] = $entry | .parse_errors += [{reviewer:$reviewer, error:$error}]')
            parse_error_count=$((parse_error_count + 1))
            continue
        fi

        local verdict summary findings_json
        verdict=$(echo "$result" | jq -r '.verdict // ""' 2>/dev/null || echo "")
        summary=$(echo "$result" | jq -r '.summary // ""' 2>/dev/null || echo "")
        findings_json=$(echo "$result" | jq -c '.findings // []' 2>/dev/null || echo "[]")

        case "$verdict" in
            PASS|FAIL|NEEDS_WORK)
                ;;
            *)
                local reviewer_entry
                reviewer_entry=$(jq -n --arg verdict "ERROR" --arg summary "Invalid verdict" \
                    '{verdict:$verdict, summary:$summary, findings: []}')
                result_json=$(echo "$result_json" | jq --arg reviewer "$reviewer" --argjson entry "$reviewer_entry" \
                    '.reviewers[$reviewer] = $entry | .parse_errors += [{reviewer:$reviewer, error:"invalid_verdict"}]')
                parse_error_count=$((parse_error_count + 1))
                continue
                ;;
        esac

        local reviewer_entry
        reviewer_entry=$(jq -n --arg verdict "$verdict" --arg summary "$summary" --argjson findings "$findings_json" \
            '{verdict:$verdict, summary:$summary, findings:$findings}')
        result_json=$(echo "$result_json" | jq --arg reviewer "$reviewer" --argjson entry "$reviewer_entry" \
            '.reviewers[$reviewer] = $entry')
        result_json=$(echo "$result_json" | jq --arg reviewer "$reviewer" --argjson findings "$findings_json" \
            '.aggregated_findings += ($findings | map(. + {reviewer:$reviewer}))')

        case "$verdict" in
            PASS) has_pass=$((has_pass + 1)) ;;
            FAIL) has_fail=$((has_fail + 1)) ;;
            NEEDS_WORK) has_needs=$((has_needs + 1)) ;;
        esac
    done

    # Count valid verdicts (PASS, FAIL, NEEDS_WORK) - needed for both consensus and exit code
    local valid_verdict_count=$((has_pass + has_fail + has_needs))

    local status consensus_verdict=""
    if [[ "$timed_out" == "true" ]]; then
        status="timeout"
        consensus_verdict=""
    elif [[ "$resolved_early" == "true" ]]; then
        status="resolved"
        if [[ "$valid_verdict_count" -eq 0 ]]; then
            consensus_verdict="ERROR"
        elif [[ "$has_fail" -gt 0 ]]; then
            consensus_verdict="FAIL"
        elif [[ "$has_needs" -gt 0 ]]; then
            consensus_verdict="NEEDS_WORK"
        else
            consensus_verdict="PASS"
        fi
    else
        status="complete"
        # Treat as ERROR if no valid verdicts (regardless of parse errors)
        if [[ "$valid_verdict_count" -eq 0 ]]; then
            consensus_verdict="ERROR"
        else
            # Use valid verdicts for consensus (most severe wins)
            if [[ "$has_fail" -gt 0 ]]; then
                consensus_verdict="FAIL"
            elif [[ "$has_needs" -gt 0 ]]; then
                consensus_verdict="NEEDS_WORK"
            else
                consensus_verdict="PASS"
            fi
        fi
    fi

    if [[ -n "$consensus_verdict" ]]; then
        result_json=$(echo "$result_json" | jq --arg status "$status" --arg consensus "$consensus_verdict" \
            '.status = $status | .consensus_verdict = $consensus')
    else
        result_json=$(echo "$result_json" | jq --arg status "$status" '.status = $status')
    fi

    if [[ "$finalize" == "true" && "$status" != "timeout" && -n "$consensus_verdict" && -f "$state_file" ]]; then
        local timestamp
        timestamp=$(date -Iseconds)

        local reason_suffix
        reason_suffix=$(printf '%s' "$consensus_verdict" | tr '[:upper:]' '[:lower:]')
        local reason="wait_finalize_${reason_suffix}"

        local review_dir plan_path spec_path artifact_path
        review_dir=$(dirname "$state_file")
        plan_path=$(jq -r '.mode.plan_path // empty' "$state_file" 2>/dev/null || echo "")
        spec_path=$(jq -r '.mode.spec_path // empty' "$state_file" 2>/dev/null || echo "")
        artifact_path="$review_dir/latest.md"

        local plan_sha="" spec_sha="" artifact_sha=""
        if [[ -n "$plan_path" && -f "$plan_path" ]]; then
            plan_sha=$(compute_sha256 "$plan_path" 2>/dev/null || echo "")
        fi
        if [[ -n "$spec_path" && -f "$spec_path" ]]; then
            spec_sha=$(compute_sha256 "$spec_path" 2>/dev/null || echo "")
        fi
        if [[ -f "$artifact_path" ]]; then
            artifact_sha=$(compute_sha256 "$artifact_path" 2>/dev/null || echo "")
        fi

        local temp_file="${state_file}.tmp.$$"
        # T002: include the alias-warning marker in cleanup so the top-level
        # marker-cleanup EXIT trap (which we clobber here) is not lost.
        trap 'rm -f "${temp_file:-}" "${TMPDIR:-/tmp}/cerberus-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-root-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-session-id-alias-warned.$$" "${TMPDIR:-/tmp}/cerberus-transcript-path-alias-warned.$$" 2>/dev/null || true' EXIT
        jq --arg timestamp "$timestamp" \
           --arg reason "$reason" \
           --arg consensus "$consensus_verdict" \
           --arg plan_sha "$plan_sha" \
           --arg spec_sha "$spec_sha" \
           --arg artifact_sha "$artifact_sha" \
           '
           .status = "resolved"
           | .decision = (.decision // {})
           | .decision.action = "proceed"
           | .decision.decided_at = $timestamp
           | .decision.reason = $reason
           | .consensus = (.consensus // {})
           | .consensus.verdict = $consensus
           | if $plan_sha != "" then .artifact.plan_sha = $plan_sha else . end
           | if $spec_sha != "" then .artifact.spec_sha = $spec_sha else . end
           | if $artifact_sha != "" then .artifact.sha256 = $artifact_sha else . end
           ' \
           "$state_file" > "$temp_file"
        mv "$temp_file" "$state_file"
    fi

    echo "$result_json"

    # Clear error trap before explicit exits
    trap - ERR

    if [[ "$status" == "timeout" ]]; then
        exit 3
    fi

    case "$consensus_verdict" in
        PASS)
            exit 0
            ;;
        FAIL|NEEDS_WORK)
            exit 1
            ;;
        ERROR)
            exit 2
            ;;
        *)
            # Unknown verdict (shouldn't happen) - treat as error
            exit 2
            ;;
    esac
}

# review_gate_status — non-mutating, non-blocking status snapshot.
#
# Plan reference: §status --json JSON output schema (L634-L730).
#
# Produces the canonical JSON shape consumed by the Codex Stop hook
# (`bin/codex-stop-hook`) and Amp `Cerberus: Status` UI. The contract
# is strict:
#
#   - **Never** writes anything under $REVIEW_DIR (no telemetry side
#     effects, no `iteration.json` rotation, no `gate-state.json`
#     mutation). Verified by test 7 (no-mutation invariant) in
#     bin/tests/test-status-command.sh.
#   - **Never** blocks. No polling loop, no sleeps. Verified by test 8
#     (returns in <1s against still-pending gate).
#   - Reads only committed files; ignores `*.tmp.$$` files.
#
# Exit codes:
#   0 — success (body has `status` field set OR full schema fields)
#   2 — internal error (e.g., resolver failure unrelated to missing state)
#   4 — no active gate (body: {"status":"no_active_gate"})
#
# Special bodies:
#   {"status":"no_active_gate"} (exit 4) — no gate-state.json for resolved run
#   {"status":"unknown","error":"malformed_state"} (exit 0) — failure-open
#     for downstream Codex Stop / Amp Status when state is unparseable
#
# Run-key lookup parity (plan L613-L630): `status --session-key K` and
# `wait --session-key K` MUST share the same code path. Implementation:
# when `--session-key` is passed via flag, we set `CERBERUS_RUN_KEY`
# transiently (via `find_state_for_run_key` below) and call
# `resolve_review_dir("", transcript_path)` first. If that path's
# `gate-state.json` exists, we use it. Otherwise we fall back to the
# glob-based `find_state_by_session_key` (which already searches both
# Claude legacy roots AND neutral roots after T002).
review_gate_status() {
    local json_mode="false"
    local session_key="$(__cerberus_resolve_run_key)"
    local session_id
    session_id="$(__cerberus_resolve_session_id)"
    local transcript_path
    transcript_path="$(__cerberus_resolve_transcript_path)"
    local session_key_from_arg="false"
    local session_id_from_arg="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)
                json_mode="true"
                shift
                ;;
            --session-key=*)
                session_key="${1#*=}"
                session_key_from_arg="true"
                shift
                ;;
            --session-key)
                session_key="${2:-}"
                session_key_from_arg="true"
                shift 2
                ;;
            --session-id=*)
                session_id="${1#*=}"
                session_id_from_arg="true"
                shift
                ;;
            --session-id)
                session_id="${2:-}"
                session_id_from_arg="true"
                shift 2
                ;;
            --transcript-path=*)
                transcript_path="${1#*=}"
                shift
                ;;
            --transcript-path)
                transcript_path="${2:-}"
                shift 2
                ;;
            -h|--help)
                cat <<USAGE
Usage: ${CLI_CMD} status --json [--session-key <key>] [--session-id <id>] [--transcript-path <path>]
USAGE
                return 0
                ;;
            *)
                die "Unknown option '$1'"
                ;;
        esac
    done

    if [[ "$json_mode" != "true" ]]; then
        die "status requires --json output"
    fi

    if ! command -v jq >/dev/null 2>&1; then
        # Failure-open: emit failure-open body and exit 2 (internal error).
        printf '{"status":"error","error":"missing_dependency"}\n'
        exit 2
    fi

    if [[ "$session_id_from_arg" != "true" && -z "$session_id" && -n "$transcript_path" ]]; then
        session_id="$(basename "$transcript_path" .jsonl)"
    fi

    # When session_key is supplied via --session-key (and the caller did
    # NOT also supply --session-id), set CERBERUS_RUN_KEY transiently so
    # resolve_review_dir() picks it up (parity with `wait`). Plan
    # §Run-key lookup parity (L613-L630). Empty values are unset per the
    # ${VAR:-} idiom.
    #
    # CRITICAL: gate the export on session_id_from_arg too. When both
    # --session-id S and --session-key K are passed, the session_id
    # branch below resolves via resolve_review_dir("$session_id", ...),
    # and resolve_review_dir reads __cerberus_resolve_run_key() which
    # takes CERBERUS_RUN_KEY first — so an unguarded export would
    # silently override the explicit --session-id S with K and look up
    # the wrong run. The clearing guard immediately below preserves
    # session_id specifically for the "both flags present" case.
    if [[ "$session_key_from_arg" == "true" && "$session_id_from_arg" != "true" && -n "$session_key" ]]; then
        export CERBERUS_RUN_KEY="$session_key"
    fi

    # Flag-passing precedence: --session-key (alone) takes priority over
    # the legacy positional CLAUDE_SESSION_ID-derived session_id, mirroring
    # `wait`'s behavior when both arrive.
    if [[ "$session_key_from_arg" == "true" && "$session_id_from_arg" != "true" ]]; then
        session_id=""
    fi

    # Resolve the gate-state path. Two strategies, matching `wait`:
    #   1. session_id known → resolve_review_dir directly.
    #   2. only session_key known → resolve_review_dir (env-passing) first;
    #      fall back to find_state_by_session_key glob search if that path
    #      has no gate-state.json (covers cross-host lookup without a
    #      project key in env).
    local state_file="" review_dir=""
    if [[ -n "$session_id" ]]; then
        # When the caller explicitly passed --session-id, that value MUST take
        # precedence over any ambient CERBERUS_RUN_KEY / REVIEW_GATE_SESSION_KEY.
        # resolve_review_dir() routes through __cerberus_resolve_run_key() which
        # gives the env aliases precedence over the positional session_id, so
        # without unsetting them an explicit --session-id lookup from a
        # Codex/Amp shell with an exported run key would silently read the
        # ambient run instead of the requested gate. Scope the unset to the
        # command-substitution subshell so the parent's env is preserved for
        # subsequent operations.
        if [[ "$session_id_from_arg" == "true" ]]; then
            if review_dir=$(unset CERBERUS_RUN_KEY REVIEW_GATE_SESSION_KEY; resolve_review_dir "$session_id" "$transcript_path" 2>/dev/null); then
                state_file="$review_dir/gate-state.json"
            fi
        else
            if review_dir=$(resolve_review_dir "$session_id" "$transcript_path" 2>/dev/null); then
                state_file="$review_dir/gate-state.json"
            fi
        fi
    elif [[ -n "$session_key" ]]; then
        if review_dir=$(resolve_review_dir "" "$transcript_path" 2>/dev/null); then
            if [[ -n "$review_dir" && -f "$review_dir/gate-state.json" ]]; then
                state_file="$review_dir/gate-state.json"
            fi
        fi
        if [[ -z "$state_file" ]]; then
            state_file=$(find_state_by_session_key "$session_key")
            if [[ -n "$state_file" ]]; then
                review_dir=$(dirname "$state_file")
            fi
        fi
    fi

    if [[ -z "$state_file" || ! -f "$state_file" ]]; then
        printf '{"status":"no_active_gate"}\n'
        exit 4
    fi

    # Failure-open: malformed gate-state.json → exit 0 with sentinel body
    # so the Codex Stop hook can default to allowing the user to stop.
    if ! jq -e . "$state_file" >/dev/null 2>&1; then
        printf '{"status":"unknown","error":"malformed_state"}\n'
        exit 0
    fi

    # Derive metadata. T004 will record host/owner.project_key in the
    # state file directly; until then we infer from path + env.
    local gate_status host project_key run_key
    gate_status=$(jq -r '.status // "unknown"' "$state_file" 2>/dev/null || echo "unknown")
    case "$gate_status" in
        pending|awaiting_decision|resolved) ;;
        *) gate_status="unknown" ;;
    esac

    host=$(jq -r '.host // empty' "$state_file" 2>/dev/null || echo "")
    if [[ -z "$host" ]]; then
        host="${CERBERUS_HOST:-}"
    fi
    if [[ -z "$host" ]]; then
        case "$review_dir" in
            */.claude/projects/*) host="claude" ;;
            *) host="generic" ;;
        esac
    fi

    run_key=$(jq -r '.owner.session_key // empty' "$state_file" 2>/dev/null || echo "")
    if [[ -z "$run_key" ]]; then
        run_key=$(basename "$review_dir")
    fi

    project_key=$(jq -r '.owner.project_key // empty' "$state_file" 2>/dev/null || echo "")
    if [[ -z "$project_key" ]]; then
        # Path layouts:
        #   Claude legacy:  <root>/<projkey>/cerberus/<runkey>
        #   Neutral:        <root>/<projkey>/<runkey>
        local _parent _parent_name
        _parent=$(dirname "$review_dir")
        _parent_name=$(basename "$_parent")
        if [[ "$_parent_name" == "cerberus" ]]; then
            project_key=$(basename "$(dirname "$_parent")")
        else
            project_key="$_parent_name"
        fi
    fi

    # Reviewer aggregation (read-only). Iterate reviewer names from
    # gate-state.json keys; bucket each into pending/complete/failed
    # using the .done/.failed sentinel files. For complete reviewers,
    # pull verdict + findings from <name>.json directly via jq (we
    # deliberately avoid extract_json's repair_review_output path, which
    # may invoke external CLIs and violate the <1s no-blocking budget).
    local reviews_dir="$review_dir/reviews"
    local reviewer_names
    reviewer_names=$(jq -r '.reviewers | keys[]?' "$state_file" 2>/dev/null || echo "")

    local reviewers_json='[]'
    local pending_json='[]'
    local findings_json='[]'
    local parse_errors_json='[]'
    local has_pass=0 has_fail=0 has_needs=0

    local reviewer
    for reviewer in $reviewer_names; do
        local done_file="$reviews_dir/${reviewer}.done"
        local failed_file="$reviews_dir/${reviewer}.failed"
        local output_file="$reviews_dir/${reviewer}.json"
        local result=""
        local parsed_failed_output="false"

        if [[ -f "$failed_file" && -f "$output_file" ]]; then
            if result=$(extract_valid_review_json_no_repair "$output_file" "$reviewer" 2>/dev/null); then
                parsed_failed_output="true"
            fi
        fi

        if [[ -f "$failed_file" && "$parsed_failed_output" != "true" ]]; then
            reviewers_json=$(printf '%s' "$reviewers_json" | jq -c \
                --arg name "$reviewer" \
                '. + [{name:$name, status:"failed"}]')
            parse_errors_json=$(printf '%s' "$parse_errors_json" | jq -c \
                --arg name "$reviewer" \
                '. + [$name]')
            continue
        fi

        if [[ ! -f "$done_file" && "$parsed_failed_output" != "true" ]]; then
            reviewers_json=$(printf '%s' "$reviewers_json" | jq -c \
                --arg name "$reviewer" \
                '. + [{name:$name, status:"pending"}]')
            pending_json=$(printf '%s' "$pending_json" | jq -c \
                --arg name "$reviewer" \
                '. + [$name]')
            continue
        fi

        if [[ ! -f "$output_file" ]]; then
            reviewers_json=$(printf '%s' "$reviewers_json" | jq -c \
                --arg name "$reviewer" \
                '. + [{name:$name, status:"complete", verdict:"error"}]')
            parse_errors_json=$(printf '%s' "$parse_errors_json" | jq -c \
                --arg name "$reviewer" \
                '. + [$name]')
            continue
        fi

        # Unwrap reviewer JSON via the canonical extract_json() helper so
        # we honor every model-specific wrapper format (Claude
        # `--output-format json` metadata wrapper, Codex transcript-tail,
        # Gemini noisy-preamble) — exactly the way `wait` does. Direct
        # `jq -r .verdict` on the file would silently report empty for
        # any of those wrapper shapes, which would drop a real FAIL/PASS
        # off the canonical status payload (round-1 status review
        # finding #2). We disable repair_review_output transiently
        # (REVIEW_REPAIR_ENABLED=false) so a malformed reviewer output
        # does NOT trigger an external CLI call from inside `status`,
        # preserving the no-blocking budget and the read-only contract.
        if [[ "$parsed_failed_output" != "true" ]] && \
           ! result=$(REVIEW_REPAIR_ENABLED=false extract_json "$output_file" "$reviewer" 2>/dev/null) \
              || [[ -z "$result" ]]; then
            reviewers_json=$(printf '%s' "$reviewers_json" | jq -c \
                --arg name "$reviewer" \
                '. + [{name:$name, status:"complete", verdict:"error"}]')
            parse_errors_json=$(printf '%s' "$parse_errors_json" | jq -c \
                --arg name "$reviewer" \
                '. + [$name]')
            continue
        fi

        local rverdict
        rverdict=$(printf '%s' "$result" | jq -r '.verdict // ""' 2>/dev/null || echo "")
        local out_verdict_lower="" finding_verdict=""
        case "$rverdict" in
            PASS)
                out_verdict_lower="pass"; finding_verdict="PASS"
                has_pass=$((has_pass + 1))
                ;;
            FAIL)
                out_verdict_lower="fail"; finding_verdict="FAIL"
                has_fail=$((has_fail + 1))
                ;;
            NEEDS_WORK)
                out_verdict_lower="needs_revision"; finding_verdict="NEEDS_REVISION"
                has_needs=$((has_needs + 1))
                ;;
            NEEDS_REVISION)
                out_verdict_lower="needs_revision"; finding_verdict="NEEDS_REVISION"
                has_needs=$((has_needs + 1))
                ;;
            *)
                reviewers_json=$(printf '%s' "$reviewers_json" | jq -c \
                    --arg name "$reviewer" \
                    '. + [{name:$name, status:"complete", verdict:"error"}]')
                parse_errors_json=$(printf '%s' "$parse_errors_json" | jq -c \
                    --arg name "$reviewer" \
                    '. + [$name]')
                continue
                ;;
        esac

        reviewers_json=$(printf '%s' "$reviewers_json" | jq -c \
            --arg name "$reviewer" \
            --arg verdict "$out_verdict_lower" \
            '. + [{name:$name, status:"complete", verdict:$verdict}]')

        # Findings — required: priority. Accept BOTH numeric `0..3`
        # AND string `"P0".."P3"` per the existing canonical normalizer
        # in bin/review-gate-hook.sh:1162-1186 (debate aggregation
        # explicitly does NOT mutate per-reviewer JSONs, so reviewer
        # output may arrive in either form). Missing or out-of-range
        # values → parse_errors[]. `priority` is emitted as the
        # canonical "P0".."P3" string. `verdict` on each finding
        # mirrors the issuing reviewer's verdict (uppercase,
        # NEEDS_WORK→NEEDS_REVISION). `summary` uses .title; optional
        # `details` carries .body; optional `file_refs` wraps
        # .file_path in an array.
        local rev_findings_json
        rev_findings_json=$(printf '%s' "$result" | jq -c '.findings // []' 2>/dev/null || echo "[]")
        # Validate it's an array; otherwise treat as parse error.
        if ! printf '%s' "$rev_findings_json" | jq -e 'type == "array"' >/dev/null 2>&1; then
            parse_errors_json=$(printf '%s' "$parse_errors_json" | jq -c \
                --arg name "$reviewer" \
                '. + [$name]')
            continue
        fi

        # Single jq pass that:
        #   - Normalizes priority to a numeric 0..3 (or "invalid")
        #   - Splits findings into accepted vs parse-error groups
        # Output: {accepted: [...canonical findings...], errors: [...indices...]}
        local findings_split
        findings_split=$(printf '%s' "$rev_findings_json" | jq -c \
            --arg reviewer "$reviewer" \
            --arg verdict "$finding_verdict" \
            '
            def to_pri:
                if type == "number" then
                    (if . == 0 or . == 1 or . == 2 or . == 3 then . else null end)
                elif type == "string" then
                    (if . == "P0" then 0
                     elif . == "P1" then 1
                     elif . == "P2" then 2
                     elif . == "P3" then 3
                     else null end)
                else null end;
            reduce (to_entries | .[]) as $e (
                {accepted: [], errors: []};
                ($e.value.priority? | to_pri) as $pri
                | if $pri == null then
                    .errors += ["\($reviewer):finding[\($e.key)]"]
                  else
                    .accepted += [
                      ({
                        reviewer: $reviewer,
                        priority: ("P" + ($pri | tostring)),
                        verdict: $verdict,
                        summary: ($e.value.title // "")
                       }
                       + (if ($e.value.body // "") != "" then {details: $e.value.body} else {} end)
                       + (if ($e.value.file_path // null) != null and ($e.value.file_path // "") != ""
                          then {file_refs: [$e.value.file_path]} else {} end)
                      )
                    ]
                  end
            )
            ')
        local findings_to_add parse_error_indices
        findings_to_add=$(printf '%s' "$findings_split" | jq -c '.accepted')
        parse_error_indices=$(printf '%s' "$findings_split" | jq -c '.errors')
        findings_json=$(printf '%s' "$findings_json" | jq -c \
            --argjson add "$findings_to_add" \
            '. + $add')
        parse_errors_json=$(printf '%s' "$parse_errors_json" | jq -c \
            --argjson add "$parse_error_indices" \
            '. + $add')
    done

    # consensus_verdict — for resolved gates, prefer the recorded
    # .consensus.verdict; otherwise derive from completed-reviewer verdicts
    # (matches `wait`'s most-severe-wins logic). Output is lowercase per
    # plan §JSON shape (L683-L684).
    local consensus_verdict_raw="" consensus_verdict_out="null"
    consensus_verdict_raw=$(jq -r '.consensus.verdict // empty' "$state_file" 2>/dev/null || echo "")
    if [[ -z "$consensus_verdict_raw" ]]; then
        if (( has_fail > 0 )); then
            consensus_verdict_raw="FAIL"
        elif (( has_needs > 0 )); then
            consensus_verdict_raw="NEEDS_WORK"
        elif (( has_pass > 0 )); then
            consensus_verdict_raw="PASS"
        fi
    fi
    case "$consensus_verdict_raw" in
        PASS|pass) consensus_verdict_out="pass" ;;
        FAIL|fail) consensus_verdict_out="fail" ;;
        NEEDS_WORK|NEEDS_REVISION|needs_work|needs_revision) consensus_verdict_out="needs_revision" ;;
        ""|*) consensus_verdict_out="" ;;
    esac

    # Assemble the final JSON output. Use `--argjson` for pre-built JSON
    # subtrees and `--arg` for strings. Emit consensus_verdict as JSON null
    # when undetermined.
    local final_json
    if [[ -z "$consensus_verdict_out" ]]; then
        final_json=$(jq -nc \
            --argjson schema_version 1 \
            --arg host "$host" \
            --arg project_key "$project_key" \
            --arg run_key "$run_key" \
            --arg review_dir "$review_dir" \
            --arg gate_status "$gate_status" \
            --argjson reviewers "$reviewers_json" \
            --argjson pending "$pending_json" \
            --argjson findings "$findings_json" \
            --argjson parse_errors "$parse_errors_json" \
            '{
                schema_version: $schema_version,
                host: $host,
                project_key: $project_key,
                run_key: $run_key,
                review_dir: $review_dir,
                gate_status: $gate_status,
                consensus_verdict: null,
                reviewers: $reviewers,
                pending_reviewers: $pending,
                aggregated_findings: $findings,
                parse_errors: $parse_errors
            }')
    else
        final_json=$(jq -nc \
            --argjson schema_version 1 \
            --arg host "$host" \
            --arg project_key "$project_key" \
            --arg run_key "$run_key" \
            --arg review_dir "$review_dir" \
            --arg gate_status "$gate_status" \
            --arg consensus_verdict "$consensus_verdict_out" \
            --argjson reviewers "$reviewers_json" \
            --argjson pending "$pending_json" \
            --argjson findings "$findings_json" \
            --argjson parse_errors "$parse_errors_json" \
            '{
                schema_version: $schema_version,
                host: $host,
                project_key: $project_key,
                run_key: $run_key,
                review_dir: $review_dir,
                gate_status: $gate_status,
                consensus_verdict: $consensus_verdict,
                reviewers: $reviewers,
                pending_reviewers: $pending,
                aggregated_findings: $findings,
                parse_errors: $parse_errors
            }')
    fi

    printf '%s\n' "$final_json"
    exit 0
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        check)
            shift
            review_gate_check "$@"
            ;;
        spawn)
            shift
            review_gate_spawn "$@"
            ;;
        spawn-code-review)
            shift
            review_gate_spawn_code_review "$@"
            ;;
        spawn-plan-review)
            shift
            review_gate_spawn_plan_review "$@"
            ;;
        spawn-spec-review)
            shift
            review_gate_spawn_spec_review "$@"
            ;;
        spawn-epic-verify)
            shift
            review_gate_spawn_epic_verify "$@"
            ;;
        spawn-ask)
            shift
            review_gate_spawn_ask "$@"
            ;;
        resolve)
            shift
            review_gate_resolve "$@"
            ;;
        wait)
            shift
            review_gate_wait "$@"
            ;;
        status)
            shift
            review_gate_status "$@"
            ;;
        artifact-path|artifact_path)
            shift
            review_gate_artifact_path "$@"
            ;;
        author-context|author_context)
            shift
            review_gate_author_context "$@"
            ;;
        -h|--help|help|"")
            usage
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
