#!/usr/bin/env bash
# Compatibility wrapper for callers that still invoke bin/generate directly.

set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: generate <output-dir> [options]

Arguments:
  <output-dir>            Required. Directory to write draft files to

Options:
  --type <type>           Named preset: healthcheck, architecture-review, create-spec, create-plan
  --mode <level>          Intelligence mode: fast, smart, max
  --prompt <text>         Legacy alias for positional prompt text
  --prompt-file <path>    Path to custom prompt file
  --focus <text>          Focus area to append to base prompt
  --skip-interview        For create-plan: generate autonomously
  -h, --help              Show this help
USAGE
}

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

root_has_backend() {
    local root="${1:-}"
    [ -n "$root" ] \
        && [[ "$root" == /* ]] \
        && [ -x "$root/bin/cerberus" ] \
        && [ -d "$root/prompts/generators" ]
}

SCRIPT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PLUGIN_ROOT="${CERBERUS_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}"
if [ -n "$PLUGIN_ROOT" ] && ! root_has_backend "$PLUGIN_ROOT"; then
    echo "[cerberus generate] warning: configured Cerberus root '$PLUGIN_ROOT' is missing backend files; using $SCRIPT_ROOT" >&2
    PLUGIN_ROOT=""
fi
export CERBERUS_ROOT="${PLUGIN_ROOT:-$SCRIPT_ROOT}"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    usage
    exit 0
fi

normalize_args() {
    if [ "$#" -eq 0 ]; then
        return
    fi

    local output_dir="$1"
    shift

    local has_type=false
    local prompt=""
    local prompt_set=false
    local -a normalized=("$output_dir")

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --type)
                has_type=true
                normalized+=("$1")
                shift
                if [ "$#" -gt 0 ]; then
                    normalized+=("$1")
                    shift
                fi
                ;;
            --type=*)
                has_type=true
                normalized+=("$1")
                shift
                ;;
            --prompt)
                shift
                if [ "$#" -gt 0 ]; then
                    prompt="$1"
                    prompt_set=true
                    shift
                else
                    normalized+=("--prompt")
                fi
                ;;
            --prompt=*)
                prompt="${1#--prompt=}"
                prompt_set=true
                shift
                ;;
            *)
                normalized+=("$1")
                shift
                ;;
        esac
    done

    if [ "$has_type" != "true" ]; then
        normalized=("$output_dir" "--type" "healthcheck" "${normalized[@]:1}")
    fi
    if [ "$prompt_set" = "true" ]; then
        normalized+=("$prompt")
    fi

    printf '%s\0' "${normalized[@]}"
}

declare -a CERBERUS_GENERATE_ARGS=()
if [ "$#" -gt 0 ]; then
    while IFS= read -r -d '' arg; do
        CERBERUS_GENERATE_ARGS+=("$arg")
    done < <(normalize_args "$@")
fi

exec "$SCRIPT_DIR/cerberus" generate "${CERBERUS_GENERATE_ARGS[@]}"
