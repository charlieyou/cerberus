#!/usr/bin/env bash
# generate - Multi-model generator for healthcheck/architecture-review/create-spec/create-plan

set -euo pipefail

# Resolve helper scripts relative to this file (follows symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# Load model helpers
source "$SCRIPT_DIR/review-gate-models.sh"

usage() {
    cat <<'USAGE'
Usage: generate <output-dir> [options] [< context.md]

Arguments:
  <output-dir>            Required. Directory to write draft files to

Automatically loads the base prompt from prompts/generators/<type>.md.
Optional stdin provides additional context (analysis output, focus area, etc).

Options:
  --type <type>         Named preset: healthcheck, architecture-review, create-spec, create-plan (default: healthcheck)
  --mode <level>        Intelligence mode: fast, smart, max
USAGE
}

die() {
    echo "Error: $*" >&2
    exit 1
}

# normalize_mode and validate_mode are provided by review-gate-models.sh

review_gate_generate() {
    local review_type="healthcheck"
    local mode=""
    local output_dir=""

    # First positional argument is required output directory
    if [[ $# -eq 0 ]]; then
        usage
        die "Missing required argument: <output-dir>"
    fi

    # Check if first arg is help flag
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
        usage
        return 0
    fi

    # Check if first arg looks like an option (starts with -)
    if [[ "$1" == -* ]]; then
        usage
        die "First argument must be <output-dir>, got option: $1"
    fi

    output_dir="$1"
    shift

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --type=*)
                review_type="${1#*=}"
                shift
                ;;
            --type)
                [[ -z "${2:-}" ]] && die "--type requires an argument"
                review_type="$2"
                shift 2
                ;;
            --mode=*)
                mode="${1#*=}"
                shift
                ;;
            --mode)
                mode="${2:-}"
                shift 2
                ;;
            -h|--help)
                usage
                return 0
                ;;
            -*)
                die "Unknown option '$1'"
                ;;
            *)
                die "Unexpected argument '$1'"
                ;;
        esac
    done

    # Validate review_type against allowlist
    case "$review_type" in
        healthcheck|architecture-review|create-spec|create-plan) ;;
        *) die "Unknown type '$review_type'. Valid types: healthcheck, architecture-review, create-spec, create-plan" ;;
    esac

    mode=$(normalize_mode "$mode")
    if [[ -z "$mode" ]]; then
        mode="smart"
    fi
    validate_mode "$mode"
    resolve_intelligence_mode "$mode"

    # Load base prompt from type-specific file
    local base_prompt_file="$PLUGIN_ROOT/prompts/generators/${review_type}.md"
    local base_prompt=""
    if [[ -f "$base_prompt_file" ]]; then
        base_prompt=$(cat "$base_prompt_file")
    else
        die "Prompt file not found for type '$review_type': $base_prompt_file"
    fi

    # Read additional context from stdin (optional)
    local stdin_content=""
    if [[ ! -t 0 ]]; then
        stdin_content=$(cat)
    fi

    # Combine base prompt with stdin context
    local prompt_content="$base_prompt"
    if [[ -n "${stdin_content//[[:space:]]/}" ]]; then
        prompt_content="$base_prompt"$'\n\n'"$stdin_content"
    fi

    if [[ "${PROMPT_ULTRATHINK:-false}" == "true" ]]; then
        prompt_content=$'ultrathink\n\n'"$prompt_content"
    fi

    # Create output directory
    local draft_dir="$output_dir"
    mkdir -p "$draft_dir"
    # Clear stale sentinel files from prior runs to avoid reusing stale markers
    rm -f "$draft_dir"/*.done "$draft_dir"/*.failed 2>/dev/null || true

    local codex_draft="$draft_dir/codex.md"
    local gemini_draft="$draft_dir/gemini.md"
    local claude_draft="$draft_dir/claude.md"
    local codex_done="$draft_dir/codex.done"
    local gemini_done="$draft_dir/gemini.done"
    local claude_done="$draft_dir/claude.done"
    local codex_failed="$draft_dir/codex.failed"
    local gemini_failed="$draft_dir/gemini.failed"
    local claude_failed="$draft_dir/claude.failed"

    echo "Starting generators for type: $review_type" >&2
    echo "Draft directory: $draft_dir" >&2

    # Spawn Codex (with repo access via read-only sandbox)
    local codex_model="${CODEX_MODEL_EFFECTIVE:-$CODEX_MODEL}"
    local codex_reasoning="${CODEX_REASONING_EFFORT:-medium}"
    if command -v codex >/dev/null 2>&1; then
        echo "Spawning Codex generator (model: $codex_model)..." >&2
        (
            if codex exec -m "$codex_model" -c model_reasoning_effort="$codex_reasoning" -s read-only "$prompt_content" > "$codex_draft" 2>&1; then
                touch "$codex_done"
            else
                touch "$codex_failed"
            fi
        ) &
        local pid_codex=$!
    else
        echo "Warning: codex not found, skipping" >&2
        touch "$codex_failed"
        local pid_codex=""
    fi

    # Spawn Gemini (read-only tools via settings file)
    local gemini_model="${GEMINI_MODEL_EFFECTIVE:-$GEMINI_MODEL}"
    if command -v gemini >/dev/null 2>&1; then
        local gemini_settings=""
        if gemini_settings=$(gemini_readonly_settings_path); then
            echo "Spawning Gemini generator (model: $gemini_model)..." >&2
            (
                if GEMINI_CLI_SYSTEM_SETTINGS_PATH="$gemini_settings" \
                    gemini -m "$gemini_model" -o text "$prompt_content" > "$gemini_draft" 2>&1; then
                    touch "$gemini_done"
                else
                    touch "$gemini_failed"
                fi
            ) &
            local pid_gemini=$!
        else
            echo "Warning: gemini read-only settings missing, skipping" >&2
            touch "$gemini_failed"
            local pid_gemini=""
        fi
    else
        echo "Warning: gemini not found, skipping" >&2
        touch "$gemini_failed"
        local pid_gemini=""
    fi

    # Spawn Claude (print mode, no interaction, stdin for prompt)
    local claude_model="${CLAUDE_MODEL_EFFECTIVE:-$CLAUDE_MODEL}"
    if command -v claude >/dev/null 2>&1; then
        local -a claude_allowed_tools
        local -a claude_disallowed_tools
        read -r -a claude_allowed_tools <<< "$CLAUDE_READONLY_ALLOWED_TOOLS"
        read -r -a claude_disallowed_tools <<< "$CLAUDE_READONLY_DISALLOWED_TOOLS"
        echo "Spawning Claude generator (model: $claude_model)..." >&2
        (
            if printf '%s' "$prompt_content" | claude -p --model "$claude_model" \
                --allowedTools "${claude_allowed_tools[@]}" \
                --disallowedTools "${claude_disallowed_tools[@]}" \
                > "$claude_draft" 2>&1; then
                touch "$claude_done"
            else
                touch "$claude_failed"
            fi
        ) &
        local pid_claude=$!
    else
        echo "Warning: claude not found, skipping" >&2
        touch "$claude_failed"
        local pid_claude=""
    fi

    # Wait for all generators
    echo "Waiting for generators to complete..." >&2
    local wait_start
    wait_start=$(date +%s)
    local timeout=900  # 15 minutes

    while true; do
        local codex_complete=false
        local gemini_complete=false
        local claude_complete=false

        [[ -f "$codex_done" || -f "$codex_failed" ]] && codex_complete=true
        [[ -f "$gemini_done" || -f "$gemini_failed" ]] && gemini_complete=true
        [[ -f "$claude_done" || -f "$claude_failed" ]] && claude_complete=true

        if $codex_complete && $gemini_complete && $claude_complete; then
            break
        fi

        local elapsed=$(( $(date +%s) - wait_start ))
        if [[ $elapsed -ge $timeout ]]; then
            echo "Timeout waiting for generators after ${elapsed}s" >&2
            # Kill any remaining processes
            [[ -n "${pid_codex:-}" ]] && kill "$pid_codex" 2>/dev/null || true
            [[ -n "${pid_gemini:-}" ]] && kill "$pid_gemini" 2>/dev/null || true
            [[ -n "${pid_claude:-}" ]] && kill "$pid_claude" 2>/dev/null || true
            break
        fi

        sleep 2
    done

    # Count successful drafts
    local draft_count=0
    local drafts=()

    if [[ -f "$codex_done" && -f "$codex_draft" && -s "$codex_draft" ]]; then
        ((draft_count++)) || true
        drafts+=("$codex_draft")
        echo "Codex: completed successfully" >&2
    elif [[ -f "$codex_failed" ]]; then
        echo "Codex: failed" >&2
    else
        echo "Codex: timed out" >&2
    fi

    if [[ -f "$gemini_done" && -f "$gemini_draft" && -s "$gemini_draft" ]]; then
        ((draft_count++)) || true
        drafts+=("$gemini_draft")
        echo "Gemini: completed successfully" >&2
    elif [[ -f "$gemini_failed" ]]; then
        echo "Gemini: failed" >&2
    else
        echo "Gemini: timed out" >&2
    fi

    if [[ -f "$claude_done" && -f "$claude_draft" && -s "$claude_draft" ]]; then
        ((draft_count++)) || true
        drafts+=("$claude_draft")
        echo "Claude: completed successfully" >&2
    elif [[ -f "$claude_failed" ]]; then
        echo "Claude: failed" >&2
    else
        echo "Claude: timed out" >&2
    fi

    echo "Completed: $draft_count drafts" >&2

    if [[ $draft_count -eq 0 ]]; then
        die "No drafts generated. Check generator availability."
    elif [[ $draft_count -eq 1 ]]; then
        echo "Warning: Only one generator succeeded. Proceeding with partial results." >&2
    fi

    # Output draft file paths (for subagent synthesis)
    echo ""
    echo "# Generator Drafts Written"
    echo ""
    echo "Drafts have been written to files. Use a subagent to synthesize them."
    echo ""
    echo "## Draft Files"
    echo ""
    for draft in "${drafts[@]}"; do
        local model_name
        model_name=$(basename "$draft" .md)
        echo "- **$model_name**: $draft"
    done
    echo ""
    echo "## Synthesis Instructions"
    echo ""
    echo "Use a Task/subagent to read these files and synthesize into a single artifact."
    echo "Do NOT read the files in your main context to preserve context window."
    echo ""
}

review_gate_generate "$@"
